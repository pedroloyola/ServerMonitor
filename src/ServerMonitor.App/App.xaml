<Application
    x:Class="ServerMonitor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Styles/Tokens/Color.Semantic.xaml" />
                <ResourceDictionary Source="Styles/Tokens/Typography.xaml" />
                <ResourceDictionary Source="Styles/Tokens/Spacing.xaml" />
                <ResourceDictionary Source="Styles/Tokens/Radius.xaml" />
                <ResourceDictionary Source="Styles/Tokens/Borders.xaml" />
                <ResourceDictionary Source="Styles/Tokens/Elevation.xaml" />
                <ResourceDictionary Source="Styles/Tokens/Motion.xaml" />
                <ResourceDictionary Source="Styles/DesignTokens.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
                <!-- UI.2: component layer, merged LAST (only adds Sa* keys; AppXamlMergesComponentsLastAndScopeNever). -->
                <ResourceDictionary Source="Styles/Components/Sa.Components.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
