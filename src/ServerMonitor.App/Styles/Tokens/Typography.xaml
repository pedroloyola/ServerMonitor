<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keyed styles only: no implicit TextBlock style and no page adoption in UI.1. -->
    <FontFamily x:Key="SaFontDisplay">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="SaFontText">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="SaFontMono">Cascadia Code, Cascadia Mono, Consolas</FontFamily>
    <x:Double x:Key="SaFontSizeDisplay">44</x:Double>
    <x:Double x:Key="SaLineHeightDisplay">61.6</x:Double>
    <Style x:Key="SaDisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightDisplay}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeHeading">30</x:Double>
    <x:Double x:Key="SaLineHeightHeading">42</x:Double>
    <Style x:Key="SaHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightHeading}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeMetric">28</x:Double>
    <x:Double x:Key="SaLineHeightMetric">39.2</x:Double>
    <Style x:Key="SaMetricTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeMetric}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightMetric}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeTitle">20</x:Double>
    <x:Double x:Key="SaLineHeightTitle">28</x:Double>
    <Style x:Key="SaTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightTitle}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeTitleCompact">18</x:Double>
    <x:Double x:Key="SaLineHeightTitleCompact">25.2</x:Double>
    <Style x:Key="SaTitleCompactTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeTitleCompact}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightTitleCompact}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeBody">14</x:Double>
    <x:Double x:Key="SaLineHeightBody">19.6</x:Double>
    <Style x:Key="SaBodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightBody}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeCaption">12</x:Double>
    <x:Double x:Key="SaLineHeightCaption">16.8</x:Double>
    <Style x:Key="SaCaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightCaption}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeLabel">12</x:Double>
    <x:Double x:Key="SaLineHeightLabel">16.8</x:Double>
    <Style x:Key="SaLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeLabel}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightLabel}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeMicro">10</x:Double>
    <x:Double x:Key="SaLineHeightMicro">14</x:Double>
    <Style x:Key="SaMicroTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeMicro}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightMicro}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <x:Double x:Key="SaFontSizeMono">12</x:Double>
    <x:Double x:Key="SaLineHeightMono">16.8</x:Double>
    <Style x:Key="SaMonoTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontMono}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeMono}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightMono}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
</ResourceDictionary>
