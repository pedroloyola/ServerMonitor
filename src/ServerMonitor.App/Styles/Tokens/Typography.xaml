        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightEmptyTitle}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- key-value value 112:1906 -->
    <x:Double x:Key="SaFontSizeValue">17</x:Double>
    <x:Double x:Key="SaLineHeightValue">24</x:Double>
    <Style x:Key="SaValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeValue}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightValue}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- helper text 112:3376 -->
    <x:Double x:Key="SaFontSizeHelper">11</x:Double>
    <x:Double x:Key="SaLineHeightHelper">16</x:Double>
    <Style x:Key="SaHelperTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeHelper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightHelper}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- primary button text 112:1004 -->
    <x:Double x:Key="SaFontSizeButton">14</x:Double>
    <x:Double x:Key="SaLineHeightButton">20</x:Double>
    <Style x:Key="SaButtonTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeButton}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightButton}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    </Style>
    <!-- Table header 10/14 Medium, 112:1434. Size only: the style is SaTableHeaderTextStyle in
         Styles/Components/Sa.Text.xaml (Cortex F-5). -->
    <x:Double x:Key="SaFontSizeTableHeader">10</x:Double>
    <x:Double x:Key="SaLineHeightTableHeader">14</x:Double>
</ResourceDictionary>
