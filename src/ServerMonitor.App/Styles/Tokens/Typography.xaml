    <x:Double x:Key="SaFontSizeEmptyTitle">24</x:Double>
    <x:Double x:Key="SaLineHeightEmptyTitle">30</x:Double>
    <Style x:Key="SaEmptyTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontDisplay}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeEmptyTitle}" />
