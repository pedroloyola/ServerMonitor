<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sa = ServerAlyzer. New foundations only; never override legacy resources. -->
    <Color x:Key="SaColorCanvasDark">#141414</Color>
    <Color x:Key="SaColorCanvasLight">#E7E7E7</Color>
    <Color x:Key="SaColorSurfaceDark">#242424</Color>
    <Color x:Key="SaColorSurfaceLight">#F7F7F7</Color>
    <Color x:Key="SaColorInteriorDark">#313131</Color>
    <Color x:Key="SaColorInteriorLight">#E8E8E8</Color>
    <Color x:Key="SaColorTextDark">#F5F5F5</Color>
    <Color x:Key="SaColorTextLight">#202020</Color>
    <Color x:Key="SaColorTextSecondaryDark">#ADADAD</Color>
    <Color x:Key="SaColorTextSecondaryLight">#626262</Color>
    <Color x:Key="SaColorCpuDark">#B69AF8</Color>
    <Color x:Key="SaColorCpuLight">#8668CA</Color>
    <Color x:Key="SaColorMemoryDark">#7DB8FF</Color>
    <Color x:Key="SaColorMemoryLight">#427EC5</Color>
    <Color x:Key="SaColorDiskDark">#FFC16E</Color>
    <Color x:Key="SaColorDiskLight">#B87B2F</Color>
    <Color x:Key="SaColorAttentionDark">#FFC16E</Color>
    <Color x:Key="SaColorAttentionLight">#B87B2F</Color>
    <Color x:Key="SaColorHealthyDark">#53DAB1</Color>
    <Color x:Key="SaColorHealthyLight">#299985</Color>
    <Color x:Key="SaColorSuccessDark">#53DAB1</Color>
    <Color x:Key="SaColorSuccessLight">#299985</Color>
    <Color x:Key="SaColorErrorDark">#FF858D</Color>
    <Color x:Key="SaColorErrorLight">#BD5766</Color>
    <Color x:Key="SaColorOfflineDark">#FF858D</Color>
    <Color x:Key="SaColorOfflineLight">#BD5766</Color>
    <Color x:Key="SaColorBorderNeutralDark">#99999999</Color>
    <Color x:Key="SaColorBorderNeutralLight">#99737373</Color>
    <Color x:Key="SaColorBorderSubtleDark">#21999999</Color>
    <Color x:Key="SaColorBorderSubtleLight">#99FFFFFF</Color>
    <Color x:Key="SaColorDividerDark">#484848</Color>
    <Color x:Key="SaColorDividerLight">#D3D3D3</Color>
    <Color x:Key="SaColorDisabledSurfaceDark">#22525252</Color>
    <Color x:Key="SaColorDisabledSurfaceLight">#4AFFFFFF</Color>
    <Color x:Key="SaColorDisabledTextDark">#ADADAD</Color>
    <Color x:Key="SaColorDisabledTextLight">#626262</Color>
    <!-- DERIVED - no Figma source, validate in UI.2 gallery: page 05 has no pointer-over state for Windows
         controls. Reproducible rule: the Selected paint (nav 112:969 / 112:1180) at half its alpha
         (alpha 0x3B -> 59/2 = 29.5 -> 0x1E; 0x80 -> 0x40), i.e. the Fluent rest -> hover -> selected progression. -->
    <Color x:Key="SaColorHoverDark">#1E525252</Color>
    <Color x:Key="SaColorHoverLight">#40FFFFFF</Color>
    <Color x:Key="SaColorSelectedDark">#3B525252</Color>
    <Color x:Key="SaColorSelectedLight">#80FFFFFF</Color>
    <Color x:Key="SaColorSelectedTextDark">#F5F5F5</Color>
    <Color x:Key="SaColorSelectedTextLight">#202020</Color>
    <Color x:Key="SaColorFocusRingDark">#F5F5F5</Color>
    <Color x:Key="SaColorFocusRingLight">#202020</Color>
    <!-- Glass panel contour + inner highlight (Manual p.07 "contorno fino"): panel 112:1010 / 112:1222
         border rgba(240,240,240,.37) / rgba(255,255,255,.95); inset 0 1px 1px rgba(255,255,255,.12) / .8. -->
    <Color x:Key="SaColorGlassBorderDark">#5EF0F0F0</Color>
    <Color x:Key="SaColorGlassBorderLight">#F2FFFFFF</Color>
    <Color x:Key="SaColorGlassHighlightDark">#1FFFFFFF</Color>
    <Color x:Key="SaColorGlassHighlightLight">#CCFFFFFF</Color>
    <!-- Material / elevation primitives consumed by Elevation.xaml (only Acrylic opacities stay literal there). -->
    <Color x:Key="SaColorElevatedSurfaceDark">#313131</Color>
    <Color x:Key="SaColorElevatedSurfaceLight">#FFFFFF</Color>
    <Color x:Key="SaColorGlassTintDark">#292929</Color>
    <Color x:Key="SaColorGlassTintLight">#FFFFFF</Color>
    <Color x:Key="SaColorSidebarTintDark">#121212</Color>
    <Color x:Key="SaColorSidebarTintLight">#FAFAFA</Color>
    <Color x:Key="SaColorModalSurfaceDark">#1A1A1A</Color>
    <Color x:Key="SaColorModalSurfaceLight">#F7F7F7</Color>
    <Color x:Key="SaColorOverlaySmokeDark">#5C000000</Color>
    <Color x:Key="SaColorOverlaySmokeLight">#33000000</Color>
    <!-- UI.2 additive (Boss B-2, D8: the Manual is authority; RAW Figma divergences are not adopted). Alpha rounded to the nearest byte. -->
    <!-- accessible attention text, Figma 112:1468 D / 112:1650 L; SaAttention* unchanged. R1 (Beacon F-2, Boss): Light
         darkened from the Figma #A6611F (4.51:1 on #F7F7F7, < 4.5 on the glass) to #8F5318 - >= 4.5:1 on every Light
         surface (deliberate deviation from 112:1468, a11y over Figma). -->
    <Color x:Key="SaColorAttentionTextDark">#FFB866</Color>
    <Color x:Key="SaColorAttentionTextLight">#8F5318</Color>
    <!-- destructive text 112:8576 D / 112:8762 L -->
    <Color x:Key="SaColorDangerTextDark">#FF9187</Color>
    <Color x:Key="SaColorDangerTextLight">#AD4038</Color>
    <!-- destructive fill .12 D / .07 L, 112:8575 / 112:8761 -->
    <Color x:Key="SaColorDangerFillDark">#1FFF9187</Color>
    <Color x:Key="SaColorDangerFillLight">#12AD4038</Color>
    <!-- destructive border .22, 112:8575 / 112:8761 -->
    <Color x:Key="SaColorDangerBorderDark">#38FF9187</Color>
    <Color x:Key="SaColorDangerBorderLight">#38AD4038</Color>
    <!-- primary button fill: D glass rgba(82,82,82,.28) 112:1004, L solid 112:1216 -->
    <Color x:Key="SaColorPrimaryFillDark">#47525252</Color>
    <Color x:Key="SaColorPrimaryFillLight">#303030</Color>
    <!-- primary border D rgba(255,255,255,.28) 112:1004; L none -->
    <Color x:Key="SaColorPrimaryBorderDark">#47FFFFFF</Color>
    <Color x:Key="SaColorPrimaryBorderLight">#00FFFFFF</Color>
    <!-- primary text: D Manual text (Figma RAW #F0F0F0, D8), L inverted #FAFAFA 112:1216 -->
    <Color x:Key="SaColorPrimaryTextDark">#F5F5F5</Color>
    <Color x:Key="SaColorPrimaryTextLight">#FAFAFA</Color>
    <!-- input fill rgba(36,36,36,.65) / rgba(255,255,255,.34), 112:3337 / 112:3498 -->
    <Color x:Key="SaColorInputFillDark">#A6242424</Color>
    <Color x:Key="SaColorInputFillLight">#57FFFFFF</Color>
    <!-- page search fill rgba(102,102,102,.18) / rgba(255,255,255,.4), 112:1429 / 112:1611 -->
    <Color x:Key="SaColorSearchFillDark">#2E666666</Color>
    <Color x:Key="SaColorSearchFillLight">#66FFFFFF</Color>
    <!-- rect segmented track .14, 112:2634 / 112:2850 -->
    <Color x:Key="SaColorSegmentedTrackDark">#24000000</Color>
    <Color x:Key="SaColorSegmentedTrackLight">#24FFFFFF</Color>
    <!-- pill segmented track rgba(89,89,89,.2) / rgba(255,255,255,.25), 112:3356 / 112:3517 -->
    <Color x:Key="SaColorSegmentedPillTrackDark">#33595959</Color>
    <Color x:Key="SaColorSegmentedPillTrackLight">#40FFFFFF</Color>
    <!-- pill segment selected rgba(107,107,107,.45) / rgba(255,255,255,.75), 112:3356 / 112:3517 -->
    <Color x:Key="SaColorSegmentedPillSelectedDark">#736B6B6B</Color>
    <Color x:Key="SaColorSegmentedPillSelectedLight">#BFFFFFFF</Color>
    <!-- toggle off track 112:7982 / 112:8143 (HC GrayText: distinct from the WindowText on-track) -->
    <Color x:Key="SaColorToggleOffTrackDark">#474747</Color>
    <Color x:Key="SaColorToggleOffTrackLight">#B8B8B8</Color>
    <!-- toggle thumb 112:7956 / 112:8117 -->
    <Color x:Key="SaColorToggleThumbDark">#FCFCFC</Color>
    <Color x:Key="SaColorToggleThumbLight">#FCFCFC</Color>
    <!-- skeleton = Manual secondary text @ .14, 112:15602 / 112:15726 -->
    <Color x:Key="SaColorSkeletonDark">#24ADADAD</Color>
    <Color x:Key="SaColorSkeletonLight">#24626262</Color>
    <!-- dialog inset rgba(153,153,153,.08) / rgba(102,102,102,.08), 112:8562 / 112:8748 -->
    <Color x:Key="SaColorInsetTintedDark">#14999999</Color>
    <Color x:Key="SaColorInsetTintedLight">#14666666</Color>
    <!-- empty bar rgba(184,184,184,.13) / rgba(64,64,64,.10), 112:1813 / 112:2050 -->
    <Color x:Key="SaColorBarEmptyDark">#21B8B8B8</Color>
    <Color x:Key="SaColorBarEmptyLight">#1A404040</Color>
    <!-- dialog button fill rgba(115,115,115,.14) / rgba(102,102,102,.12), 112:8573 / 112:8759 -->
    <Color x:Key="SaColorDialogButtonFillDark">#24737373</Color>
    <Color x:Key="SaColorDialogButtonFillLight">#1F666666</Color>
    <!-- dialog button border rgba(255,255,255,.14) / rgba(128,128,128,.16), 112:8573 / 112:8759 -->
    <Color x:Key="SaColorDialogButtonBorderDark">#24FFFFFF</Color>
    <Color x:Key="SaColorDialogButtonBorderLight">#29808080</Color>
</ResourceDictionary>
