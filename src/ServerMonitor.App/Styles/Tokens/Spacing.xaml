<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Manual 107:603; no speculative spacing values. -->
    <x:Double x:Key="SaSpace4">4</x:Double>
    <x:Double x:Key="SaSpace8">8</x:Double>
    <x:Double x:Key="SaSpace12">12</x:Double>
    <x:Double x:Key="SaSpace16">16</x:Double>
    <x:Double x:Key="SaSpace24">24</x:Double>
    <x:Double x:Key="SaSpace32">32</x:Double>
    <!-- UI.2 additive (Boss B-3): dialog padding 112:8559 (off-rhythm, measured). -->
    <x:Double x:Key="SaSpace28">28</x:Double>
    <!-- UI.2 icon sizes (Boss B-1; Manual p.08 107:613: 16-20 actions/fields, 20-24 navigation). -->
    <x:Double x:Key="SaIconSizeSmall">16</x:Double>
    <x:Double x:Key="SaIconSizeMedium">20</x:Double>
    <x:Double x:Key="SaIconSizeLarge">24</x:Double>
    <!-- UI.2 status dot 6, Figma 112:1066 (Cortex F-4). -->
    <x:Double x:Key="SaStatusDotSize">6</x:Double>
    <!-- UI.3 additive (D-UI3-8): History/Workloads content pad 40 and block gap 20, 112:2258 / 112:2613. -->
    <x:Double x:Key="SaSpace20">20</x:Double>
    <x:Double x:Key="SaSpace40">40</x:Double>
    <!-- UI.3 page padding: 40 (Figma 112:2258 / 112:2613, >= 640 wide) and 24 horizontally on narrow windows; top 40 clears native captions (UI.6 c1, DERIVED). -->
    <Thickness x:Key="SaPagePadding">40</Thickness>
    <Thickness x:Key="SaPagePaddingCompact">24,40,24,24</Thickness>
    <!-- UI.6 112:1359 p24, Settings bottom 40. Rail and narrow onboarding are DERIVED. -->
    <Thickness x:Key="SaSidebarPadding">24,24,24,40</Thickness>
    <Thickness x:Key="SaRailPadding">16,24,16,40</Thickness>
    <Thickness x:Key="SaOnboardingPadding">48,40,48,36</Thickness>
    <Thickness x:Key="SaOnboardingBenefitPadding">18</Thickness>
    <Thickness x:Key="SaOnboardingCardPadding">24</Thickness>
    <!-- UI.8 Compact window (Figma 05 sec. 15, p20): title band 0-60 = top 20 + 40 (brand padding 20 left, g12 before the
         button); body 16 below the strip, 20 on the other sides. -->
    <Thickness x:Key="SaCompactTitlePadding">20,20,12,0</Thickness>
    <Thickness x:Key="SaCompactBodyPadding">20,16,20,20</Thickness>
</ResourceDictionary>
