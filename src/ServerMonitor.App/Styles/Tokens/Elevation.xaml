<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Defined only. D7: native Acrylic replaces Figma refraction; all fallbacks are opaque.
         Never nest glass surfaces. HC replaces every material with a solid system brush. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Color.Primitives.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SaNeutralSurfaceBrush" Color="{StaticResource SaColorSurfaceDark}" />
            <SolidColorBrush x:Key="SaElevatedSurfaceBrush" Color="{StaticResource SaColorElevatedSurfaceDark}" />
            <AcrylicBrush x:Key="SaGlassSurfaceBrush" TintColor="{StaticResource SaColorGlassTintDark}" TintOpacity=".43" TintLuminosityOpacity=".18" FallbackColor="{StaticResource SaColorSurfaceDark}" />
            <AcrylicBrush x:Key="SaSidebarMaterialBrush" TintColor="{StaticResource SaColorSidebarTintDark}" TintOpacity=".28" TintLuminosityOpacity=".18" FallbackColor="{StaticResource SaColorCanvasDark}" />
            <SolidColorBrush x:Key="SaModalSurfaceBrush" Color="{StaticResource SaColorModalSurfaceDark}" />
            <SolidColorBrush x:Key="SaOpaqueFallbackBrush" Color="{StaticResource SaColorSurfaceDark}" />
            <SolidColorBrush x:Key="SaOverlaySmokeBrush" Color="{StaticResource SaColorOverlaySmokeDark}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SaNeutralSurfaceBrush" Color="{StaticResource SaColorSurfaceLight}" />
            <SolidColorBrush x:Key="SaElevatedSurfaceBrush" Color="{StaticResource SaColorElevatedSurfaceLight}" />
            <AcrylicBrush x:Key="SaGlassSurfaceBrush" TintColor="{StaticResource SaColorGlassTintLight}" TintOpacity=".42" TintLuminosityOpacity=".9" FallbackColor="{StaticResource SaColorSurfaceLight}" />
            <AcrylicBrush x:Key="SaSidebarMaterialBrush" TintColor="{StaticResource SaColorSidebarTintLight}" TintOpacity=".27" TintLuminosityOpacity=".9" FallbackColor="{StaticResource SaColorCanvasLight}" />
            <SolidColorBrush x:Key="SaModalSurfaceBrush" Color="{StaticResource SaColorModalSurfaceLight}" />
            <SolidColorBrush x:Key="SaOpaqueFallbackBrush" Color="{StaticResource SaColorSurfaceLight}" />
            <SolidColorBrush x:Key="SaOverlaySmokeBrush" Color="{StaticResource SaColorOverlaySmokeLight}" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SaNeutralSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SaElevatedSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SaGlassSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SaSidebarMaterialBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SaModalSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SaOpaqueFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SaOverlaySmokeBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- Native shadow object only. NEVER mutate this shared instance (e.g. Receivers): it is app-wide.
         Primitives create their own ThemeShadow; receivers and Translation.Z belong to UI.2 primitives. -->
    <ThemeShadow x:Key="SaSurfaceShadow" />
</ResourceDictionary>
