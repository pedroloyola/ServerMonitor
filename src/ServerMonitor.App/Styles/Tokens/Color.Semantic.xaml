            <SolidColorBrush x:Key="SaSecondaryFillBrush" Color="{StaticResource SaColorSelectedDark}" />
            <SolidColorBrush x:Key="SaSecondaryBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="SaToggleOnTrackBrush" Color="{StaticResource SaColorHealthyDark}" />
