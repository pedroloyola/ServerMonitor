<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls"
    xmlns:converters="using:ServerMonitor.App.Converters">
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:ConnectionStateToBrushConverter x:Key="ConnectionStateToBrushConverter" />
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="AccentPillButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="17,9" />
    </Style>

    <Style x:Key="SubtleIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="QuietPillButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="{ThemeResource MutedSurfaceBrush}" />
    </Style>

    <Style x:Key="PremiumContentDialogStyle" TargetType="ContentDialog">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXLarge}" />
        <Setter Property="Background" Value="{ThemeResource GlassSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
