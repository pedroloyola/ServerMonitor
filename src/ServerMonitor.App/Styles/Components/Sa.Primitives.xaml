<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- Default styles of the NEW Sa* templated controls only (implicit, TargetType primitives:Sa*): by
         construction they cannot reach a production element (NoImplicitStylesExceptSaPrimitiveDefaults).
         Delivered through Application.Resources (merged via Sa.Components.xaml), not Themes/Generic.xaml, so
         a template can use the app's token StaticResources; the runtime proof is the gallery self-check.
         Non-colour tokens are merged HERE so the StaticResources resolve in this file's own scope (T-2). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Spacing.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Forms.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- FormField 112:3337 / error 112:16924: label 12 Medium (text), gap 6, input, helper 11 Regular muted (112:3376) or
         the error 12 Regular in danger text (assertive live region). LabeledBy/DescribedBy are wired in code. -->
    <Style TargetType="primitives:SaFormField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaFormField">
                    <StackPanel Spacing="6">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ValidationStates">
                                <VisualState x:Name="Valid" />
                                <VisualState x:Name="Invalid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Error.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="PART_Header" Style="{StaticResource SaLabelTextStyle}"
                                   Foreground="{ThemeResource SaTextBrush}" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <TextBlock x:Name="PART_Helper" Style="{StaticResource SaHelperTextStyle}"
                                   Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{TemplateBinding HelperText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PART_Error" Style="{StaticResource SaCaptionTextStyle}" Visibility="Collapsed"
                                   Foreground="{ThemeResource SaDangerTextBrush}" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordField 112:3693: TextField metrics + eye toggle (View 17, muted) 15 from the right edge. Never binds Password. -->
    <Style TargetType="primitives:SaPasswordField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaPasswordField">
                    <Grid>
                        <PasswordBox x:Name="PART_PasswordBox" Style="{StaticResource SaPasswordBoxStyle}"
                                     PlaceholderText="{TemplateBinding PlaceholderText}" />
                        <ToggleButton x:Name="PART_RevealButton" Style="{StaticResource SaRevealToggleStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                            <primitives:SaIcon Data="{StaticResource SaIconViewData}" Size="17" />
                        </ToggleButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon (Boss B-1): one stroke-only path, 1.5 DIP stroke at every size (the geometry is scaled in code, never the
         element), round caps and joins, no fill, Foreground inherited from the host so it follows theme and HC.
         Decorative: Raw in UI Automation and not a tab stop. -->
    <Style TargetType="primitives:SaIcon">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaIcon">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Background="Transparent">
                        <Path x:Name="PART_Path"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status dot + label (Figma 112:1066 / 112:1448: dot 6, gap 7, 12 Regular muted). Colour is never the only
         signal: the Label is always rendered and is the automation name (the visible text is Raw for UIA so it is
         not read twice). Dot colours are the Manual tokens (D8), per visual state, so a theme change re-resolves
         them. Stale is DERIVED: secondary text colour, never the disabled brush (HC GrayText = disabled; Cortex F-3). -->
    <Style TargetType="primitives:SaStatusIndicator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaStatusIndicator">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="StatusStates">
                                <VisualState x:Name="Unknown">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaTextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Healthy">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaHealthyBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Attention">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaAttentionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaErrorBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Offline">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaOfflineBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Stale">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaTextSecondaryBrush}" />
                                        <Setter Target="PART_Dot.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse x:Name="PART_Dot"
                                 Width="{StaticResource SaStatusDotSize}"
                                 Height="{StaticResource SaStatusDotSize}"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock x:Name="PART_Label"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Style="{StaticResource SaCaptionTextStyle}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Label}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
