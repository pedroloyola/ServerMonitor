<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- Default styles of the NEW Sa* templated controls only (implicit, TargetType primitives:Sa*): by
         construction they cannot reach a production element (NoImplicitStylesExceptSaPrimitiveDefaults).
         Delivered through Application.Resources (merged via Sa.Components.xaml), not Themes/Generic.xaml, so
         a template can use the app's token StaticResources; the runtime proof is the gallery self-check.
         Non-colour tokens are merged HERE so the StaticResources resolve in this file's own scope (T-2). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Spacing.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Forms.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Buttons.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Text.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Radius.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Borders.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- FormField 112:3337 / error 112:16924: label 12 Medium (text), gap 6, input, helper 11 Regular muted (112:3376) or
         the error 12 Regular in danger text (assertive live region). LabeledBy/DescribedBy are wired in code. -->
    <Style TargetType="primitives:SaFormField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaFormField">
                    <StackPanel Spacing="6">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ValidationStates">
                                <VisualState x:Name="Valid" />
                                <VisualState x:Name="Invalid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Error.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="PART_Header" Style="{StaticResource SaLabelTextStyle}"
                                   Foreground="{ThemeResource SaTextBrush}" Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                        <ContentPresenter HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                        <TextBlock x:Name="PART_Helper" Style="{StaticResource SaHelperTextStyle}"
                                   Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{TemplateBinding HelperText}" TextWrapping="Wrap" />
                        <TextBlock x:Name="PART_Error" Style="{StaticResource SaCaptionTextStyle}" Visibility="Collapsed"
                                   Foreground="{ThemeResource SaDangerTextBrush}" Text="{TemplateBinding ErrorText}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordField 112:3693: TextField metrics + eye toggle (View 17, muted) 15 from the right edge. Never binds Password. -->
    <Style TargetType="primitives:SaPasswordField">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaPasswordField">
                    <Grid>
                        <PasswordBox x:Name="PART_PasswordBox" Style="{StaticResource SaPasswordBoxStyle}"
                                     PlaceholderText="{TemplateBinding PlaceholderText}" />
                        <ToggleButton x:Name="PART_RevealButton" Style="{StaticResource SaRevealToggleStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                            <primitives:SaIcon Data="{StaticResource SaIconViewData}" Size="17" />
                        </ToggleButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon (Boss B-1): one stroke-only path, 1.5 DIP stroke at every size (the geometry is scaled in code, never the
         element), round caps and joins, no fill, Foreground inherited from the host so it follows theme and HC.
         Decorative: Raw in UI Automation and not a tab stop. -->
    <Style TargetType="primitives:SaIcon">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaIcon">
                    <Grid Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Background="Transparent">
                        <Path x:Name="PART_Path"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status dot + label (Figma 112:1066 / 112:1448: dot 6, gap 7, 12 Regular muted). Colour is never the only
         signal: the Label is always rendered and is the automation name (the visible text is Raw for UIA so it is
         not read twice). Dot colours are the Manual tokens (D8), per visual state, so a theme change re-resolves
         them. Stale is DERIVED: secondary text colour, never the disabled brush (HC GrayText = disabled; Cortex F-3). -->
    <Style x:Key="SaStatusIndicatorStyle" TargetType="primitives:SaStatusIndicator">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaStatusIndicator">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="StatusStates">
                                <VisualState x:Name="Unknown">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaTextSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Healthy">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaHealthyBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Attention">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaAttentionBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaErrorBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Offline">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaOfflineBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Stale">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Dot.Fill" Value="{ThemeResource SaTextSecondaryBrush}" />
                                        <Setter Target="PART_Dot.Opacity" Value="0.6" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <!-- UI.3: IsLabelVisible=False (SaStatusDotOnlyStyle) collapses ONLY the label; the dot and its
                                 per-status brush above are shared, never duplicated. -->
                            <VisualStateGroup x:Name="LabelStates">
                                <VisualState x:Name="LabelVisible" />
                                <VisualState x:Name="LabelHidden">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Label.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Ellipse x:Name="PART_Dot"
                                 Width="{StaticResource SaStatusDotSize}"
                                 Height="{StaticResource SaStatusDotSize}"
                                 VerticalAlignment="Center"
                                 Fill="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock x:Name="PART_Label"
                                   VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw"
                                   Style="{StaticResource SaCaptionTextStyle}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Text="{TemplateBinding Label}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Implicit default = the keyed base, so variants can be BasedOn it (WinUI BasedOn needs a key). -->
    <Style TargetType="primitives:SaStatusIndicator" BasedOn="{StaticResource SaStatusIndicatorStyle}" />
    <!-- UI.3 (Boss decision): dot-only status, Workloads rows 112:2650 / 112:2708 (dot 6, the state is the row text on
         the right). Same template, same state->brush/HC mapping; only the label rendering is collapsed. Raw in UIA because
         the row text already carries the status (never colour alone); Label stays required by the guard. Reuse: UI.4 lists. -->
    <Style x:Key="SaStatusDotOnlyStyle" TargetType="primitives:SaStatusIndicator" BasedOn="{StaticResource SaStatusIndicatorStyle}">
        <Setter Property="IsLabelVisible" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
    </Style>
    <!-- UI.3 read-only, keyboard-reachable data-table row (h64 compact, 112:2650 / 112:2708): no background/hover/pressed
         state (it is not interactive), only the system focus ring when the arrows land on it. -->
    <Style TargetType="primitives:SaDataTableRow">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusControl}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SaFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource SaFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <!-- Prism R1 (M-2 visual): ring = SaFocusRingBrush 2 px, control radius 12, inset 2 (DERIVED, Figma has no focus). -->
        <Setter Property="FocusVisualMargin" Value="2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaDataTableRow">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            AutomationProperties.AccessibilityView="Raw" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- UI.3 read-only data-table list (Cortex M-2): UIA List around the virtualized rows; not a tab stop itself. -->
    <Style TargetType="primitives:SaDataTableList">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaDataTableList">
                    <ContentPresenter
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- ===================== UI.2 S6: data and feedback primitives ===================== -->

    <!-- MetricBar mini 112:1040 / 112:1252: track h5 radius 3 (SaRadiusMiniBar), empty-bar colour, fill = Manual metric
         colour (D8: Light RAW #8E5FD9/#3D8ED9/#D98127 not adopted), value 12 muted at the right. NaN = "—", empty track. -->
    <Style TargetType="primitives:SaMetricBar">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaMetricBar">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="MetricStates">
                                <VisualState x:Name="Cpu" />
                                <VisualState x:Name="Memory">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Fill.Background" Value="{ThemeResource SaMemoryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disk">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Fill.Background" Value="{ThemeResource SaDiskBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_Track" Height="5" VerticalAlignment="Center" CornerRadius="{StaticResource SaRadiusMiniBar}"
                                Background="{ThemeResource SaBarEmptyBrush}">
                            <Border x:Name="PART_Fill" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusMiniBar}"
                                    Background="{ThemeResource SaCpuBrush}" />
                        </Border>
                        <TextBlock x:Name="PART_Text" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                   Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- KeyValueRow: Stacked 112:1906 (12 muted / 17 Medium, gap 8); Inline 112:1919 (13 muted in 190 / 13 Medium, gap 10, h23). -->
    <Style TargetType="primitives:SaKeyValueRow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaKeyValueRow">
                    <Grid x:Name="RootGrid" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="KeyColumn" Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="OrientationStates">
                                <VisualState x:Name="Stacked" />
                                <VisualState x:Name="Inline">
                                    <VisualState.Setters>
                                        <Setter Target="KeyColumn.Width" Value="190" />
                                        <Setter Target="RootGrid.ColumnSpacing" Value="10" />
                                        <Setter Target="RootGrid.RowSpacing" Value="0" />
                                        <Setter Target="PART_Value.(Grid.Row)" Value="0" />
                                        <Setter Target="PART_Value.(Grid.Column)" Value="1" />
                                        <Setter Target="PART_Key.Style" Value="{StaticResource SaPrimaryBodyTextStyle}" />
                                        <Setter Target="PART_Key.FontSize" Value="{StaticResource SaFontSizeControl}" />
                                        <Setter Target="PART_Key.Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
                                        <Setter Target="PART_Value.Style" Value="{StaticResource SaControlTextStyle}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock x:Name="PART_Key" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                   Text="{TemplateBinding Key}" AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock x:Name="PART_Value" Grid.Row="1" Style="{StaticResource SaValueTextStyle}" Foreground="{ThemeResource SaTextBrush}"
                                   Text="{TemplateBinding Value}" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListRow simple 112:1057 (icon 20, name 14 Medium [Figma 15 - no token, deviation], trailing, chevron 18, h48, gap 12)
         / rich 112:1933 (icon 22, 14 Medium + 12 muted, chevron 16, h70, gap 14). Hover/pressed/focus DERIVED. -->
    <Style TargetType="primitives:SaListRow">
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusControl}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SaFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource SaFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaListRow">
                    <Grid x:Name="RootGrid" MinHeight="48" Padding="{TemplateBinding Padding}" ColumnSpacing="12"
                          Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SaHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SaSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.58" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="VariantStates">
                                <VisualState x:Name="Simple" />
                                <VisualState x:Name="Rich">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.MinHeight" Value="70" />
                                        <Setter Target="RootGrid.ColumnSpacing" Value="14" />
                                        <Setter Target="PART_Icon.Size" Value="22" />
                                        <Setter Target="PART_Chevron.Size" Value="16" />
                                        <Setter Target="PART_Detail.Visibility" Value="Visible" />
                                        <Setter Target="PART_Trailing.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <primitives:SaIcon x:Name="PART_Icon" Data="{TemplateBinding IconData}" Size="20" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource SaButtonTextStyle}" Text="{TemplateBinding Title}" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="PART_Detail" Visibility="Collapsed" Style="{StaticResource SaCaptionTextStyle}"
                                       Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{TemplateBinding Detail}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ContentPresenter x:Name="PART_Trailing" Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding Trailing}" />
                        <primitives:SaIcon x:Name="PART_Chevron" Grid.Column="3" Data="{StaticResource SaIconArrowRight01Data}" Size="18"
                                           VerticalAlignment="Center" Foreground="{ThemeResource SaTextSecondaryBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- InlineNotice Error 112:18273 / 112:18441: Manual inset (interior + inset border, radius 12), pad-x 16, gap 16, min h72;
         "!" 20 Semibold danger; title 14 Semibold; message 12 muted (lh 16 vs Figma 18 - type ramp); action = Content.
         Info 112:2756: no surface, Information icon 15 + 12 muted, gap 8. -->
    <Style TargetType="primitives:SaInlineNotice">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaInlineNotice">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="SeverityStates">
                                <VisualState x:Name="Info" />
                                <VisualState x:Name="Error">
                                    <VisualState.Setters>
                                        <Setter Target="PART_InfoLayout.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_ErrorLayout.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <StackPanel x:Name="PART_InfoLayout" Orientation="Horizontal" Spacing="8">
                            <primitives:SaIcon Data="{StaticResource SaIconInformationCircleData}" Size="15" VerticalAlignment="Center"
                                               Foreground="{ThemeResource SaTextSecondaryBrush}" />
                            <!-- R1 (Beacon F-4): the notice's own Name already carries title + message; inner text is Raw so it is read once. -->
                            <TextBlock Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                       Text="{TemplateBinding Message}" TextWrapping="Wrap" VerticalAlignment="Center"
                                       AutomationProperties.AccessibilityView="Raw" />
                        </StackPanel>
                        <Border x:Name="PART_ErrorLayout" Visibility="Collapsed" MinHeight="72" Padding="16,12"
                                Background="{ThemeResource SaInteriorBrush}" BorderBrush="{ThemeResource SaBorderInsetBrush}"
                                BorderThickness="{StaticResource SaBorderThickness}" CornerRadius="{StaticResource SaRadiusControl}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SaTitleTextStyle}" Foreground="{ThemeResource SaDangerTextBrush}" Text="!"
                                           VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" FontWeight="SemiBold" Text="{TemplateBinding Title}" TextWrapping="Wrap"
                                               AutomationProperties.AccessibilityView="Raw" />
                                    <TextBlock Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                               Text="{TemplateBinding Message}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toast (visual only) 112:19613 / 112:19779: 600x80, radius 20, pad-x 20, gap 16, Manual panel + inset border,
         success badge 28 (Healthy/Success, Figma variable misnamed "disk"), tick 16 in the panel colour, title 14 Semibold,
         message 12 muted, close 28. Shadow not reproduced (deviation). -->
    <Style TargetType="primitives:SaToast">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="600" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaToast">
                    <Border MinHeight="80" Padding="20,0,16,0" CornerRadius="{StaticResource SaRadiusToast}"
                            Background="{ThemeResource SaSurfaceBrush}" BorderBrush="{ThemeResource SaBorderInsetBrush}"
                            BorderThickness="{StaticResource SaBorderThickness}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="28" Height="28" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource SaSuccessBrush}" />
                                <primitives:SaIcon Data="{StaticResource SaIconTick02Data}" Size="16" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource SaSurfaceBrush}" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" FontWeight="SemiBold" Text="{TemplateBinding Title}"
                                           AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                           Text="{TemplateBinding Message}" TextWrapping="Wrap" AutomationProperties.AccessibilityView="Raw" />
                            </StackPanel>
                            <Button x:Name="PART_CloseButton" Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SaGhostIconButtonStyle}">
                                <primitives:SaIcon Data="{StaticResource SaIconCancel01Data}" Size="20" />
                            </Button>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Skeleton block 112:15602: radius 6, SaSkeletonBrush (secondary text @ .14). Size from the consumer. -->
    <Style TargetType="primitives:SaSkeleton">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaSkeleton">
                    <Border Background="{ThemeResource SaSkeletonBrush}" CornerRadius="{StaticResource SaRadiusSkeleton}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- EmptyState 112:14088 / 112:14182: icon 40 muted, title 24/30 Semibold, message 14 muted centred (<= 560), action, gap 16. -->
    <Style TargetType="primitives:SaEmptyState">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaEmptyState">
                    <StackPanel Spacing="16" HorizontalAlignment="Center" MaxWidth="560">
                        <primitives:SaIcon Data="{TemplateBinding IconData}" Size="40" HorizontalAlignment="Center"
                                           Foreground="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SaEmptyTitleTextStyle}" Foreground="{ThemeResource SaTextBrush}"
                                   Text="{TemplateBinding Title}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="{TemplateBinding Message}"
                                   TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        <ContentPresenter HorizontalAlignment="Center" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Breadcrumb parent: a text-only button, 12 muted (hover DERIVED: text colour). -->
    <Style x:Key="SaBreadcrumbParentButtonStyle" TargetType="Button" BasedOn="{StaticResource SaButtonBaseStyle}">
        <Setter Property="Template" Value="{StaticResource SaFlatButtonTemplate}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusSmall}" />
    </Style>

    <!-- Breadcrumb 112:1786 / 112:2023: h22, gap 8, parent 12 muted, chevron 14, current 12 text. -->
    <Style TargetType="primitives:SaBreadcrumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:SaBreadcrumb">
                    <StackPanel Orientation="Horizontal" Spacing="8" Height="22">
                        <Button x:Name="PART_Parent" Style="{StaticResource SaBreadcrumbParentButtonStyle}" VerticalAlignment="Center"
                                Content="{TemplateBinding ParentText}" />
                        <primitives:SaIcon Data="{StaticResource SaIconArrowRight01Data}" Size="14" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextBrush}" VerticalAlignment="Center"
                                   Text="{TemplateBinding CurrentText}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
