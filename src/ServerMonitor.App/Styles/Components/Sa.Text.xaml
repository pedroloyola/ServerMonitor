<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Text roles built on the Typography ramp: ramp style + semantic foreground. Brushes are always
         ThemeResource so Dark/Light/HC re-resolve at runtime. Typography is merged HERE so every BasedOn
         resolves in this file's own scope, independent of App.xaml order (T-2). Final roles: Prism inventory. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="SaSectionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaTitleTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
    </Style>
    <Style x:Key="SaPrimaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
    </Style>
    <Style x:Key="SaSecondaryBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaBodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <!-- Table header 10/14 Medium muted, Figma 112:1434 (Boss B-3, Cortex F-5). Casing comes from the content. -->
    <Style x:Key="SaTableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeTableHeader}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightTableHeader}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <!-- UI.3 additive (human decision): Workloads column headers 10/14 REGULAR muted, 112:2647 / 112:2648. Servers keep Medium. -->
    <Style x:Key="SaTableHeaderRegularTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaTableHeaderTextStyle}">
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <!-- Metric unit "%" 20 Regular muted next to the 44 Light value (112:1816). -->
    <Style x:Key="SaMetricUnitTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaTitleTextStyle}">
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <!-- Status badge "1 problema" 11 Medium in the accessible attention text (112:2640). -->
    <Style x:Key="SaStatusBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaHelperTextStyle}">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{ThemeResource SaAttentionTextBrush}" />
    </Style>
    <!-- DataTable cells 112:1434: name / value 14 Medium text, secondary line 12 muted, attention value in attention text. -->
    <Style x:Key="SaTableCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaButtonTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
    </Style>
    <Style x:Key="SaTableCellSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaCaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <Style x:Key="SaTableCellAttentionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaButtonTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaAttentionTextBrush}" />
    </Style>
    <!-- UI.3 additive (D-UI3-8). Page subtitle 13 Regular muted, 112:2262 / 112:2437 (SaControlTextStyle is Medium). -->
    <Style x:Key="SaPageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeControl}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightControl}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <!-- Chart axis labels 10 Regular muted, 112:2298 (SaMicroTextStyle is SemiBold). -->
    <Style x:Key="SaChartAxisTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeMicro}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightMicro}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <!-- Chart value unit "%" 19 Regular muted next to the 38 Light SaChartValueTextStyle, 112:2291. -->
    <Style x:Key="SaChartUnitTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeChartUnit}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="{StaticResource SaLineHeightChartUnit}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <!-- UI.3 Workloads row state lines 112:2650 / 112:2666 (D-UI3-2): line 1 = 12 Medium text, line 2 = 11 Regular muted;
         a problem (or transient warning) row has BOTH lines in the attention text colour. Selected by
         WorkloadSeverityToSaTextStyleConverter. -->
    <Style x:Key="SaWorkloadStateTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaLabelTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
    </Style>
    <Style x:Key="SaWorkloadStateAttentionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaLabelTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaAttentionTextBrush}" />
    </Style>
    <Style x:Key="SaWorkloadDetailTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaHelperTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
    </Style>
    <Style x:Key="SaWorkloadDetailAttentionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaHelperTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaAttentionTextBrush}" />
    </Style>
    <!-- UI.10 F09/F10 (H04): ONE page header for Visão geral, Servidores and Definições (Figma component Page header 235:270,
         instances 240:614 / 240:588 / 247:418). Title 32/40 + line 2 13/18 muted, gap 6, the block at the TOP; line 2 keeps
         its 18 even when empty, so nothing jumps when the caption comes and goes. Actions (gap 16) sit centred on the title
         LINE whatever line 2 holds: a 44 button over the 40 line = Margin -2 top; a status text (Definições) is centred on
         the same 40 line. Column gap 16. Ui10PolishGuardTests pins the three pages to these styles. -->
    <Style x:Key="SaPageHeaderGridStyle" TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>
    <Style x:Key="SaPageHeaderTitleBlockStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="SaPageHeaderLineTwoStyle" TargetType="StackPanel">
        <Setter Property="MinHeight" Value="{StaticResource SaLineHeightControl}" />
    </Style>
    <Style x:Key="SaPageHeaderActionsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="16" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,-2,0,0" />
    </Style>
    <!-- The status text in the actions slot: 11/16 centred on the 40 title line = 12 above. -->
    <Style x:Key="SaPageHeaderStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SaHelperTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
</ResourceDictionary>
