    <!-- ===== ToggleSwitch 112:7956 / 112:7982: track 44x26 radius 13, thumb 22 #FCFCFC (margin 2), On = SaToggleOnTrackBrush
         (Boss B-2: SaHealthy colour in Dark/Light; R1 Cortex R-3: Highlight in HC, Off = WindowText - GrayText is disabled-only), Off = SaToggleOffTrackBrush. Thumb shadow not reproduced. WinUI part names kept (SwitchKnobBounds,
         SwitchKnob, KnobTranslateTransform, SwitchThumb, OuterBorder) so tap, drag and keyboard behave natively. The
         setting row (label 14 Medium + description 12) is the consumer's. ===== -->
    <Style x:Key="SaToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="ManipulationMode" Value="System,TranslateX" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SaFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource SaFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchAreaGrid.Background" Value="{ThemeResource SaHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="SwitchAreaGrid.Background" Value="{ThemeResource SaSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.58" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualState x:Name="Dragging" />
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTranslateTransform" Storyboard.TargetProperty="X" To="18" Duration="0" />
                                        <DoubleAnimation Storyboard.TargetName="SwitchKnobBounds" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ContentStates">
                                <VisualState x:Name="OffContent" />
                                <VisualState x:Name="OnContent" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="SwitchAreaGrid" Width="52" Height="34" CornerRadius="17"
                              Background="Transparent" Control.IsTemplateFocusTarget="True" HorizontalAlignment="Left">
                            <Rectangle x:Name="OuterBorder" Width="44" Height="26" RadiusX="13" RadiusY="13"
                                       Fill="{ThemeResource SaToggleOffTrackBrush}" />
                            <Rectangle x:Name="SwitchKnobBounds" Width="44" Height="26" RadiusX="13" RadiusY="13" Opacity="0"
                                       Fill="{ThemeResource SaToggleOnTrackBrush}" />
                            <Grid x:Name="SwitchKnob" Width="26" Height="26" Margin="4,0,0,0" HorizontalAlignment="Left">
                                <Ellipse x:Name="SwitchKnobOff" Width="22" Height="22" Fill="{ThemeResource SaToggleThumbBrush}" />
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="KnobTranslateTransform" />
                                </Grid.RenderTransform>
                            </Grid>
                            <Thumb x:Name="SwitchThumb" AutomationProperties.AccessibilityView="Raw">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Rectangle Fill="Transparent" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

