<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- UI.2 S4 form controls (Boss B-4), keyed styles on native WinUI controls so input, IME, selection,
         keyboard and UI Automation stay WinUI's. TextBox / PasswordBox / CheckBox / ToggleSwitch / RadioButton use
         Sa templates that keep the WinUI template part and visual-state names; ComboBox keeps the Fluent template
         (it depends on the internal ComboBoxHelper) and is styled through properties plus the F-3 accent-neutral
         scope for its states and popup. Rest / Error / Checked / On-Off / Selected are MEASURED; hover / pressed /
         focus / disabled-input are DERIVED (B-4). Non-colour tokens and icon data are merged here (T-2). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Radius.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Borders.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Spacing.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Components/Sa.Surfaces.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Pill radii are h/2 literals (Figma): a radius above h/2 (SaRadiusPill 99) renders ELLIPTICAL in WinUI. -->
    <!-- ===== Text fields ===== -->
    <ControlTemplate x:Key="SaTextFieldTemplate" TargetType="TextBox">
        <Grid x:Name="RootGrid">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- DERIVED: hover = SaHoverBrush veil over the fill. -->
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="HoverOverlay.Background" Value="{ThemeResource SaHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- DERIVED (no Figma focus node): 2px SaFocusRingBrush ring over the border, so an Error border survives. -->
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="0.58" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HoverOverlay" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <Grid Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="ContentElement"
                              VerticalAlignment="Center"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              ZoomMode="Disabled"
                              IsTabStop="False"
                              AutomationProperties.AccessibilityView="Raw" />
                <ContentControl x:Name="PlaceholderTextContentPresenter"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding PlaceholderText}"
                                Foreground="{ThemeResource SaTextSecondaryBrush}"
                                IsHitTestVisible="False"
                                IsTabStop="False" />
            </Grid>
            <Border x:Name="FocusRing"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{ThemeResource SaFocusRingBrush}"
                    BorderThickness="{StaticResource SaFocusRingThickness}"
                    Opacity="0"
                    IsHitTestVisible="False" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="SaPageSearchFieldTemplate" TargetType="TextBox">
        <Grid x:Name="RootGrid">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- DERIVED: hover = SaHoverBrush veil over the fill. -->
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="HoverOverlay.Background" Value="{ThemeResource SaHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- DERIVED (no Figma focus node): 2px SaFocusRingBrush ring over the border, so an Error border survives. -->
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="0.58" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HoverOverlay" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <Grid Padding="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <primitives:SaIcon Data="{StaticResource SaIconSearch01Data}" Size="18" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{ThemeResource SaTextSecondaryBrush}" />
                <ScrollViewer x:Name="ContentElement" Grid.Column="1"
                              VerticalAlignment="Center"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              ZoomMode="Disabled"
                              IsTabStop="False"
                              AutomationProperties.AccessibilityView="Raw" />
                <ContentControl x:Name="PlaceholderTextContentPresenter" Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding PlaceholderText}"
                                Foreground="{ThemeResource SaTextSecondaryBrush}"
                                IsHitTestVisible="False"
                                IsTabStop="False" />
            </Grid>
            <Border x:Name="FocusRing"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{ThemeResource SaFocusRingBrush}"
                    BorderThickness="{StaticResource SaFocusRingThickness}"
                    Opacity="0"
                    IsHitTestVisible="False" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="SaPillSearchFieldTemplate" TargetType="TextBox">
        <Grid x:Name="RootGrid">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- DERIVED: hover = SaHoverBrush veil over the fill. -->
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="HoverOverlay.Background" Value="{ThemeResource SaHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- DERIVED (no Figma focus node): 2px SaFocusRingBrush ring over the border, so an Error border survives. -->
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="0.58" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HoverOverlay" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <Grid Padding="{TemplateBinding Padding}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <primitives:SaIcon Data="{StaticResource SaIconSearch01Data}" Size="17" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{ThemeResource SaTextSecondaryBrush}" />
                <ScrollViewer x:Name="ContentElement" Grid.Column="1"
                              VerticalAlignment="Center"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              ZoomMode="Disabled"
                              IsTabStop="False"
                              AutomationProperties.AccessibilityView="Raw" />
                <ContentControl x:Name="PlaceholderTextContentPresenter" Grid.Column="1"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding PlaceholderText}"
                                Foreground="{ThemeResource SaTextSecondaryBrush}"
                                IsHitTestVisible="False"
                                IsTabStop="False" />
            </Grid>
            <Border x:Name="FocusRing"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{ThemeResource SaFocusRingBrush}"
                    BorderThickness="{StaticResource SaFocusRingThickness}"
                    Opacity="0"
                    IsHitTestVisible="False" />
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="SaPasswordBoxTemplate" TargetType="PasswordBox">
        <Grid x:Name="RootGrid">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <!-- DERIVED: hover = SaHoverBrush veil over the fill. -->
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="HoverOverlay.Background" Value="{ThemeResource SaHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <!-- DERIVED (no Figma focus node): 2px SaFocusRingBrush ring over the border, so an Error border survives. -->
                    <VisualState x:Name="Focused">
                        <VisualState.Setters>
                            <Setter Target="FocusRing.Opacity" Value="1" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Opacity" Value="0.58" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="BorderElement"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="HoverOverlay" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <Grid Padding="{TemplateBinding Padding}">
                <ScrollViewer x:Name="ContentElement"
                              VerticalAlignment="Center"
                              HorizontalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled"
                              ZoomMode="Disabled"
                              IsTabStop="False"
                              AutomationProperties.AccessibilityView="Raw" />
                <ContentControl x:Name="PlaceholderTextContentPresenter"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding PlaceholderText}"
                                Foreground="{ThemeResource SaTextSecondaryBrush}"
                                IsHitTestVisible="False"
                                IsTabStop="False" />
            </Grid>
            <Border x:Name="FocusRing"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    BorderBrush="{ThemeResource SaFocusRingBrush}"
                    BorderThickness="{StaticResource SaFocusRingThickness}"
                    Opacity="0"
                    IsHitTestVisible="False" />
        </Grid>
    </ControlTemplate>

    <!-- TextField 112:3337 / 112:3498: h40, radius 12, pad-x 14, input fill .65/.34, 1px subtle border, 13 Regular.
         Placeholder uses SaTextSecondaryBrush (a11y deviation from Figma #808080/#7A7A7A, Boss B-2). -->
    <Style x:Key="SaTextFieldStyle" TargetType="TextBox">
        <Setter Property="Template" Value="{StaticResource SaTextFieldTemplate}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource SaInputFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SaBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SaBorderThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeControl}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Error 112:16924 / 112:17088: border 1.5 in the danger variable (= SaErrorBrush); the message is SaFormField's. -->
    <Style x:Key="SaTextFieldErrorStyle" TargetType="TextBox" BasedOn="{StaticResource SaTextFieldStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource SaErrorBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SaErrorBorderThickness}" />
    </Style>
    <!-- SearchField Page 112:1429 / 112:1611: h44, radius 14, pad-L 16, gap 10, search fill, no border, icon 18. -->
    <Style x:Key="SaPageSearchFieldStyle" TargetType="TextBox" BasedOn="{StaticResource SaTextFieldStyle}">
        <Setter Property="Template" Value="{StaticResource SaPageSearchFieldTemplate}" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="16,0,14,0" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusRect}" />
        <Setter Property="Background" Value="{ThemeResource SaSearchFillBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- SearchField Pill 112:1051 / 112:1263: h38, radius h/2, pad-L 12, gap 8, Secondary fill, icon 17, 12 text. -->
    <Style x:Key="SaPillSearchFieldStyle" TargetType="TextBox" BasedOn="{StaticResource SaTextFieldStyle}">
        <Setter Property="Template" Value="{StaticResource SaPillSearchFieldTemplate}" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0,14,0" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Background" Value="{ThemeResource SaSecondaryFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SaSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource SaSecondaryBorderThickness}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeCaption}" />
    </Style>
    <!-- PasswordBox inside SaPasswordField 112:3693: TextField metrics + room on the right for the eye (17, 15 from the edge). -->
    <Style x:Key="SaPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Template" Value="{StaticResource SaPasswordBoxTemplate}" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0,44,0" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource SaInputFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SaBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SaBorderThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeControl}" />
        <Setter Property="PasswordRevealMode" Value="Hidden" />
    </Style>
    <!-- UI.7C (B-16, Figma 06 112:16924, G-24): the password box in error - the SAME 1.5 danger border as a text field. -->
    <Style x:Key="SaPasswordBoxErrorStyle" TargetType="PasswordBox" BasedOn="{StaticResource SaPasswordBoxStyle}">
        <Setter Property="BorderBrush" Value="{ThemeResource SaErrorBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SaErrorBorderThickness}" />
    </Style>
    <!-- Eye toggle of SaPasswordField: 28x28, no fill, muted icon; checked (revealed) = text colour. DERIVED states. -->
    <Style x:Key="SaRevealToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SaFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource SaFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SaHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SaSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.58" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SaTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SaHoverBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SaTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Background" Value="{ThemeResource SaSelectedBrush}" />
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SaTextBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.58" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter x:Name="ContentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Selectors (ComboBox, Fluent template) =====
         Field 112:3388 / 112:3549: = TextField (h40 r12 input fill + subtle border), value 13 Regular.
         Pill 112:7944 / 112:8105: h36 radius h/2, Secondary fill, value 12. The chevron stays the Fluent glyph
         (ACCEPTABLE, Prism §3.3 E70D) - the Hugeicons ArrowDown01 would need a copy of the internal-dependent
         ComboBox template; recorded as a deviation. Hover/pressed/focus/popup colours come from the F-3 scope. -->
    <Style x:Key="SaSelectorFieldStyle" TargetType="ComboBox">
        <!-- Beacon F2 (WCAG 2.4.7): the same 2 px SaFocusRing as every other Sa control (Field, Pill and Rich inherit it). -->
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SaFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource SaFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="Padding" Value="14,0,0,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusControl}" />
        <Setter Property="Background" Value="{ThemeResource SaInputFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SaBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource SaBorderThickness}" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeControl}" />
    </Style>
    <Style x:Key="SaSelectorPillStyle" TargetType="ComboBox" BasedOn="{StaticResource SaSelectorFieldStyle}">
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{ThemeResource SaSecondaryFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SaSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource SaSecondaryBorderThickness}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeCaption}" />
    </Style>

    <!-- Item template of SaSelectorRichStyle. Contract (no VM type): the item exposes Name and Subtitle strings;
         an empty Subtitle keeps its line so the closed selector never changes height. Icon and name INHERIT the
         ComboBox foreground (text at rest, the Fluent disabled colour when disabled); only the subtitle is muted. -->
    <DataTemplate x:Key="SaSelectorRichItemTemplate">
        <Grid ColumnSpacing="{StaticResource SaSpace12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="{StaticResource SaIconSizeMedium}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource SaButtonTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SaHelperTextStyle}"
                           Foreground="{ThemeResource SaTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </Grid>
    </DataTemplate>
    <!-- UI.3 additive (D-UI3-8). Rich selector 112:2264 / 112:2442: 330x52 r16, pad-x 16, fill = search fill
         (#666666@.18 / #FFF@.42 measured, the SaSearchFill token), no rest border (HC 1px via the Secondary border
         tokens); content = ServerStack01 20 + name 14 Medium + subtitle 11 muted, gap 12 / 2. The chevron stays the
         Fluent glyph (same accepted deviation as SaSelectorFieldStyle). Reuse: History server selector now,
         Overview/Servers (UI.4) and Settings later (Prism inventory 6.2). -->
    <Style x:Key="SaSelectorRichStyle" TargetType="ComboBox" BasedOn="{StaticResource SaSelectorFieldStyle}">
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Padding" Value="16,0,0,0" />
        <Setter Property="CornerRadius" Value="{StaticResource SaRadiusSelector}" />
        <Setter Property="Background" Value="{ThemeResource SaSearchFillBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SaSecondaryBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource SaSecondaryBorderThickness}" />
        <Setter Property="ItemTemplate" Value="{StaticResource SaSelectorRichItemTemplate}" />
    </Style>

    <!-- ===== CheckBox 155:240 / 159:394: box 15x15 radius 4; unchecked 1px neutral border, no fill; checked fill =
         text colour + tick 11 in the input fill colour (exactly the Figma rgba(36,36,36,.65) / rgba(255,255,255,.34)
         glyph); label 13 Regular muted, gap 8. Indeterminate is DERIVED (a bar). WinUI's CombinedStates names. ===== -->
    <Style x:Key="SaCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeControl}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SaFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource SaFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="RootGrid" Background="Transparent" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CombinedStates">
                                <VisualState x:Name="UncheckedNormal" />
                                <VisualState x:Name="UncheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource SaHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UncheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource SaSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="UncheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.58" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedNormal">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                                        <Setter Target="Box.Opacity" Value="0.86" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                                        <Setter Target="Box.Opacity" Value="0.72" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Box.Background" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="Box.BorderBrush" Value="{ThemeResource SaTextBrush}" />
                                        <Setter Target="CheckGlyph.Opacity" Value="1" />
                                        <Setter Target="RootGrid.Opacity" Value="0.58" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IndeterminateNormal">
                                    <VisualState.Setters>
                                        <Setter Target="IndeterminateGlyph.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IndeterminatePointerOver">
                                    <VisualState.Setters>
