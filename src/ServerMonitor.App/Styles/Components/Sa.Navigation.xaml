<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- UI.2 S4 navigation item on RadioButton (single selection, SelectionItem pattern for free). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Typography.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Radius.xaml" />
        <ResourceDictionary Source="ms-appx:///Styles/Tokens/Borders.xaml" />
    </ResourceDictionary.MergedDictionaries>
    <!-- SidebarNavItem 112:969 (selected) / 112:976 (unselected): h46 w160 radius h/2 pad-L 12, icon 20 + gap 10 + 13 text (content); selected = Secondary fill + highlight, Medium, selected text; unselected Regular muted, no fill. Hover/pressed/focus DERIVED. Host (NavigationView vs list) is a UI.6 decision. -->
    <Style x:Key="SaNavItemStyle" TargetType="RadioButton">
        <Setter Property="Height" Value="46" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Width" Value="160" />
        <Setter Property="CornerRadius" Value="23" />
        <Setter Property="FontFamily" Value="{StaticResource SaFontText}" />
        <Setter Property="FontSize" Value="{StaticResource SaFontSizeControl}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource SaTextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SaFocusRingBrush}" />
        <Setter Property="FocusVisualPrimaryThickness" Value="{StaticResource SaFocusRingThickness}" />
        <Setter Property="FocusVisualSecondaryThickness" Value="0" />
        <!-- UI.10 F01 (H01) + Prism UI.10C RC-1: the keyboard ring sits ON the pill edge (160x46, r23 - concentric by
             construction, normal and rail), never a frame larger than the selection (Figma Nav item Focus 235:243). The
             inherited RadioButton default (-7,-3) made it 174x52 and off-centre; -3 still read as a bigger selection. Action
             buttons keep -3 (they have no selection fill to be confused with the ring). -->
        <Setter Property="FocusVisualMargin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="StateOverlay.Background" Value="{ThemeResource SaHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <!-- R1 (Beacon F-5): pressed = overlay only (one step above hover), no content opacity. -->
                                        <Setter Target="StateOverlay.Background" Value="{ThemeResource SaSelectedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.58" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <!-- UI.11 F07: the fill + top highlight are the sidebar's ONE sliding indicator
                                             (SaSlidingSelection, vertical), never the item's own: text only here. -->
                                        <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource SaSelectedTextBrush}" />
                                        <Setter Target="ContentPresenter.FontWeight" Value="Medium" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="StateOverlay" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" Background="Transparent" primitives:SaMotion.HoverFade="True" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Foreground="{TemplateBinding Foreground}"
                                          AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
