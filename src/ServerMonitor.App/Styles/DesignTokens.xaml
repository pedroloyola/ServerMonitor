<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#11141B" />
            <AcrylicBrush
                x:Key="GlassSurfaceBrush"
                FallbackColor="#E0242933"
                TintColor="#242933"
                TintLuminosityOpacity="0.18"
                TintOpacity="0.72" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7AFFFFFF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#293F7CFF" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#AFC8FF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#EFF2F7" />
            <AcrylicBrush
                x:Key="GlassSurfaceBrush"
                FallbackColor="#E8FFFFFF"
                TintColor="#FFFFFF"
                TintLuminosityOpacity="0.76"
                TintOpacity="0.68" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#1A27364A" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B01C2636" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#801C2636" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#254B75E8" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#2451B7" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#11141B" />
            <AcrylicBrush
                x:Key="GlassSurfaceBrush"
                FallbackColor="#E0242933"
                TintColor="#242933"
                TintLuminosityOpacity="0.18"
                TintOpacity="0.72" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#7AFFFFFF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#293F7CFF" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#AFC8FF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="RadiusSmall">10</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">14</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">18</CornerRadius>
    <CornerRadius x:Key="RadiusXLarge">24</CornerRadius>

    <x:Double x:Key="SpacingXS">4</x:Double>
    <x:Double x:Key="SpacingS">8</x:Double>
    <x:Double x:Key="SpacingM">12</x:Double>
    <x:Double x:Key="SpacingL">16</x:Double>
    <x:Double x:Key="SpacingXL">24</x:Double>
    <x:Double x:Key="SpacingXXL">32</x:Double>

    <Thickness x:Key="PagePadding">28</Thickness>
    <Thickness x:Key="GlassCardPadding">24</Thickness>
    <Thickness x:Key="GlassBorderThickness">1</Thickness>

    <x:Double x:Key="GlassBackgroundOpacity">0.72</x:Double>
    <x:Double x:Key="GlassBorderOpacity">0.12</x:Double>
    <x:Double x:Key="GlassBlurStrength">30</x:Double>
    <x:Double x:Key="GlassShadowOpacity">0.16</x:Double>

    <SolidColorBrush x:Key="StatusHealthyBrush" Color="#45C782" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#E5A93D" />
    <SolidColorBrush x:Key="StatusCriticalBrush" Color="#EC6464" />
    <SolidColorBrush x:Key="StatusOfflineBrush" Color="#C56A70" />
</ResourceDictionary>
