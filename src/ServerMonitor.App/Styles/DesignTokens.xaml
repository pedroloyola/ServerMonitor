            <!-- ContentDialog Continuous Glass Overrides -->
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="GlassSurfaceBrush" />
            <SolidColorBrush x:Key="ContentDialogCommandsBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#16000000" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#25000000" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackground" Color="#1846E1" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPointerOver" Color="#2957F5" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPressed" Color="#1036B8" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForegroundPressed" Color="#FFFFFF" />

            <!-- Semantic Status Brushes (Preserved) -->
            <SolidColorBrush x:Key="StatusHealthyBrush" Color="#059669" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#D97706" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="StatusOfflineBrush" Color="#64748B" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#94A3B8" />
