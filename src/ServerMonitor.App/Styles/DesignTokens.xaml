<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Backgrounds & Glass Layers -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#111318" />
            <SolidColorBrush x:Key="WindowBackdropTintBrush" Color="#28111318" />
            <SolidColorBrush x:Key="TitleBarSurfaceBrush" Color="#20111318" />
            <AcrylicBrush
                x:Key="GlassSurfaceBrush"
                FallbackColor="#E8161A22"
                TintColor="#181D26"
                TintLuminosityOpacity="0.18"
                TintOpacity="0.70" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#1EFFFFFF" />
            <SolidColorBrush x:Key="GlassHighlightBrush" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="MutedSurfaceBrush" Color="#10FFFFFF" />
            <SolidColorBrush x:Key="ModalSmokeBrush" Color="#50000000" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B4" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#667285" />

            <!-- Brand Accent #1846E1 -->
            <Color x:Key="SystemAccentColor">#1846E1</Color>
            <Color x:Key="SystemAccentColorLight1">#2957F5</Color>
            <Color x:Key="SystemAccentColorLight2">#4D74F7</Color>
            <Color x:Key="SystemAccentColorLight3">#7E9CF9</Color>
            <Color x:Key="SystemAccentColorDark1">#1338B5</Color>
            <Color x:Key="SystemAccentColorDark2">#0F2C8E</Color>
            <Color x:Key="SystemAccentColorDark3">#0A1E63</Color>
            <Color x:Key="AccentColor">#1846E1</Color>

            <SolidColorBrush x:Key="BrandAccentBrush" Color="#1846E1" />
            <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="#2957F5" />
            <SolidColorBrush x:Key="BrandAccentPressedBrush" Color="#1036B8" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#221846E1" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#5C85FF" />

            <!-- WinUI 3 Controls Accent Overrides -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1846E1" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2957F5" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#1036B8" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#401846E1" />
            <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#1846E1" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#1846E1" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocusedPointerOver" Color="#2957F5" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocused" Color="#1846E1" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushFocusedPointerOver" Color="#2957F5" />
            <SolidColorBrush x:Key="ProgressBarPrimaryBrush" Color="#1846E1" />
            <SolidColorBrush x:Key="ProgressRingPrimaryBrush" Color="#1846E1" />

            <!-- ContentDialog Continuous Glass Overrides -->
            <StaticResource x:Key="ContentDialogBackground" ResourceKey="GlassSurfaceBrush" />
            <SolidColorBrush x:Key="ContentDialogCommandsBackground" Color="Transparent" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#1EFFFFFF" />
            <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ContentDialogSmokeFill" Color="#50000000" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackground" Color="#1846E1" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPointerOver" Color="#2957F5" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonBackgroundPressed" Color="#1036B8" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForegroundPointerOver" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogPrimaryButtonForegroundPressed" Color="#FFFFFF" />

            <!-- Semantic Status Brushes (Preserved) -->
            <SolidColorBrush x:Key="StatusHealthyBrush" Color="#34D399" />
            <SolidColorBrush x:Key="StatusWarningBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="#F87171" />
            <SolidColorBrush x:Key="StatusOfflineBrush" Color="#818CA0" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#64748B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
