<ContentDialog
    x:Class="ServerMonitor.App.Views.RestoreConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ServerMonitor.App.ViewModels"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    primitives:SaDialog.Kind="Destructive">
    <!-- UI.10 F21 (+F08): replacing the configuration is irreversible, so this is a destructive confirmation like every other
         one (Figma 11 112:8392): SaDialogStyle, the primary wears SaDestructiveButtonStyle, Enter and the first focus stay on
         the safe Close button (Kind=Destructive = the former DefaultButton="Close"). Warning lines: Alert02 in the attention
         text colour instead of the legacy Segoe E7BA + StatusWarningBrush. -->
    <ContentDialog.Style>
        <StaticResource ResourceKey="SaDialogStyle" />
    </ContentDialog.Style>
    <ScrollViewer
        MaxHeight="420"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MinWidth="400"
            MaxWidth="520"
            Padding="0,0,12,0"
            Spacing="12">
            <TextBlock
                Foreground="{ThemeResource SaTextSecondaryBrush}"
                Text="{x:Bind Confirmation.Intro}"
                TextWrapping="Wrap" />
            <Border
                Padding="12,10,12,2"
                Style="{StaticResource SaInsetTintedSurfaceStyle}">
                <ItemsControl ItemsSource="{x:Bind Confirmation.Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:RestoreConfirmationLine">
                            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <primitives:SaIcon
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Data="{StaticResource SaIconAlert02Data}"
                                    Size="16"
                                    Foreground="{ThemeResource SaAttentionTextBrush}"
                                    Visibility="{x:Bind IsWarning}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{x:Bind Text}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{x:Bind Confirmation.Note}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
