<ContentDialog
    x:Class="ServerMonitor.App.Views.RestoreConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:ServerMonitor.App.ViewModels"
    DefaultButton="Close"
    Style="{StaticResource PremiumContentDialogStyle}">
    <ScrollViewer
        MaxHeight="420"
        VerticalScrollBarVisibility="Auto">
        <StackPanel
            MinWidth="400"
            MaxWidth="520"
            Padding="0,0,12,0"
            Spacing="12">
            <TextBlock
                Foreground="{ThemeResource TextSecondaryBrush}"
                Text="{x:Bind Confirmation.Intro}"
                TextWrapping="Wrap" />
            <Border
                Padding="12,10,12,2"
                Background="{ThemeResource MutedSurfaceBrush}"
                BorderBrush="{ThemeResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusSmall}">
                <ItemsControl ItemsSource="{x:Bind Confirmation.Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:RestoreConfirmationLine">
                            <Grid Margin="0,0,0,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Margin="0,2,0,0"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="14"
                                    Foreground="{ThemeResource StatusWarningBrush}"
                                    Glyph="&#xE7BA;"
                                    Visibility="{x:Bind IsWarning}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="13"
                                    Text="{x:Bind Text}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{x:Bind Confirmation.Note}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
