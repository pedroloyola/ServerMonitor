<ContentDialog
    x:Class="ServerMonitor.App.Views.RestoreOpenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Closing="OnClosing">
    <!-- UI.10 F08 (H03): the Sa dialog shell (SaDialogStyle, pill command buttons) instead of the legacy
         PremiumContentDialogStyle (r8 buttons, accent primary). -->
    <ContentDialog.Style>
        <StaticResource ResourceKey="SaDialogStyle" />
    </ContentDialog.Style>
    <StackPanel
        MinWidth="400"
        MaxWidth="480"
        Spacing="12">
        <TextBlock
            Foreground="{ThemeResource SaTextSecondaryBrush}"
            Text="{x:Bind Session.Message}"
            TextWrapping="Wrap" />
        <PasswordBox
            x:Name="PassphraseBox"
            CornerRadius="{StaticResource RadiusSmall}"
            Header="{x:Bind Session.PassphraseLabel}"
            IsEnabled="{x:Bind Session.IsNotBusy, Mode=OneWay}"
            PasswordChanged="OnPasswordChanged"
            PasswordRevealMode="Peek"
            AutomationProperties.FullDescription="{x:Bind Session.ErrorMessage, Mode=OneWay}" />
        <TextBlock
            primitives:SaAnnounce.Changes="True" AutomationProperties.LiveSetting="Assertive"
            FontSize="12"
            Foreground="{ThemeResource SaDangerTextBrush}"
            Text="{x:Bind Session.ErrorMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind Session.HasError, Mode=OneWay}" />
        <StackPanel
            Spacing="6"
            Visibility="{x:Bind Session.IsBusy, Mode=OneWay}">
            <TextBlock
                primitives:SaAnnounce.Changes="True" AutomationProperties.LiveSetting="Polite"
                FontSize="12"
                Foreground="{ThemeResource SaTextSecondaryBrush}"
                Text="{x:Bind Session.BusyMessage}"
                Visibility="{x:Bind Session.IsBusy, Mode=OneWay}" />
            <!-- UI.11 F17: the indeterminate animation runs only while busy. -->
            <ProgressBar IsIndeterminate="{x:Bind Session.IsBusy, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
