<ContentDialog
    x:Class="ServerMonitor.App.Views.RestoreOpenDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    Style="{StaticResource PremiumContentDialogStyle}"
    PrimaryButtonClick="OnPrimaryButtonClick"
    Closing="OnClosing">
    <StackPanel
        MinWidth="400"
        MaxWidth="480"
        Spacing="12">
        <TextBlock
            Foreground="{ThemeResource TextSecondaryBrush}"
            Text="{x:Bind Session.Message}"
            TextWrapping="Wrap" />
        <PasswordBox
            x:Name="PassphraseBox"
            CornerRadius="{StaticResource RadiusSmall}"
            Header="{x:Bind Session.PassphraseLabel}"
            IsEnabled="{x:Bind Session.IsNotBusy, Mode=OneWay}"
            PasswordChanged="OnPasswordChanged"
            PasswordRevealMode="Peek" />
        <TextBlock
            AutomationProperties.LiveSetting="Assertive"
            FontSize="12"
            Foreground="{ThemeResource StatusCriticalBrush}"
            Text="{x:Bind Session.ErrorMessage, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind Session.HasError, Mode=OneWay}" />
        <StackPanel
            Spacing="6"
            Visibility="{x:Bind Session.IsBusy, Mode=OneWay}">
            <TextBlock
                AutomationProperties.LiveSetting="Polite"
                FontSize="12"
                Foreground="{ThemeResource TextSecondaryBrush}"
                Text="{x:Bind Session.BusyMessage}" />
            <ProgressBar IsIndeterminate="True" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
