<ContentDialog
    x:Class="ServerMonitor.App.Views.RemoveServerDialog"
    x:Uid="RemoveServerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Close">
    <ContentDialog.Style>
        <StaticResource ResourceKey="PremiumContentDialogStyle" />
    </ContentDialog.Style>
    <StackPanel Spacing="8">
        <TextBlock
            x:Uid="RemoveServerDialogMessage"
            Foreground="{ThemeResource TextSecondaryBrush}"
            TextWrapping="Wrap" />
        <TextBlock
            FontWeight="SemiBold"
            Text="{x:Bind ServerName, Mode=OneTime}"
            TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
