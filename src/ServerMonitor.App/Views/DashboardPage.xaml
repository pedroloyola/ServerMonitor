<Page
    x:Class="ServerMonitor.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderGrid" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock
                    x:Uid="DashboardTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    x:Uid="DashboardSubtitle"
                    FontSize="13"
                    Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel
                x:Name="HeaderActions"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="DashboardSettingsButton"
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource SubtleIconButtonStyle}">
                    <SymbolIcon Symbol="Setting" />
                </Button>
                <Button
                    x:Uid="DashboardAddButton"
                    Command="{Binding AddServerCommand}"
                    Style="{StaticResource AccentPillButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Error InfoBar -->
        <InfoBar
            x:Uid="ServerOperationError"
            Grid.Row="1"
            Margin="0,0,0,12"
            IsClosable="True"
            IsOpen="{Binding IsOperationErrorOpen, Mode=TwoWay}"
            Severity="Error" />

        <!-- Empty State Card -->
        <Grid
            Grid.Row="2"
            Height="260"
            VerticalAlignment="Top"
            Visibility="{Binding HasVisibleServers, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
            <controls:GlassCard Height="260" VerticalAlignment="Top">
                <controls:EmptyStateControl
                    x:Uid="DashboardEmptyState"
                    ActionCommand="{Binding AddServerCommand}" />
            </controls:GlassCard>
        </Grid>

        <!-- Servers Scrollable List -->
        <ScrollViewer
            Grid.Row="2"
            Padding="0,0,2,0"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding HasVisibleServers, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding VisibleServers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ServerFullCard />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
