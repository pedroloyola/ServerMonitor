<Page
    x:Class="ServerMonitor.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls">
    <Grid Padding="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid x:Name="HeaderGrid" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock
                    x:Uid="DashboardTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    x:Uid="DashboardSubtitle"
                    FontSize="13"
                    Foreground="{ThemeResource TextSecondaryBrush}" />
            </StackPanel>
            <StackPanel
                x:Name="HeaderActions"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Uid="DashboardCompactModeButton"
                    Command="{x:Bind WindowMode.EnterCompactCommand}"
                    Style="{StaticResource SubtleIconButtonStyle}">
                    <FontIcon FontSize="15" Glyph="&#xE73F;" />
                </Button>
                <Button
                    x:Uid="DashboardSettingsButton"
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource SubtleIconButtonStyle}">
                    <SymbolIcon Symbol="Setting" />
                </Button>
                <Button
                    x:Uid="DashboardAddButton"
                    Command="{Binding AddServerCommand}"
                    Style="{StaticResource AccentPillButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Error InfoBar -->
        <InfoBar
            x:Uid="ServerOperationError"
            Grid.Row="1"
            Margin="0,0,0,12"
            IsClosable="True"
            IsOpen="{Binding IsOperationErrorOpen, Mode=TwoWay}"
            Severity="Error" />

        <!-- Servers + Discovery share one scroll region, so the "Encontrados na rede" section
             renders whether or not any server has been added yet. -->
        <ScrollViewer
            Grid.Row="2"
            Padding="0,0,2,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <!-- Empty State Card (no configured servers yet) -->
                <controls:GlassCard
                    MinHeight="260"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasVisibleServers, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <StackPanel VerticalAlignment="Center" Spacing="18">
                        <controls:EmptyStateControl
                            x:Uid="DashboardEmptyState"
                            ActionCommand="{Binding AddServerCommand}"
                            SecondaryActionCommand="{Binding ImportFromSshCommand}" />

                        <!-- Local network discovery, only while it is really running and has found nothing. -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8"
                            Visibility="{Binding IsSearchingLocalNetwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ProgressRing
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                IsActive="{Binding IsSearchingLocalNetwork}" />
                            <TextBlock
                                x:Uid="DashboardEmptyDiscoverySearching"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Found on the local network: listed right under the empty state, same add/ignore actions. -->
                        <ItemsControl
                            MaxWidth="520"
                            AutomationProperties.LiveSetting="Polite"
                            ItemsSource="{Binding DiscoveredServers}"
                            Visibility="{Binding ShowEmptyStateDiscoveries, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="14,10"
                                        AutomationProperties.Name="{Binding AutomationSummary}"
                                        Background="{ThemeResource MutedSurfaceBrush}"
                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding LocalNetworkHeadline}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                                    Text="{Binding Endpoint}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <Button
                                                    x:Uid="DiscoveredServerAddButton"
                                                    AutomationProperties.Name="{Binding AddAutomationName}"
                                                    Command="{Binding AddCommand}"
                                                    Style="{StaticResource QuietPillButtonStyle}" />
                                                <Button
                                                    Width="36"
                                                    Height="36"
                                                    AutomationProperties.Name="{Binding IgnoreAutomationName}"
                                                    Command="{Binding IgnoreCommand}"
                                                    Style="{StaticResource SubtleIconButtonStyle}"
                                                    ToolTipService.ToolTip="{Binding IgnoreAutomationName}">
                                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </controls:GlassCard>

                <!-- Configured Servers -->
                <ItemsControl
                    x:Name="ServersItemsControl"
                    ItemsSource="{Binding VisibleServers}"
                    Visibility="{Binding HasVisibleServers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:ServerFullCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Encontrados na rede (passive discovery suggestions). With no server yet, the same
                     suggestions are listed inside the empty state above instead (M14.5). -->
                <StackPanel
                    Spacing="10"
                    Visibility="{Binding ShowDiscoverySection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                x:Uid="DashboardDiscoveryTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}"
                                VerticalAlignment="Center" />
                            <!-- Visible count badge; the raw digit is hidden from assistive tech,
                                 which reads the localized count sentence on the pill instead. -->
                            <Border
                                Padding="7,1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding DiscoveredCountAutomationName}"
                                Background="{ThemeResource MutedSurfaceBrush}"
                                BorderBrush="{ThemeResource GlassBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSmall}">
                                <TextBlock
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="11"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="{Binding DiscoveredCount}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Uid="DashboardDiscoveryDescription"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl
                        AutomationProperties.LiveSetting="Polite"
                        ItemsSource="{Binding DiscoveredServers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:DiscoveredServerCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
