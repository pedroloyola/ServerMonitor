<Page x:Name="PageViewport"
    x:Class="ServerMonitor.App.Views.ServerExtensionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- M16: the shell's page around a contributed server page. Only existing pieces, laid out like the Server Detail page
         (Figma 112:1785): the page scroll and padding, the two-level breadcrumb (112:1786, "‹ server" back to that server's
         detail) and the H1 page title. The module's view fills the rest; the shell adds no surface of its own. -->
    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Regular">
                    <VisualState.StateTriggers>
                        <primitives:SaContentWidthTrigger Source="{Binding ElementName=PageViewport}" MinWidth="700" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- < 700: compact padding, as on the Server Detail page. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <primitives:SaContentWidthTrigger Source="{Binding ElementName=PageViewport}" MinWidth="0" MaxWidth="700" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource SaScrollPagePaddingCompact}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer x:Name="PageScroll" Margin="{StaticResource SaPageScrollInset}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PageRoot" Padding="{StaticResource SaScrollPagePadding}" Spacing="{StaticResource SaSpace24}">
                <primitives:SaBreadcrumb
                    x:Name="Breadcrumb"
                    ParentInvoked="OnBreadcrumbParentInvoked" />

                <primitives:SaHeadingHost AutomationProperties.HeadingLevel="Level1" IsTabStop="False">
                    <TextBlock
                        x:Name="PageTitle"
                        AutomationProperties.AccessibilityView="Raw" IsTextSelectionEnabled="False" IsTabStop="False"
                        Style="{StaticResource SaPageTitleTextStyle}"
                        TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </primitives:SaHeadingHost>

                <!-- The module's view, placed in code-behind (one per visit). -->
                <Grid x:Name="ModuleContent" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
