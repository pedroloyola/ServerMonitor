<Page
    x:Class="ServerMonitor.App.Views.SettingsDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls">
    <!-- UI.5 §4: "Dados e servidores", the second Settings sub-page. B1 moves the existing sections here unchanged
         (hidden servers, ignored devices, history, backup/restore, about); the Figma pass is B2. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="{StaticResource PagePadding}"
            Spacing="20">
            <!-- Header -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="SettingsDataBackButton"
                    VerticalAlignment="Center"
                    Command="{Binding BackToGeneralCommand}"
                    Style="{StaticResource SubtleIconButtonStyle}">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <TextBlock
                    x:Uid="SettingsDataTitle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
            </Grid>

            <!-- A configuration write was refused because a restore holds the configuration (M14.6). -->
            <InfoBar
                IsClosable="True"
                IsOpen="{Binding IsConfigurationLockedOpen, Mode=TwoWay}"
                Message="{Binding ConfigurationLockedMessage}"
                Severity="Warning" />

            <controls:GlassCard>
                <StackPanel Spacing="20">
                    <!-- Hidden Servers Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsHiddenServersTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsHiddenServersDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            x:Uid="ServerOperationError"
                            IsClosable="True"
                            IsOpen="{Binding IsServerOperationErrorOpen, Mode=TwoWay}"
                            Severity="Error" />

                        <TextBlock
                            x:Uid="SettingsHiddenServersEmpty"
                            FontSize="12"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Visibility="{Binding HasHiddenServers, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                        <ItemsControl
                            ItemsSource="{Binding HiddenServers}"
                            Visibility="{Binding HasHiddenServers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="{ThemeResource MutedSurfaceBrush}"
                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource MutedSurfaceBrush}"
                                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusSmall}"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                                            Text="{Binding OperatingSystemDisplayName}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextTertiaryBrush}"
                                                    FontSize="12"
                                                    Text="{Binding Endpoint}" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="HiddenServerRestoreButton"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding RestoreAutomationName}"
                                                Command="{Binding RestoreCommand}"
                                                Style="{StaticResource QuietPillButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Ignored Discoveries Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsIgnoredDiscoveriesTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsIgnoredDiscoveriesDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Uid="SettingsResetIgnoredButton"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetIgnoredCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <InfoBar
                            x:Uid="SettingsResetIgnoredSuccess"
                            IsClosable="True"
                            IsOpen="{Binding IsResetIgnoredSuccessOpen, Mode=TwoWay}"
                            Severity="Success" />
                        <InfoBar
                            x:Uid="SettingsResetIgnoredError"
                            IsClosable="True"
                            IsOpen="{Binding IsResetIgnoredErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- History Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsHistoryTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsHistoryDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Uid="SettingsClearHistoryButton"
                            HorizontalAlignment="Left"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <Button
                            x:Uid="SettingsResetHistoryButton"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetHistoryCommand}"
                            Style="{StaticResource QuietPillButtonStyle}"
                            Visibility="{Binding IsHistoryResetAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <InfoBar
                            x:Uid="SettingsHistoryClearedSuccess"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryClearedOpen, Mode=TwoWay}"
                            Severity="Success" />
                        <InfoBar
                            x:Uid="SettingsHistoryClearError"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryClearErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                        <InfoBar
                            x:Uid="SettingsHistoryResetSuccess"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryResetOpen, Mode=TwoWay}"
                            Severity="Success" />
                        <InfoBar
                            x:Uid="SettingsHistoryResetError"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryResetErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Backup and restore Section (M14.6). One status surface for both flows; its
                         detail line is selectable so the stuck-journal folder can be copied. -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="BackupSectionTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="BackupSectionDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Uid="BackupCreateButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind Backup.CreateBackupCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <Button
                            x:Uid="BackupRestoreButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind Backup.RestoreCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <InfoBar
                            x:Name="BackupStatusBar"
                            Title="{x:Bind Backup.StatusTitle, Mode=OneWay}"
                            IsClosable="{x:Bind Backup.IsStatusClosable, Mode=OneWay}"
                            IsOpen="{x:Bind Backup.IsStatusOpen, Mode=TwoWay}"
                            Message="{x:Bind Backup.StatusMessage, Mode=OneWay}"
                            Severity="{x:Bind Backup.StatusSeverity, Mode=OneWay}">
                            <TextBlock
                                Margin="0,0,0,12"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{x:Bind Backup.StatusDetail, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind Backup.HasStatusDetail, Mode=OneWay}" />
                        </InfoBar>
                    </StackPanel>
                </StackPanel>
            </controls:GlassCard>

            <!-- About (H-UI5-4: the "Sobre" disclosure in General lands here and brings it into view). -->
            <controls:GlassCard x:Name="AboutSection">
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="SettingsAboutTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        x:Uid="SettingsAboutAppName"
                        FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Uid="SettingsAboutVersionLabel"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{Binding AppVersion}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="SettingsAboutLicense"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        x:Uid="SettingsAboutGitHub"
                        Padding="0"
                        NavigateUri="https://github.com/pedroloyola/ServerMonitor" />
                </StackPanel>
            </controls:GlassCard>
        </StackPanel>
    </ScrollViewer>
</Page>
