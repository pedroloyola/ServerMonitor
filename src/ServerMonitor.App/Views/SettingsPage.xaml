<Page
    x:Class="ServerMonitor.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="{StaticResource PagePadding}"
            Spacing="20">
            <!-- Header -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="SettingsBackButton"
                    VerticalAlignment="Center"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource SubtleIconButtonStyle}">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="SettingsTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock
                        x:Uid="SettingsSubtitle"
                        FontSize="13"
                        Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Main Glass Settings Card -->
            <controls:GlassCard>
                <StackPanel Spacing="20">
                    <!-- Appearance Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsAppearanceTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsAppearanceDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Uid="SettingsThemePicker"
                            HorizontalAlignment="Stretch"
                            MaxWidth="400"
                            CornerRadius="{StaticResource RadiusSmall}"
                            SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="ThemeSystemOption" />
                            <ComboBoxItem x:Uid="ThemeLightOption" />
                            <ComboBoxItem x:Uid="ThemeDarkOption" />
                        </ComboBox>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Language Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsLanguageTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsLanguageDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Uid="SettingsLanguagePicker"
                            HorizontalAlignment="Stretch"
                            MaxWidth="400"
                            CornerRadius="{StaticResource RadiusSmall}"
                            SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="LanguageSystemOption" />
                            <ComboBoxItem x:Uid="LanguageBrazilianPortugueseOption" />
                            <ComboBoxItem x:Uid="LanguageEuropeanPortugueseOption" />
                            <ComboBoxItem x:Uid="LanguageEnglishOption" />
                        </ComboBox>
                        <InfoBar
                            x:Uid="SettingsRestartNotice"
                            IsClosable="True"
                            IsOpen="{Binding IsRestartNoticeOpen, Mode=TwoWay}"
                            Severity="Informational" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Background Section. The durable explanation of the background lifecycle: the
                         one-time toast is a courtesy that may never arrive (notifications can be off),
                         so this is what the user can always come back to (M13 S2 D.1). -->
                    <StackPanel x:Name="BackgroundSection" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsBackgroundTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsBackgroundDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Uid="SettingsBackgroundToggle"
                            HorizontalAlignment="Left"
                            MinHeight="36"
                            IsOn="{Binding BackgroundMonitoringEnabled, Mode=TwoWay}" />

                        <!-- Only visible when this session has no notification-area icon. The window is
                             surfaced without the user asking in that case, so it must say why. -->
                        <InfoBar
                            x:Uid="BackgroundDegradedNotice"
                            IsClosable="True"
                            IsOpen="{Binding IsBackgroundDegradedNoticeOpen, Mode=TwoWay}"
                            Severity="Warning" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Health Notifications Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsNotificationsTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsNotificationsDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Uid="SettingsNotificationsToggle"
                            HorizontalAlignment="Left"
                            MinHeight="36"
                            IsOn="{Binding NotificationsEnabled, Mode=TwoWay}" />

                        <InfoBar
                            x:Uid="SettingsNotificationsSaveError"
                            IsClosable="True"
                            IsOpen="{Binding IsNotificationSettingsErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Compact Mode Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsCompactTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsCompactDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Uid="SettingsEnterCompactButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind WindowMode.EnterCompactCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <ToggleSwitch
                            x:Uid="SettingsAlwaysOnTopToggle"
                            HorizontalAlignment="Left"
                            MinHeight="36"
                            IsOn="{x:Bind WindowMode.CompactAlwaysOnTop, Mode=TwoWay}" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Hidden Servers Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsHiddenServersTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsHiddenServersDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <InfoBar
                            x:Uid="ServerOperationError"
                            IsClosable="True"
                            IsOpen="{Binding IsServerOperationErrorOpen, Mode=TwoWay}"
                            Severity="Error" />

                        <TextBlock
                            x:Uid="SettingsHiddenServersEmpty"
                            FontSize="12"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Visibility="{Binding HasHiddenServers, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />

                        <ItemsControl
                            ItemsSource="{Binding HiddenServers}"
                            Visibility="{Binding HasHiddenServers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="{ThemeResource MutedSurfaceBrush}"
                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                                                    <Border
                                                        Padding="6,2"
                                                        Background="{ThemeResource MutedSurfaceBrush}"
                                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusSmall}"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="10"
                                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                                            Text="{Binding OperatingSystemDisplayName}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock
                                                    Foreground="{ThemeResource TextTertiaryBrush}"
                                                    FontSize="12"
                                                    Text="{Binding Endpoint}" />
                                            </StackPanel>
                                            <Button
                                                x:Uid="HiddenServerRestoreButton"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{Binding RestoreAutomationName}"
                                                Command="{Binding RestoreCommand}"
                                                Style="{StaticResource QuietPillButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Ignored Discoveries Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsIgnoredDiscoveriesTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsIgnoredDiscoveriesDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Uid="SettingsResetIgnoredButton"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetIgnoredCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <InfoBar
                            x:Uid="SettingsResetIgnoredSuccess"
                            IsClosable="True"
                            IsOpen="{Binding IsResetIgnoredSuccessOpen, Mode=TwoWay}"
                            Severity="Success" />
                        <InfoBar
                            x:Uid="SettingsResetIgnoredError"
                            IsClosable="True"
                            IsOpen="{Binding IsResetIgnoredErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- History Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsHistoryTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsHistoryDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Uid="SettingsClearHistoryButton"
                            HorizontalAlignment="Left"
                            Command="{Binding ClearHistoryCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <Button
                            x:Uid="SettingsResetHistoryButton"
                            HorizontalAlignment="Left"
                            Command="{Binding ResetHistoryCommand}"
                            Style="{StaticResource QuietPillButtonStyle}"
                            Visibility="{Binding IsHistoryResetAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <InfoBar
                            x:Uid="SettingsHistoryClearedSuccess"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryClearedOpen, Mode=TwoWay}"
                            Severity="Success" />
                        <InfoBar
                            x:Uid="SettingsHistoryClearError"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryClearErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                        <InfoBar
                            x:Uid="SettingsHistoryResetSuccess"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryResetOpen, Mode=TwoWay}"
                            Severity="Success" />
                        <InfoBar
                            x:Uid="SettingsHistoryResetError"
                            IsClosable="True"
                            IsOpen="{Binding IsHistoryResetErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                    </StackPanel>
                </StackPanel>
            </controls:GlassCard>

            <!-- About -->
            <controls:GlassCard>
                <StackPanel Spacing="6">
                    <TextBlock
                        x:Uid="SettingsAboutTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock
                        x:Uid="SettingsAboutAppName"
                        FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock
                            x:Uid="SettingsAboutVersionLabel"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{Binding AppVersion}" />
                    </StackPanel>
                    <TextBlock
                        x:Uid="SettingsAboutLicense"
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        x:Uid="SettingsAboutGitHub"
                        Padding="0"
                        NavigateUri="https://github.com/pedroloyola/ServerMonitor" />
                </StackPanel>
            </controls:GlassCard>

            <!-- Bottom Caption -->
            <TextBlock
                x:Uid="SettingsMilestoneCaption"
                Foreground="{ThemeResource TextTertiaryBrush}"
                FontSize="11"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
