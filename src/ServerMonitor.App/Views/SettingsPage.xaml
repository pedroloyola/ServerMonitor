<Page
    x:Class="ServerMonitor.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel
            Padding="{StaticResource PagePadding}"
            Spacing="20">
            <!-- Header -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="SettingsBackButton"
                    VerticalAlignment="Center"
                    Command="{Binding BackCommand}"
                    Style="{StaticResource SubtleIconButtonStyle}">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock
                        x:Uid="SettingsTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource PageTitleTextStyle}" />
                    <TextBlock
                        x:Uid="SettingsSubtitle"
                        FontSize="13"
                        Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- A configuration write was refused because a restore holds the configuration (M14.6). -->
            <InfoBar
                IsClosable="True"
                IsOpen="{Binding IsConfigurationLockedOpen, Mode=TwoWay}"
                Message="{Binding ConfigurationLockedMessage}"
                Severity="Warning" />

            <!-- Main Glass Settings Card -->
            <controls:GlassCard>
                <StackPanel Spacing="20">
                    <!-- Appearance Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsAppearanceTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsAppearanceDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Uid="SettingsThemePicker"
                            HorizontalAlignment="Stretch"
                            MaxWidth="400"
                            CornerRadius="{StaticResource RadiusSmall}"
                            SelectedIndex="{Binding SelectedThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="ThemeSystemOption" />
                            <ComboBoxItem x:Uid="ThemeLightOption" />
                            <ComboBoxItem x:Uid="ThemeDarkOption" />
                        </ComboBox>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Language Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsLanguageTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsLanguageDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            x:Uid="SettingsLanguagePicker"
                            HorizontalAlignment="Stretch"
                            MaxWidth="400"
                            CornerRadius="{StaticResource RadiusSmall}"
                            SelectedIndex="{Binding SelectedLanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem x:Uid="LanguageSystemOption" />
                            <ComboBoxItem x:Uid="LanguageBrazilianPortugueseOption" />
                            <ComboBoxItem x:Uid="LanguageEuropeanPortugueseOption" />
                            <ComboBoxItem x:Uid="LanguageEnglishOption" />
                        </ComboBox>
                        <InfoBar
                            x:Uid="SettingsRestartNotice"
                            IsClosable="True"
                            IsOpen="{Binding IsRestartNoticeOpen, Mode=TwoWay}"
                            Severity="Informational" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Background Section. The durable explanation of the background lifecycle: the
                         one-time toast is a courtesy that may never arrive (notifications can be off),
                         so this is what the user can always come back to (M13 S2 D.1). -->
                    <StackPanel x:Name="BackgroundSection" Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsBackgroundTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsBackgroundDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Uid="SettingsBackgroundToggle"
                            HorizontalAlignment="Left"
                            MinHeight="36"
                            IsOn="{Binding BackgroundMonitoringEnabled, Mode=TwoWay}" />

                        <!-- STATE, not event: a short caption that survives closing the InfoBar, so the
                             answer is still there when the user comes back asking why X quits the app.
                             The toggle above stays enabled and keeps the persisted value: the preference
                             did not change, it just has no effect this session. -->
                        <TextBlock
                            x:Uid="SettingsBackgroundDegradedCaption"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="{Binding IsBackgroundDegraded, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- EVENT: the same closable warning for both moments — the icon failing at
                             startup and the icon being lost later. The user needs the same understanding
                             and the same action in both, so there is one text, not two. -->
                        <InfoBar
                            x:Uid="BackgroundDegradedNotice"
                            IsClosable="True"
                            IsOpen="{Binding IsBackgroundDegradedNoticeOpen, Mode=TwoWay}"
                            Severity="Warning" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Health Notifications Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsNotificationsTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsNotificationsDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch
                            x:Uid="SettingsNotificationsToggle"
                            HorizontalAlignment="Left"
                            MinHeight="36"
                            IsOn="{Binding NotificationsEnabled, Mode=TwoWay}" />

                        <InfoBar
                            x:Uid="SettingsNotificationsSaveError"
                            IsClosable="True"
                            IsOpen="{Binding IsNotificationSettingsErrorOpen, Mode=TwoWay}"
                            Severity="Error" />
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource GlassBorderBrush}" />

                    <!-- Compact Mode Section -->
                    <StackPanel Spacing="10">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Uid="SettingsCompactTitle"
                                AutomationProperties.HeadingLevel="Level2"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                x:Uid="SettingsCompactDescription"
                                FontSize="12"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Uid="SettingsEnterCompactButton"
                            HorizontalAlignment="Left"
                            Command="{x:Bind WindowMode.EnterCompactCommand}"
                            Style="{StaticResource QuietPillButtonStyle}" />

                        <ToggleSwitch
                            x:Uid="SettingsAlwaysOnTopToggle"
                            HorizontalAlignment="Left"
                            MinHeight="36"
                            IsOn="{x:Bind WindowMode.CompactAlwaysOnTop, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </controls:GlassCard>

            <!-- UI.5 Cortex 2 / H-UI5-4: the other sub-page, reached by an in-page link until UI.6's sidebar. B1 keeps this
                 minimal; the Figma disclosure rows come in B2. -->
            <controls:GlassCard>
                <StackPanel Spacing="10">
                    <Button
                        x:Uid="SettingsOpenDataButton"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenDataCommand}"
                        Style="{StaticResource QuietPillButtonStyle}" />
                    <Button
                        x:Uid="SettingsOpenAboutButton"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenAboutCommand}"
                        Style="{StaticResource QuietPillButtonStyle}" />
                </StackPanel>
            </controls:GlassCard>

            <!-- Bottom Caption -->
            <TextBlock
                x:Uid="SettingsMilestoneCaption"
                Foreground="{ThemeResource TextTertiaryBrush}"
                FontSize="11"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
