<ContentDialog
    x:Class="ServerMonitor.App.Views.SshConfigImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:viewModels="using:ServerMonitor.App.ViewModels">
    <!-- UI.7B (B-11): "Importar de SSH" - Figma 04 dialog chrome (112:4049 / 112:4250, G-14 unified on SaDialogStyle and its
         buttons) with the state content of 07 (no file, unreadable, no profiles, profiles with blocked ones). Read-only:
         the list and every classification come from the existing resolver through the view model; a BLOCKED profile is
         listed with its reason and can never be used (no "fix" anywhere). "Usar perfil" fills only empty fields (Add only).
         Closing cancels a load still running. HOOK (7C, H-UI7-2): "Já adicionado" needs the duplicate rule - not faked. -->
    <ContentDialog.Style>
        <StaticResource ResourceKey="SaDialogStyle" />
    </ContentDialog.Style>
    <StackPanel MaxWidth="664" Spacing="{StaticResource SaSpace16}">
        <TextBlock x:Uid="ServerEditorImportSubtitle" Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap" />
        <Border Style="{StaticResource SaInsetTintedSurfaceStyle}" MinHeight="38">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <primitives:SaIcon Data="{StaticResource SaIconFolder01Data}" Size="18" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SaTextSecondaryBrush}" />
                <TextBlock x:Uid="ServerEditorImportSource" Style="{StaticResource SaControlTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Loading (G-28): the read is running; Cancelar stops it. -->
        <StackPanel x:Name="LoadingRow" Orientation="Horizontal" Spacing="10" Visibility="Collapsed">
            <ProgressRing x:Name="LoadingRing" Width="18" Height="18" IsActive="False" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Uid="ServerEditorImportLoading" Style="{StaticResource SaCaptionTextStyle}" VerticalAlignment="Center"
                       Foreground="{ThemeResource SaTextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- 07 states: no file / unreadable / no profiles. The body is the view model's own message. -->
        <StackPanel x:Name="StatePanel" Spacing="10" HorizontalAlignment="Center" Visibility="Collapsed">
            <Border Width="44" Height="44" CornerRadius="{StaticResource SaRadiusPill}" HorizontalAlignment="Center" Style="{StaticResource SaInsetTintedSurfaceStyle}">
                <primitives:SaIcon x:Name="StateIcon" Size="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{ThemeResource SaTextSecondaryBrush}" />
            </Border>
            <TextBlock x:Name="StateTitle" Style="{StaticResource SaTitleCompactTextStyle}" HorizontalAlignment="Center"
                       HorizontalTextAlignment="Center" TextWrapping="Wrap" AutomationProperties.HeadingLevel="Level2" />
            <TextBlock x:Name="StateBody" Style="{StaticResource SaSecondaryBodyTextStyle}" HorizontalAlignment="Center"
                       HorizontalTextAlignment="Center" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                       AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Profiles: "N disponíveis · M bloqueados", then the list (the resolver caps it at 500; virtualized). -->
        <StackPanel x:Name="ListPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="CountText" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                       AutomationProperties.LiveSetting="Polite" />
            <ListView
                x:Name="HostList"
                x:Uid="ServerEditorImportList"
                MaxHeight="320"
                SelectionMode="Single"
                IsItemClickEnabled="False"
                ContainerContentChanging="OnHostContainerContentChanging"
                SelectionChanged="OnHostSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:SshConfigHostOptionViewModel">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Alias}" Style="{StaticResource SaBodyTextStyle}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Preview}" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="{x:Bind HasPreview}" />
                                <TextBlock Text="{x:Bind RequirementText}" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaDangerTextBrush}"
                                           TextWrapping="Wrap" Visibility="{x:Bind HasRequirement}" />
                                <TextBlock Text="{x:Bind ClassificationText}" Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                           TextWrapping="Wrap" Visibility="{x:Bind HasClassification}" />
                            </StackPanel>
                            <!-- The state is written out (not colour only): Disponível / Bloqueado. -->
                            <Grid Grid.Column="1" VerticalAlignment="Top" AutomationProperties.AccessibilityView="Raw">
                                <TextBlock x:Uid="ServerEditorImportAvailable" Style="{StaticResource SaCaptionTextStyle}"
                                           Foreground="{ThemeResource SaTextSecondaryBrush}" Visibility="{x:Bind IsImportable}" />
                                <TextBlock x:Uid="ServerEditorImportBlocked" Style="{StaticResource SaCaptionTextStyle}"
                                           Foreground="{ThemeResource SaDangerTextBrush}" Visibility="{x:Bind IsBlocked}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <TextBlock x:Name="WarningText" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock x:Uid="ServerEditorImportNote" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
