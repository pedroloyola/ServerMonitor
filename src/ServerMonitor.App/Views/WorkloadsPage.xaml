<Page
    x:Class="ServerMonitor.App.Views.WorkloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ServerMonitor.App.Converters"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:vm="using:ServerMonitor.App.ViewModels">
    <!-- UI.3 Serviços e containers, Figma 05 · 03: 112:2547 (Dark) / 112:2762 (Light), problems 112:2978 / 112:3113;
         states 112:14847 (nothing) / 112:15068 (unavailable) / 112:15289 (no results) / 112:16553 (loading).
         READ-ONLY (M11): no start/stop/restart anywhere. -->
    <Page.Resources>
        <converters:IndexToBooleanConverter x:Key="IndexToBooleanConverter" />
        <converters:WorkloadSeverityToStatusKindConverter x:Key="WorkloadSeverityToStatusKindConverter" />
        <converters:WorkloadSeverityToSaTextStyleConverter x:Key="WorkloadSeverityToSaTextStyleConverter" />

        <!-- Container row 112:2650 / problem 112:2666: dot 6 · name 13 Medium + image 11 muted (w250) · state 12 Medium +
             health 11 right-aligned; no dividers; h64 (SaDataTableCompactRowStyle). -->
        <DataTemplate x:Key="ContainerRowTemplate" x:DataType="vm:ContainerRowViewModel">
            <primitives:SaDataTableRow AutomationProperties.Name="{x:Bind DisplayAutomationName}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <primitives:SaStatusIndicator
                        Style="{StaticResource SaStatusDotOnlyStyle}"
                        VerticalAlignment="Center"
                        Status="{x:Bind Severity, Converter={StaticResource WorkloadSeverityToStatusKindConverter}}"
                        Label="{x:Bind StateText}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource SaControlTextStyle}" Foreground="{ThemeResource SaTextBrush}"
                                   Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource SaWorkloadDetailTextStyle}"
                                   Text="{x:Bind Image}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                        <TextBlock AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Right"
                                   Style="{x:Bind Severity, Converter={StaticResource WorkloadSeverityToSaTextStyleConverter}}"
                                   Text="{x:Bind StateText}" />
                        <TextBlock AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Right"
                                   Style="{x:Bind Severity, Converter={StaticResource WorkloadSeverityToSaTextStyleConverter}, ConverterParameter=Detail}"
                                   Text="{x:Bind HealthDisplay}" />
                    </StackPanel>
                </Grid>
            </primitives:SaDataTableRow>
        </DataTemplate>

        <!-- Service row 112:2708 / problem 112:2740 / static 112:2748: name + description · state + startup (D-UI3-6). -->
        <DataTemplate x:Key="ServiceRowTemplate" x:DataType="vm:ServiceRowViewModel">
            <primitives:SaDataTableRow AutomationProperties.Name="{x:Bind DisplayAutomationName}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <primitives:SaStatusIndicator
                        Style="{StaticResource SaStatusDotOnlyStyle}"
                        VerticalAlignment="Center"
                        Status="{x:Bind Severity, Converter={StaticResource WorkloadSeverityToStatusKindConverter}}"
                        Label="{x:Bind StateDisplay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource SaControlTextStyle}" Foreground="{ThemeResource SaTextBrush}"
                                   Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        <TextBlock AutomationProperties.AccessibilityView="Raw" Style="{StaticResource SaWorkloadDetailTextStyle}"
                                   Text="{x:Bind Description}" TextTrimming="CharacterEllipsis" MaxLines="1"
                                   Visibility="{x:Bind HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="4">
                        <TextBlock AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Right"
                                   Style="{x:Bind Severity, Converter={StaticResource WorkloadSeverityToSaTextStyleConverter}}"
                                   Text="{x:Bind StateDisplay}" />
                        <TextBlock AutomationProperties.AccessibilityView="Raw" HorizontalAlignment="Right"
                                   Style="{x:Bind Severity, Converter={StaticResource WorkloadSeverityToSaTextStyleConverter}, ConverterParameter=Detail}"
                                   Text="{x:Bind StartupDisplay}" />
                    </StackPanel>
                </Grid>
            </primitives:SaDataTableRow>
        </DataTemplate>
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="{StaticResource SaPagePadding}" RowSpacing="{StaticResource SaSpace20}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- < 900: the cards stack (Containers above Services) and the filter goes under the search. -->
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="FilterTrack.(Grid.Row)" Value="1" />
                        <Setter Target="FilterTrack.(Grid.Column)" Value="0" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="SearchBox.MaxWidth" Value="400" />
                        <Setter Target="SearchBox.Width" Value="NaN" />
                        <Setter Target="SearchBox.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ServicesCard.(Grid.Row)" Value="1" />
                        <Setter Target="ServicesCard.(Grid.Column)" Value="0" />
                        <Setter Target="CardsColumn2.Width" Value="0" />
                        <Setter Target="CardsRow2.Height" Value="*" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource SaPagePaddingCompact}" />
                        <Setter Target="FilterTrack.(Grid.Row)" Value="1" />
                        <Setter Target="FilterTrack.(Grid.Column)" Value="0" />
                        <Setter Target="SearchBox.Width" Value="NaN" />
                        <Setter Target="SearchBox.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="SearchBox.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ServicesCard.(Grid.Row)" Value="1" />
                        <Setter Target="ServicesCard.(Grid.Column)" Value="0" />
                        <Setter Target="CardsColumn2.Width" Value="0" />
                        <Setter Target="CardsRow2.Height" Value="*" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Breadcrumb 112:2614: server -> Dashboard until the server Detail exists (D-UI3-5). -->
        <primitives:SaBreadcrumb
            x:Name="Breadcrumb"
            x:Uid="WorkloadsBreadcrumb"
            ParentText="{Binding Title}"
            ParentInvoked="OnBreadcrumbParentInvoked" />

        <!-- Header 112:2619: title 32 Semibold + context 13 muted, Atualizar 134x42 on the right. -->
        <Grid Grid.Row="1" ColumnSpacing="{StaticResource SaSpace20}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock
                    x:Uid="WorkloadsPageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource SaPageTitleTextStyle}"
                    Foreground="{ThemeResource SaTextBrush}" />
                <TextBlock
                    Style="{StaticResource SaPageSubtitleTextStyle}"
                    Text="{Binding ContextDisplay}"
                    TextWrapping="Wrap"
                    AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Top"
                Style="{StaticResource SaSecondaryRectButtonStyle}"
                Command="{Binding RefreshCommand}"
                AutomationProperties.Name="{Binding RefreshAutomationName}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SaSpace8}">
                    <Grid>
                        <primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="18"
                                           Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        <ProgressRing Width="16" Height="16" IsActive="{Binding IsRefreshing}"
                                      Visibility="{Binding IsRefreshing, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                    <TextBlock x:Uid="WorkloadRefreshLabel" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search 112:2628 (400x44) + global filter 112:2634 ("Todos · N" / "Com problemas · N", D-UI3-3). -->
        <Grid Grid.Row="2" ColumnSpacing="{StaticResource SaSpace20}" RowSpacing="{StaticResource SaSpace12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="SearchBox"
                x:Uid="WorkloadSearchAll"
                Width="400"
                Style="{StaticResource SaPageSearchFieldStyle}"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Border x:Name="FilterTrack" Grid.Column="2" Style="{StaticResource SaSegmentedRectTrackStyle}">
                <StackPanel
                    x:Uid="WorkloadGlobalFilter"
                    Orientation="Horizontal"
                    Spacing="4"
                    primitives:SaGroupNavigation.Mode="SelectionFollowsFocus">
                    <RadioButton GroupName="WorkloadGlobalFilter" MinWidth="124" Style="{StaticResource SaSegmentedRectFilterItemStyle}"
                                 Content="{Binding FilterAllLabel}"
                                 IsChecked="{Binding GlobalFilterIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                    <RadioButton GroupName="WorkloadGlobalFilter" MinWidth="124" Style="{StaticResource SaSegmentedRectFilterItemStyle}"
                                 Content="{Binding FilterProblemsLabel}"
                                 IsChecked="{Binding GlobalFilterIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Content: one page-level panel OR the two section cards. -->
        <Grid Grid.Row="3">
            <!-- Loading 112:16645: solid panel, "A carregar…" + five row skeletons (tile 40, two bars, three pills). -->
            <Border Style="{StaticResource SaStatePanelStyle}"
                    Visibility="{Binding ShowPageLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SaSpace24}">
                        <TextBlock x:Uid="WorkloadLoadingPanel" Style="{StaticResource SaBodyTextStyle}" Foreground="{ThemeResource SaTextBrush}" />
                        <Grid ColumnSpacing="{StaticResource SaSpace16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <primitives:SaSkeleton Width="40" Height="40" />
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><primitives:SaSkeleton Width="180" Height="12" HorizontalAlignment="Left" /><primitives:SaSkeleton Width="120" Height="10" HorizontalAlignment="Left" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /></StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource SaSpace16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <primitives:SaSkeleton Width="40" Height="40" />
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><primitives:SaSkeleton Width="180" Height="12" HorizontalAlignment="Left" /><primitives:SaSkeleton Width="120" Height="10" HorizontalAlignment="Left" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /></StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource SaSpace16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <primitives:SaSkeleton Width="40" Height="40" />
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><primitives:SaSkeleton Width="180" Height="12" HorizontalAlignment="Left" /><primitives:SaSkeleton Width="120" Height="10" HorizontalAlignment="Left" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /></StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource SaSpace16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <primitives:SaSkeleton Width="40" Height="40" />
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><primitives:SaSkeleton Width="180" Height="12" HorizontalAlignment="Left" /><primitives:SaSkeleton Width="120" Height="10" HorizontalAlignment="Left" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /></StackPanel>
                        </Grid>
                        <Grid ColumnSpacing="{StaticResource SaSpace16}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <primitives:SaSkeleton Width="40" Height="40" />
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center"><primitives:SaSkeleton Width="180" Height="12" HorizontalAlignment="Left" /><primitives:SaSkeleton Width="120" Height="10" HorizontalAlignment="Left" /></StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /><primitives:SaSkeleton Width="72" Height="16" /></StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Unavailable 112:15160: both sections failed to be read. -->
            <Border Style="{StaticResource SaStatePanelStyle}"
                    Visibility="{Binding ShowAllUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
                    <primitives:SaEmptyState x:Uid="WorkloadUnavailableState" VerticalAlignment="Center" IconData="{StaticResource SaIconServerStack01Data}">
                        <Button x:Uid="WorkloadRetryButton" Width="200" HorizontalAlignment="Center" Style="{StaticResource SaSolidButtonStyle}" Command="{Binding RefreshCommand}" />
                    </primitives:SaEmptyState>
                </ScrollViewer>
            </Border>

            <!-- Nothing 112:14939: both reads succeeded and found nothing. -->
            <Border Style="{StaticResource SaStatePanelStyle}"
                    Visibility="{Binding ShowNothingToShow, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
                    <primitives:SaEmptyState x:Uid="WorkloadNothingState" VerticalAlignment="Center" IconData="{StaticResource SaIconServerStack01Data}">
                        <Button x:Uid="WorkloadNothingRefreshButton" Width="200" HorizontalAlignment="Center" Style="{StaticResource SaSolidButtonStyle}" Command="{Binding RefreshCommand}" />
                    </primitives:SaEmptyState>
                </ScrollViewer>
            </Border>

            <!-- No results 112:15381: the query hid every row in both lists. -->
            <Border Style="{StaticResource SaStatePanelStyle}"
                    Visibility="{Binding ShowGlobalNoResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
                    <primitives:SaEmptyState x:Uid="WorkloadNoResultsState" VerticalAlignment="Center" IconData="{StaticResource SaIconSearch01Data}"
                                             Title="{Binding NoResultsTitle}">
                        <Button x:Uid="WorkloadClearSearchButton" Width="200" HorizontalAlignment="Center" Style="{StaticResource SaSolidButtonStyle}" Command="{Binding ClearSearchCommand}" />
                    </primitives:SaEmptyState>
                </ScrollViewer>
            </Border>

            <!-- Cards 112:2640 / 112:2698: two glass columns 508 + gap 24. -->
            <Grid
                ColumnSpacing="{StaticResource SaSpace24}"
                RowSpacing="{StaticResource SaSpace24}"
                Visibility="{Binding ShowSectionCards, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CardsColumn2" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="CardsRow2" Height="0" />
                </Grid.RowDefinitions>

                <!-- Containers -->
                <Border Style="{StaticResource SaGlassSurfaceStyle}">
                    <Grid RowSpacing="{StaticResource SaSpace4}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Uid="WorkloadDockerSectionTitle" AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource SaSectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SaStatusBadgeTextStyle}"
                                       Text="{Binding DockerProblemBadge}"
                                       Visibility="{Binding HasDockerProblems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                   Text="{Binding DockerLifecycleSummary}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowDockerContainers, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource SaDataTableHeaderStyle}"
                                Visibility="{Binding ShowDockerContainers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="WorkloadContainerColumnName" Grid.Column="1" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="WorkloadContainerColumnState" Grid.Column="2" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding ShowDockerContainers, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsRepeater x:Uid="WorkloadContainersList" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled" ItemsSource="{Binding Containers}" ItemTemplate="{StaticResource ContainerRowTemplate}" />
                            </ScrollViewer>
                            <TextBlock x:Uid="WorkloadDockerNoResults" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                       Visibility="{Binding ShowDockerSectionNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <!-- Independent section states (§38): compact empty state inside the card. -->
                            <primitives:SaEmptyState x:Uid="WorkloadDockerNotInstalledState" VerticalAlignment="Center" IconData="{StaticResource SaIconServerStack01Data}"
                                                     Visibility="{Binding ShowDockerNotInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadDockerPermissionState" VerticalAlignment="Center" IconData="{StaticResource SaIconLockPasswordData}"
                                                     Visibility="{Binding ShowDockerPermissionDenied, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadDockerUnavailableState" VerticalAlignment="Center" IconData="{StaticResource SaIconAlert02Data}"
                                                     Visibility="{Binding ShowDockerUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadDockerErrorState" VerticalAlignment="Center" IconData="{StaticResource SaIconAlert02Data}"
                                                     Visibility="{Binding ShowDockerError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadDockerEmptyState" VerticalAlignment="Center" IconData="{StaticResource SaIconServerStack01Data}"
                                                     Visibility="{Binding ShowDockerEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <primitives:SaInlineNotice Grid.Row="4" x:Uid="WorkloadTruncatedDocker" Severity="Info"
                                                   Visibility="{Binding ShowDockerTruncatedNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>

                <!-- Services -->
                <Border x:Name="ServicesCard" Grid.Column="1" Style="{StaticResource SaGlassSurfaceStyle}">
                    <Grid RowSpacing="{StaticResource SaSpace4}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock x:Uid="WorkloadServicesSectionTitle" AutomationProperties.HeadingLevel="Level2"
                                       Style="{StaticResource SaSectionHeaderTextStyle}" VerticalAlignment="Center" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource SaStatusBadgeTextStyle}"
                                       Text="{Binding ServicesProblemBadge}"
                                       Visibility="{Binding HasServicesProblems, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Grid.Row="1" Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                   Text="{Binding ServicesLifecycleSummary}" TextWrapping="Wrap"
                                   Visibility="{Binding ShowServicesList, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Border Grid.Row="2" Margin="0,16,0,0" Style="{StaticResource SaDataTableHeaderStyle}"
                                Visibility="{Binding ShowServicesList, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="WorkloadServiceColumnName" Grid.Column="1" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" />
                                <TextBlock x:Uid="WorkloadServiceColumnState" Grid.Column="2" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="3">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding ShowServicesList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsRepeater x:Uid="WorkloadServicesList" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled" ItemsSource="{Binding Services}" ItemTemplate="{StaticResource ServiceRowTemplate}" />
                            </ScrollViewer>
                            <TextBlock x:Uid="WorkloadServicesNoResults" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                                       Visibility="{Binding ShowServicesSectionNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadServicesUnsupportedState" VerticalAlignment="Center" IconData="{StaticResource SaIconServerStack01Data}"
                                                     Visibility="{Binding ShowServicesUnsupported, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadServicesUnavailableState" VerticalAlignment="Center" IconData="{StaticResource SaIconAlert02Data}"
                                                     Visibility="{Binding ShowServicesUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadServicesErrorState" VerticalAlignment="Center" IconData="{StaticResource SaIconAlert02Data}"
                                                     Visibility="{Binding ShowServicesError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <primitives:SaEmptyState x:Uid="WorkloadServicesEmptyState" VerticalAlignment="Center" IconData="{StaticResource SaIconServerStack01Data}"
                                                     Visibility="{Binding ShowServicesEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <primitives:SaInlineNotice Grid.Row="4" x:Uid="WorkloadTruncatedServices" Severity="Info"
                                                   Visibility="{Binding ShowServicesTruncatedNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Read-only note 112:2756. -->
        <primitives:SaInlineNotice Grid.Row="4" x:Uid="WorkloadReadOnlyNoticeBox" Severity="Info" />
    </Grid>
</Page>
