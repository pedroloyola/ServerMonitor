<Page
    x:Class="ServerMonitor.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls"
    xmlns:converters="using:ServerMonitor.App.Converters"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- UI.3 Histórico, Figma 05 · 03: 112:2192 (Dark) / 112:2369 (Light); states 112:14381 / 112:14614 / 112:16322.
         Sidebar is UI.6: the content takes the whole window, so a back button stays (D-UI3-5). -->
    <Page.Resources>
        <converters:IndexToBooleanConverter x:Key="IndexToBooleanConverter" />
    </Page.Resources>

    <Grid x:Name="PageRoot" Padding="{StaticResource SaPagePadding}" RowSpacing="{StaticResource SaSpace20}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="900" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- 640-899: the range moves under the server selector (Prism inventory 8). -->
                <VisualState x:Name="Medium">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="640" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RangeTrack.(Grid.Row)" Value="1" />
                        <Setter Target="RangeTrack.(Grid.Column)" Value="0" />
                        <Setter Target="ControlsRow.RowSpacing" Value="{StaticResource SaSpace12}" />
                    </VisualState.Setters>
                </VisualState>
                <!-- < 640: compact padding, range under the selector, chart summary above the plot, footer stacked. -->
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageRoot.Padding" Value="{StaticResource SaPagePaddingCompact}" />
                        <Setter Target="ControlsRow.RowSpacing" Value="{StaticResource SaSpace12}" />
                        <Setter Target="RangeTrack.(Grid.Row)" Value="1" />
                        <Setter Target="RangeTrack.(Grid.Column)" Value="0" />
                        <Setter Target="ServerSelector.Width" Value="NaN" />
                        <Setter Target="ServerSelector.(Grid.ColumnSpan)" Value="3" />
                        <Setter Target="ServerSelector.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CpuChart.(Grid.Row)" Value="1" />
                        <Setter Target="CpuChart.(Grid.Column)" Value="0" />
                        <Setter Target="CpuChart.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="MemoryChart.(Grid.Row)" Value="1" />
                        <Setter Target="MemoryChart.(Grid.Column)" Value="0" />
                        <Setter Target="MemoryChart.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="DiskChart.(Grid.Row)" Value="1" />
                        <Setter Target="DiskChart.(Grid.Column)" Value="0" />
                        <Setter Target="DiskChart.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="CpuChart.Margin" Value="0,12,0,0" />
                        <Setter Target="MemoryChart.Margin" Value="0,12,0,0" />
                        <Setter Target="DiskChart.Margin" Value="0,12,0,0" />
                        <Setter Target="RetentionText.(Grid.Row)" Value="1" />
                        <Setter Target="RetentionText.(Grid.Column)" Value="0" />
                        <Setter Target="RetentionText.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header 112:2259: title 32 Semibold + subtitle 13 Regular muted, gap 5. -->
        <Grid ColumnSpacing="{StaticResource SaSpace12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Uid="HistoryBackButton"
                VerticalAlignment="Top"
                Margin="0,6,0,0"
                Command="{Binding BackCommand}"
                Style="{StaticResource SaGhostIconButtonStyle}">
                <SymbolIcon Symbol="Back" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock
                    x:Uid="HistoryPageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource SaPageTitleTextStyle}"
                    Foreground="{ThemeResource SaTextBrush}" />
                <TextBlock
                    x:Uid="HistoryPageSubtitle"
                    Style="{StaticResource SaPageSubtitleTextStyle}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Selector + range row 112:2264 / 112:2278: h56, flexible gap. -->
        <!-- RowSpacing only when the range wraps under the selector (Prism R1 F4: an empty 2nd row must add no gap). -->
        <Grid x:Name="ControlsRow" Grid.Row="1" ColumnSpacing="{StaticResource SaSpace20}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ComboBox
                x:Name="ServerSelector"
                x:Uid="HistoryServerSelector"
                Width="330"
                VerticalAlignment="Center"
                Style="{StaticResource SaSelectorRichStyle}"
                ItemsSource="{Binding Servers}"
                SelectedItem="{Binding SelectedServer, Mode=TwoWay}" />
            <Border
                x:Name="RangeTrack"
                Grid.Column="2"
                VerticalAlignment="Center"
                Style="{StaticResource SaSegmentedRectTrackStyle}">
                <StackPanel
                    x:Uid="HistoryRangeSelector"
                    Orientation="Horizontal"
                    Spacing="4"
                    primitives:SaGroupNavigation.Mode="SelectionFollowsFocus">
                    <RadioButton x:Uid="HistoryRangeLastHour" GroupName="HistoryRange" MinWidth="82" Style="{StaticResource SaSegmentedRectItemStyle}"
                                 IsChecked="{Binding SelectedRangeIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                    <RadioButton x:Uid="HistoryRangeLast6Hours" GroupName="HistoryRange" MinWidth="82" Style="{StaticResource SaSegmentedRectItemStyle}"
                                 IsChecked="{Binding SelectedRangeIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}" />
                    <RadioButton x:Uid="HistoryRangeLast24Hours" GroupName="HistoryRange" MinWidth="82" Style="{StaticResource SaSegmentedRectItemStyle}"
                                 IsChecked="{Binding SelectedRangeIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=2}" />
                    <RadioButton x:Uid="HistoryRangeLast7Days" GroupName="HistoryRange" MinWidth="82" Style="{StaticResource SaSegmentedRectItemStyle}"
                                 IsChecked="{Binding SelectedRangeIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=3}" />
                    <RadioButton x:Name="RangeLast30Days" x:Uid="HistoryRangeLast30Days" GroupName="HistoryRange" MinWidth="82" Style="{StaticResource SaSegmentedRectItemStyle}"
                                 IsChecked="{Binding SelectedRangeIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=4}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Content: exactly one of loading / unavailable / empty / charts. -->
        <Grid Grid.Row="2">
            <!-- Loading 112:16419: solid panel, "A carregar…" + three label/block skeletons. -->
            <Border Style="{StaticResource SaStatePanelStyle}"
                    Visibility="{Binding ShowLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="{StaticResource SaSpace20}">
                        <TextBlock x:Uid="HistoryLoadingPanel" Style="{StaticResource SaBodyTextStyle}" Foreground="{ThemeResource SaTextBrush}" />
                        <StackPanel Spacing="{StaticResource SaSpace16}">
                            <primitives:SaSkeleton Width="100" Height="16" HorizontalAlignment="Left" />
                            <primitives:SaSkeleton Height="76" />
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource SaSpace16}">
                            <primitives:SaSkeleton Width="100" Height="16" HorizontalAlignment="Left" />
                            <primitives:SaSkeleton Height="76" />
                        </StackPanel>
                        <StackPanel Spacing="{StaticResource SaSpace16}">
                            <primitives:SaSkeleton Width="100" Height="16" HorizontalAlignment="Left" />
                            <primitives:SaSkeleton Height="76" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Unavailable (store degraded; not drawn in Figma -> same panel family, no action). -->
            <Border Style="{StaticResource SaStatePanelStyle}"
                    Visibility="{Binding ShowUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Beacon L2: the pane is named by the state title, never by the action inside it. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Title, ElementName=UnavailableState}">
                    <primitives:SaEmptyState
                        x:Name="UnavailableState"
                        x:Uid="HistoryUnavailableState"
                        VerticalAlignment="Center"
                        IconData="{StaticResource SaIconServerStack01Data}" />
                </ScrollViewer>
            </Border>

            <!-- Empty-ever 112:14478 / empty-period 112:14711 (D-UI3-10). -->
            <Border Style="{StaticResource SaStatePanelStyle}"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Beacon L2: the pane is named by the state title, never by the action inside it. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Title, ElementName=EmptyState}">
                    <primitives:SaEmptyState
                        x:Name="EmptyState"
                        VerticalAlignment="Center"
                        IconData="{StaticResource SaIconServerStack01Data}"
                        Title="{Binding EmptyTitle}"
                        Message="{Binding EmptyMessage}">
                        <StackPanel HorizontalAlignment="Center">
                            <Button
                                Width="200"
                                Style="{StaticResource SaSolidButtonStyle}"
                                Content="{Binding EmptyActionText}"
                                Command="{Binding ViewServerCommand}"
                                Visibility="{Binding ShowEmptyNeverRecorded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button
                                Width="200"
                                Style="{StaticResource SaSolidButtonStyle}"
                                Content="{Binding EmptyActionText}"
                                Command="{Binding ViewLast30DaysCommand}"
                                Click="OnViewLast30DaysClick"
                                Visibility="{Binding ShowViewLast30Days, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </primitives:SaEmptyState>
                </ScrollViewer>
            </Border>

            <!-- Charts 112:2290 / 112:2314 / 112:2338: gap 16. -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding ShowCharts, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="{StaticResource SaSpace16}">
                    <!-- Beacon F3: the card is one read-only Tab stop named by the full chart summary (brought into view on focus). -->
                    <primitives:SaFocusableCard AutomationProperties.Name="{Binding CpuSummary}">
                        <Border Style="{StaticResource SaChartCardStyle}">
                            <Grid ColumnSpacing="{StaticResource SaSpace24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel MinWidth="154" Spacing="6" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource SaButtonTextStyle}" Foreground="{ThemeResource SaTextBrush}" Text="{Binding CpuTitle}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Style="{StaticResource SaChartValueTextStyle}" Foreground="{ThemeResource SaTextBrush}" Text="{Binding CpuCurrentValue}" />
                                        <TextBlock Style="{StaticResource SaChartUnitTextStyle}" VerticalAlignment="Center" Text="{Binding PercentUnit}"
                                                   Visibility="{Binding HasCpuCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{Binding CurrentLabel}" />
                                    <TextBlock Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{Binding CpuPeakDisplay}" />
                                </StackPanel>
                                <controls:HistoryChart
                                    x:Name="CpuChart"
                                    Grid.Column="1"
                                    Height="128"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Series="{Binding CpuSeries}"
                                    RangeStart="{Binding RangeStartUtc}"
                                    RangeEnd="{Binding RangeEndUtc}"
                                    XTicks="{Binding XAxisTicks}"
                                    XTicksCompact="{Binding XAxisTicksCompact}"
                                    YLabels="{Binding YAxisLabels}"
                                    LineThickness="{StaticResource SaChartLineThickness}"
                                    LineBrush="{ThemeResource SaChartLineBrush}"
                                    GridLineBrush="{ThemeResource SaTextBrush}" />
                            </Grid>
                        </Border>
                    </primitives:SaFocusableCard>

                    <!-- Beacon F3: the card is one read-only Tab stop named by the full chart summary (brought into view on focus). -->
                    <primitives:SaFocusableCard AutomationProperties.Name="{Binding MemorySummary}">
                        <Border Style="{StaticResource SaChartCardStyle}">
                            <Grid ColumnSpacing="{StaticResource SaSpace24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel MinWidth="154" Spacing="6" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource SaButtonTextStyle}" Foreground="{ThemeResource SaTextBrush}" Text="{Binding MemoryTitle}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Style="{StaticResource SaChartValueTextStyle}" Foreground="{ThemeResource SaTextBrush}" Text="{Binding MemoryCurrentValue}" />
                                        <TextBlock Style="{StaticResource SaChartUnitTextStyle}" VerticalAlignment="Center" Text="{Binding PercentUnit}"
                                                   Visibility="{Binding HasMemoryCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{Binding CurrentLabel}" />
                                    <TextBlock Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{Binding MemoryPeakDisplay}" />
                                </StackPanel>
                                <controls:HistoryChart
                                    x:Name="MemoryChart"
                                    Grid.Column="1"
                                    Height="128"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Series="{Binding MemorySeries}"
                                    RangeStart="{Binding RangeStartUtc}"
                                    RangeEnd="{Binding RangeEndUtc}"
                                    XTicks="{Binding XAxisTicks}"
                                    XTicksCompact="{Binding XAxisTicksCompact}"
                                    YLabels="{Binding YAxisLabels}"
                                    LineThickness="{StaticResource SaChartLineThickness}"
                                    LineBrush="{ThemeResource SaChartLineBrush}"
                                    GridLineBrush="{ThemeResource SaTextBrush}" />
                            </Grid>
                        </Border>
                    </primitives:SaFocusableCard>

                    <!-- Beacon F3: the card is one read-only Tab stop named by the full chart summary (brought into view on focus). -->
                    <primitives:SaFocusableCard AutomationProperties.Name="{Binding DiskSummary}">
                        <Border Style="{StaticResource SaChartCardStyle}">
                            <Grid ColumnSpacing="{StaticResource SaSpace24}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel MinWidth="154" Spacing="6" VerticalAlignment="Top">
                                    <TextBlock Style="{StaticResource SaButtonTextStyle}" Foreground="{ThemeResource SaTextBrush}" Text="{Binding DiskTitle}"
                                               AutomationProperties.HeadingLevel="Level2" />
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <TextBlock Style="{StaticResource SaChartValueTextStyle}" Foreground="{ThemeResource SaTextBrush}" Text="{Binding DiskCurrentValue}" />
                                        <TextBlock Style="{StaticResource SaChartUnitTextStyle}" VerticalAlignment="Center" Text="{Binding PercentUnit}"
                                                   Visibility="{Binding HasDiskCurrent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{Binding CurrentLabel}" />
                                    <TextBlock Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{Binding DiskPeakDisplay}" />
                                </StackPanel>
                                <controls:HistoryChart
                                    x:Name="DiskChart"
                                    Grid.Column="1"
                                    Height="128"
                                    AutomationProperties.AccessibilityView="Raw"
                                    Series="{Binding DiskSeries}"
                                    RangeStart="{Binding RangeStartUtc}"
                                    RangeEnd="{Binding RangeEndUtc}"
                                    XTicks="{Binding XAxisTicks}"
                                    XTicksCompact="{Binding XAxisTicksCompact}"
                                    YLabels="{Binding YAxisLabels}"
                                    LineThickness="{StaticResource SaChartLineThickness}"
                                    LineBrush="{ThemeResource SaChartLineBrush}"
                                    GridLineBrush="{ThemeResource SaTextBrush}" />
                            </Grid>
                        </Border>
                    </primitives:SaFocusableCard>

                    <!-- Offline periods (not drawn in Figma): info notice under the charts, never a gap shown as 0. -->
                    <primitives:SaInlineNotice
                        x:Uid="HistoryOfflineNotice"
                        Severity="Info"
                        Visibility="{Binding ShowOfflineNotice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer 112:2362: Clock01 15 + period, retention to the right (12 Regular muted). -->
        <Grid Grid.Row="3" ColumnSpacing="{StaticResource SaSpace16}" RowSpacing="{StaticResource SaSpace4}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SaSpace8}">
                <primitives:SaIcon Data="{StaticResource SaIconClock01Data}" Size="15" Foreground="{ThemeResource SaTextSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" VerticalAlignment="Center"
                           Text="{Binding PeriodFooter}" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock
                x:Name="RetentionText"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Style="{StaticResource SaCaptionTextStyle}"
                Foreground="{ThemeResource SaTextSecondaryBrush}"
                Text="{Binding RetentionNotice}"
                TextWrapping="Wrap" />
        </Grid>
    </Grid>
</Page>
