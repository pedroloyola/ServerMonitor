<Page
    x:Class="ServerMonitor.App.Views.ServerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- UI.4 D-UI4-DETAIL: INTERIM page (replaced in UI.5). The current ServerFullCard of one server, unchanged, plus a
         breadcrumb back to where it was opened from (Visão geral or Servidores). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="{StaticResource SaPagePadding}" Spacing="{StaticResource SaSpace20}">
            <primitives:SaBreadcrumb
                x:Name="Breadcrumb"
                ParentText="{Binding ParentText}"
                CurrentText="{Binding Title}"
                ParentInvoked="OnBreadcrumbParentInvoked" />
            <controls:ServerFullCard DataContext="{Binding Card}" />
        </StackPanel>
    </ScrollViewer>
</Page>
