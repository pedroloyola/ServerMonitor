  <data name="ConnectionHintCancelled" xml:space="preserve"><value>You cancelled the test. You can retest whenever you like.</value></data>
  <data name="ConnectionHintUnexpected" xml:space="preserve"><value>Something unexpected interrupted the test. Retest; if it keeps happening, restart the app.</value></data>
