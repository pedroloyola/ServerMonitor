  <data name="ConnectionHintTargetUnreachableViaJump" xml:space="preserve"><value>The jump host worked, but it could not reach the server. Check the server's address and port as seen from the jump host.</value></data>
  <data name="ConnectionHintRoutedHostKeyUnknown" xml:space="preserve"><value>This server has not been seen through the jump host before. Compare the SHA-256 fingerprint below with the server's own before trusting it.</value></data>
