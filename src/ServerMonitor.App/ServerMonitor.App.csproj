<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ServerMonitor.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- M12 icon consistency: embed the official ServerAlyzer icon (multi-resolution .ico) as the
         executable's Win32 icon. This drives the window/title-bar, Alt-Tab and Task Manager icon and
         is the base the runtime AppWindow.SetIcon reinforces. Generated from assets/brand/Logo.svg. -->
    <ApplicationIcon>Images\ServerAlyzer.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>

    <!--
      M13 S2-T. The tray effect switch maps Kind -> (native operation, MayCreateAffordance) in ONE
      exhaustive expression with NO default arm, so a new EffectKind that nobody described is a BUILD
      FAILURE rather than a silent `false`. That is only true if CS8509 is an error, so it is escalated
      here; before this the guarantee was asserted in the design but not true in the tree.

      CS8524 is deliberately NOT escalated. It is the unnamed-enum-value diagnostic, and treating it as
      an error would require covering unnamed values — normally with exactly the default arm this design
      forbids. The two requirements are incompatible. Its runtime manifestation, SwitchExpressionException
      for an undefined value, is what the absence-of-default test asserts instead. If TreatWarningsAsErrors
      is ever enabled globally, CS8524 must be excluded via WarningsNotAsErrors or this design breaks.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509</WarningsAsErrors>
    <DefaultLanguage>pt-BR</DefaultLanguage>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- M12/ADR-017 §6: use the custom Program.Main (Program.cs) so the single-instance
         decision runs before any window/DI/tray/DB/engine is created. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- M12/ADR-017 §7 version mapping.
         The Microsoft Store RESERVES the 4th version component (Revision): a submitted MSIX must have
         Revision = 0 (Partner Center rejected 1.0.0.1). A Store update therefore bumps Major/Minor/
         Build and keeps Revision 0 → the M12 icon-consistency fix ships as PACKAGE version 1.0.1.0
         (both Package*.appxmanifest). Product/marketing SemVer stays 1.0.0 (first public RC). See
         PITFALL P-016.

         M13/ADR-018: the Windows 11 widget is a user-visible feature addition, so that was a MINOR bump,
         not another build bump. 1.1.0.0 > 1.0.1.0, so the Store upgrade path from the shipped 1.0.1.0
         stays valid, and product and package versions converge again (the 1.0.0-vs-1.0.1 divergence M12
         had to accept is retired).

         M13 REOPENED after v1.1.0 was already published. QA-7, QA-8, QA-9, QA-10, QA-11 and QA-12 were
         fixed afterwards, so the runtime behaviour differs from what v1.1.0 shipped and it must not carry
         that version: PATCH bump to 1.1.1. The public v1.1.0 stays immutable. Concept map:
           Package/Identity Version : 1.1.1.0  (Store-valid; Revision 0)
           FileVersion              : 1.1.1.0  (tracks the package build)
           AssemblyVersion          : 1.0.0.0  (stable project baseline; unchanged for binding safety)
           Product SemVer / Informational : 1.1.1
         DisplayVersion (Settings/About) = Major.Minor.Build of the *running* version: 1.1.1 both
         packaged (reads Package.Current) and unpackaged/dev (assembly fallback). NÃO criar tag
         v1.1.1 sem aprovação humana. -->
    <Version>1.1.1</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <InformationalVersion>1.1.1</InformationalVersion>
    <!-- M12/ADR-017: one app, two deployment profiles. Default is the existing UNPACKAGED,
         self-contained build (dev Debug + existing Release + every test/gate). Pass
         -p:Packaged=true for the production single-project MSIX profile below. Domain logic
         is identical; only the deployment profile differs. -->
    <Packaged Condition="'$(Packaged)' == ''">false</Packaged>
  </PropertyGroup>

  <!-- Unpackaged profile (default). Self-contained; keeps the P-009 notification-resource
       workaround (staged by the target below). This is what dev and the existing Release use. -->
  <PropertyGroup Condition="'$(Packaged)' != 'true'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- Packaged profile (production single-project MSIX). Framework-dependent: the Store /
       framework package provisions the Windows App Runtime, so the P-009 resource DLL is
       already present and its workaround is NOT staged here (ADR-017 §3/§8). Signing is left
       off in the build; a DEV certificate signs the .msix out-of-band for local sideload QA. -->
  <PropertyGroup Condition="'$(Packaged)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
    <AppxPackage>true</AppxPackage>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxAutoIncrementPackageRevision>false</AppxAutoIncrementPackageRevision>
    <!-- Support matrix = Windows 11 x64 (ADR-017). Keep the manifest's own TargetDeviceFamily
         (MinVersion 10.0.22000.0) verbatim instead of regenerating it from the compile-time SDK
         (TargetPlatformMinVersion). This lets the package floor be Windows 11 without retargeting
         the TargetFramework (which would change the API surface). -->
    <AppxAddDefaultTargetDeviceFamilyItem>false</AppxAddDefaultTargetDeviceFamilyItem>
    <!-- Identity selection: production Store identity by default; the separate DEV identity
         (Package.Dev.appxmanifest) only when -p:DevIdentity=true, so the DEV identity can never
         leak into a production MSIX (ADR-017 §2). -->
    <AppxManifestFile Condition="'$(DevIdentity)' == 'true'">Package.Dev.appxmanifest</AppxManifestFile>
    <AppxManifestFile Condition="'$(AppxManifestFile)' == ''">Package.appxmanifest</AppxManifestFile>
  </PropertyGroup>

  <!-- Package manifest + visual assets are part of the app project only in the packaged
       profile (single-project MSIX; no separate .wapproj). Exactly one manifest is included. -->
  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <AppxManifest Remove="Package.appxmanifest" />
    <AppxManifest Remove="Package.Dev.appxmanifest" />
    <AppxManifest Include="$(AppxManifestFile)">
      <SubType>Designer</SubType>
    </AppxManifest>
    <Content Include="Images\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.3.1" GeneratePathProperty="true" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
  </ItemGroup>

  <!--
    Windows App SDK 2.3.1's self-contained component payload omits the Insights
    resource DLL required by AppNotificationManager.Register. Extract exactly the
    matching redistributable from the already-resolved Runtime package so the
    unpackaged application remains genuinely self-contained.
  -->
  <Target Name="StageWindowsAppRuntimeNotificationResource" BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(Packaged)' != 'true'">
    <PropertyGroup>
      <WindowsAppRuntimeMsix>$(PkgMicrosoft_WindowsAppSDK_Runtime)\tools\MSIX\win10-x64\Microsoft.WindowsAppRuntime.2.msix</WindowsAppRuntimeMsix>
      <WindowsAppRuntimeNotificationStage>$(IntermediateOutputPath)WindowsAppRuntimeNotification\</WindowsAppRuntimeNotificationStage>
    </PropertyGroup>
    <Error Condition="!Exists('$(WindowsAppRuntimeMsix)')"
           Text="The Windows App SDK Runtime payload required for local notifications was not found." />
    <Unzip SourceFiles="$(WindowsAppRuntimeMsix)"
           DestinationFolder="$(WindowsAppRuntimeNotificationStage)"
           Include="Microsoft.WindowsAppRuntime.Insights.Resource.dll"
           SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(WindowsAppRuntimeNotificationStage)Microsoft.WindowsAppRuntime.Insights.Resource.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutDir)Microsoft.WindowsAppRuntime.Insights.Resource.dll')"
           Text="The Windows App SDK notification resource was not staged into the application output." />
  </Target>

  <!--
    M13 (ADR-018) — bundle the out-of-process widget provider into EVERY packaged build, DEV and production
    alike. A single-project MSIX ships ONE app executable automatically; the provider is a SEPARATE COM
    ExeServer, so its executable must be added to the package payload explicitly. Microsoft's documented
    multi-exe path is a Windows Application Packaging Project (.wapproj), but this app is deliberately a
    single-project MSIX — so the provider is added through supported Content inclusion instead.
    The provider is published FRAMEWORK-DEPENDENT so the whole package shares the app's single Windows App
    SDK 2.3.1 line: only the four provider-UNIQUE files (exe/dll/deps.json/runtimeconfig.json) are added at
    the package root; every WinAppSDK/WinUI/Widgets-projection dll and both contract dlls are ALREADY shipped
    by the app, so there is NO second (self-contained) runtime payload. That is a BLOCKING release invariant
    — audit it in the EXTRACTED package, never from this file alone.
    DEV and production packages differ only in identity, notification-activator CLSID and display strings
    (the two Package*.appxmanifest files); the widget payload is identical, so what board QA exercised is
    exactly what the Store package ships.
  -->
  <!--
    M13-QA-7 gate, backing the check inside StageWidgetProviderForPackage below. It parses the PE header
    itself (no external tooling, no PowerShell dependency): e_lfanew at 0x3C gives the PE signature offset,
    the optional header starts after the 4-byte signature plus the 20-byte COFF header, and its Subsystem
    field sits at offset 68 within it - the same offset for PE32 and PE32+.
  -->
  <UsingTask TaskName="VerifyPeSubsystem" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ExecutablePath ParameterType="System.String" Required="true" />
      <ExpectedSubsystem ParameterType="System.Int32" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        int subsystem = -1;
        using (var stream = System.IO.File.OpenRead(ExecutablePath))
        using (var reader = new System.IO.BinaryReader(stream))
        {
            stream.Position = 0x3C;
            long peOffset = reader.ReadInt32();
            // Signature (4) + COFF header (20) + Subsystem at 68 within the optional header, then 2 bytes.
            if (peOffset > 0 && peOffset + 94 <= stream.Length)
            {
                stream.Position = peOffset;
                if (reader.ReadUInt32() == 0x00004550) // PE signature
                {
                    stream.Position = peOffset + 4 + 20 + 68;
                    subsystem = reader.ReadUInt16();
                }
            }
        }

        if (subsystem < 0)
        {
            Log.LogError(
                "PE subsystem gate: '" + ExecutablePath + "' does not have a readable PE header, so the " +
                "widget provider's subsystem could not be verified. Refusing to package it.");
        }
        else if (subsystem != ExpectedSubsystem)
        {
            Log.LogError(
                "PE subsystem gate failed for '" + ExecutablePath + "': expected " + ExpectedSubsystem +
                " (IMAGE_SUBSYSTEM_WINDOWS_GUI) but the staged binary is " + subsystem + ". A console-" +
                "subsystem (3) widget provider makes Windows show a console window when COM activates it " +
                "on the Widgets board (M13-QA-7). Check <OutputType> in " +
                "ServerMonitor.WidgetProvider.csproj: it must be WinExe.");
        }
        else
        {
            Log.LogMessage(Microsoft.Build.Framework.MessageImportance.High,
                "Widget provider PE subsystem verified: " + subsystem + " (IMAGE_SUBSYSTEM_WINDOWS_GUI).");
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="StageWidgetProviderForPackage" BeforeTargets="AssignTargetPaths"
          Condition="'$(Packaged)' == 'true'">
    <PropertyGroup>
      <WidgetProviderProject>$(MSBuildThisFileDirectory)..\ServerMonitor.WidgetProvider\ServerMonitor.WidgetProvider.csproj</WidgetProviderProject>
      <!-- Stage OUTSIDE the app's obj/bin (in the gitignored repo-level artifacts/) so the SDK never
           enumerates the provider output as a second set of publish files (NETSDK1152). Qualified by
           Configuration AND RuntimeIdentifier so parallel Debug/Release (or multi-RID) package builds never
           read/overwrite each other's stage (Atlas M-1). -->
      <WidgetProviderPackageStage>$(MSBuildThisFileDirectory)..\..\artifacts\widget-provider-stage\$(Configuration)-$(RuntimeIdentifier)\</WidgetProviderPackageStage>
    </PropertyGroup>
    <!-- Clean the stage first: dotnet publish -o does NOT remove obsolete files, so a renamed/removed
         provider output could otherwise leave a stale file that gets packaged (Atlas M-1). -->
    <RemoveDir Directories="$(WidgetProviderPackageStage)" />
    <!-- Framework-dependent publish (no self-contained WinAppSDK/.NET payload): shares the app's runtime. -->
    <Exec Command="dotnet publish &quot;$(WidgetProviderProject)&quot; -c $(Configuration) -p:WindowsAppSDKSelfContained=false -p:SelfContained=false -p:WindowsPackageType=MSIX --disable-build-servers -o &quot;$(WidgetProviderPackageStage)&quot;" />
    <!-- Validate ALL four provider-unique files are present before packaging, so a build can never silently
         ship a partial/stale provider (Atlas M-1). -->
    <Error Condition="!Exists('$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.exe')"
           Text="Widget provider staging incomplete: ServerAlyzer.WidgetProvider.exe missing." />
    <Error Condition="!Exists('$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.dll')"
           Text="Widget provider staging incomplete: ServerAlyzer.WidgetProvider.dll missing." />
    <Error Condition="!Exists('$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.deps.json')"
           Text="Widget provider staging incomplete: ServerAlyzer.WidgetProvider.deps.json missing." />
    <Error Condition="!Exists('$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.runtimeconfig.json')"
           Text="Widget provider staging incomplete: ServerAlyzer.WidgetProvider.runtimeconfig.json missing." />
    <!-- M13-QA-7 BLOCKING GATE. Read the PE subsystem byte out of the exe that is ACTUALLY about to be
         packaged and fail the build unless it is 2 (IMAGE_SUBSYSTEM_WINDOWS_GUI). A console-subsystem (3)
         provider makes Windows allocate and SHOW a console window when COM activates it - unconditionally,
         whether or not the process writes anything. This is measured on the staged binary rather than
         trusted from the csproj property because 1.1.0.0 shipped subsystem 3 with a fully green suite, and
         because a smoke launch from a terminal INHERITS that terminal's console and can never observe the
         defect. -->
    <VerifyPeSubsystem ExecutablePath="$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.exe"
                       ExpectedSubsystem="2" />
    <!-- Explicit literal Link per file. Do NOT use %(Filename)%(Extension) here: inside a target ItemGroup
         that batches over the whole @(Content) vector (README, icons, logos), producing a cartesian set of
         wrong relative paths. KeepDuplicates=false because AssignTargetPaths fires in both build and publish
         phases, so this hook runs more than once. -->
    <ItemGroup>
      <Content Include="$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.exe"
               Link="ServerAlyzer.WidgetProvider.exe" CopyToOutputDirectory="PreserveNewest" KeepDuplicates="false" />
      <Content Include="$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.dll"
               Link="ServerAlyzer.WidgetProvider.dll" CopyToOutputDirectory="PreserveNewest" KeepDuplicates="false" />
      <Content Include="$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.deps.json"
               Link="ServerAlyzer.WidgetProvider.deps.json" CopyToOutputDirectory="PreserveNewest" KeepDuplicates="false" />
      <Content Include="$(WidgetProviderPackageStage)ServerAlyzer.WidgetProvider.runtimeconfig.json"
               Link="ServerAlyzer.WidgetProvider.runtimeconfig.json" CopyToOutputDirectory="PreserveNewest" KeepDuplicates="false" />
    </ItemGroup>
  </Target>

  <!-- Public folder declared by the widget AppExtension (PublicFolder="Public"): the host-facing widget
       icon + screenshot the Widgets picker reads. Part of every packaged build, DEV and production. -->
  <ItemGroup Condition="'$(Packaged)' == 'true'">
    <Content Include="Public\**" CopyToOutputDirectory="PreserveNewest">
      <Link>Public\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icon: purpose-built multi-resolution .ico (16/20/24/32/48) derived from the official
         logo, replacing the runtime-rasterized SVG so the tray reads crisply at 16-24px and matches
         the Store/taskbar identity (M12 icon consistency). WinUIEx TrayIcon auto-detects .ico. -->
    <Content Include="Assets\ServerAlyzerTray.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\ServerMonitorNotification.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- Window/title-bar/Alt-Tab icon file used by AppWindow.SetIcon at runtime. In the packaged
         profile it is already carried by Images\** below; the unpackaged/dev build needs it copied
         to the output so SetIcon can find it next to the executable. -->
    <Content Include="Images\ServerAlyzer.ico" CopyToOutputDirectory="PreserveNewest"
             Condition="'$(Packaged)' != 'true'" />
  </ItemGroup>

  <!-- QA visual health harness is Debug-only. It must never ship in a Release build. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Qa\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServerMonitor.Core\ServerMonitor.Core.csproj" />
    <ProjectReference Include="..\ServerMonitor.Infrastructure\ServerMonitor.Infrastructure.csproj" />
    <ProjectReference Include="..\ServerMonitor.Collectors\ServerMonitor.Collectors.csproj" />
    <ProjectReference Include="..\ServerMonitor.WidgetContract\ServerMonitor.WidgetContract.csproj" />
    <ProjectReference Include="..\ServerMonitor.ActivationContract\ServerMonitor.ActivationContract.csproj" />
  </ItemGroup>
</Project>
