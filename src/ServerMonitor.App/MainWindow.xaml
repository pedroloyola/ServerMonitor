<Window
    x:Class="ServerMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="RootLayout"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="20,0,144,0"
            Background="{ThemeResource TitleBarSurfaceBrush}">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="9">
                <Border
                    Width="22"
                    Height="22"
                    Background="{ThemeResource AccentSoftBrush}"
                    CornerRadius="7">
                    <FontIcon
                        FontSize="11"
                        Foreground="{ThemeResource AccentTextBrush}"
                        Glyph="&#xE9D9;" />
                </Border>
                <TextBlock
                    x:Uid="AppNameText"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="13"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            Background="Transparent" />
    </Grid>
</Window>
