<Window
    x:Class="ServerMonitor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <Grid
        x:Name="RootLayout"
        Background="Transparent">

        <Border x:Name="WindowBackground" Style="{StaticResource SaShellWindowBackgroundStyle}" IsHitTestVisible="False"/>

        <!-- ============================ STANDARD PRESENTATION ============================ -->
        <!-- UI.6 112:1358: native window, sidebar208 + content; each page owns p40 exactly once. -->
        <Grid x:Name="StandardRoot">
            <Grid x:Name="ShellSurface">
                <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Background="{ThemeResource SaSidebarMaterialBrush}" IsHitTestVisible="False"/>
                <controls:SaSidebar x:Name="Sidebar"/>
                <Border Width="1" HorizontalAlignment="Right" Background="{ThemeResource SaSidebarEdgeBrush}" IsHitTestVisible="False" />
                <Frame x:Name="ContentFrame" Grid.Column="1" Background="Transparent" />
            </Grid>
            <!-- Figma 112:247: same window, no sidebar; panel1040x780. Modal remains above both hosts. -->
            <controls:OnboardingView x:Name="FirstRunView" Visibility="Collapsed" />
            <!-- G-1 platform exception: no 52px band. Drag only the top32, above page headers at y40. Native captions remain. -->
            <Grid x:Name="ShellDragRegion" Height="32" VerticalAlignment="Top" Background="Transparent" />
        </Grid>

        <!-- ============================ COMPACT PRESENTATION ============================ -->
        <!-- UI.8 (Figma 05 sec. 15, 112:9397 / 112:9589): the same window, client 432x704 DIP by default. Title strip = band
             0-60 (p20 + 40; brand and "Expandir" centred on y40, Prism R-3) left of the measured native caption reserve
             (CompactCaptionColumn, Min/Close stay native: G-3). The body is CompactShell (p20, 16 below the strip). -->
        <Grid x:Name="CompactRoot" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="CompactCaptionColumn" Width="96" />
                </Grid.ColumnDefinitions>

                <!-- The drag handle (SetTitleBar): the whole strip left of the button. Mark 23 · g12 · wordmark (trims, then
                     collapses below its minimum); priority captions > Expandir > mark > wordmark (CompactTitleLayout). -->
                <Grid x:Name="CompactDragRegion" Padding="{StaticResource SaCompactTitlePadding}" Background="Transparent">
                    <StackPanel x:Name="CompactBrand" Height="40" Orientation="Horizontal" Spacing="{StaticResource SaSpace12}" VerticalAlignment="Top">
                        <primitives:SaBrandMark x:Name="CompactBrandMark" Size="23" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactWordmark" x:Uid="AppNameText" VerticalAlignment="Center" Style="{StaticResource SaBrandTextStyle}"
                                   Foreground="{ThemeResource SaTextBrush}" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </Grid>

                <!-- "Expandir ›" 112:9430: hugs its content (not 126 fixed, R-3); icon-only 36x36 below the MEASURED threshold,
                     same accessible name + tooltip. -->
                <Button x:Name="CompactExpandButton" x:Uid="CompactExpandButton" Grid.Column="1" Margin="0,20,0,0" VerticalAlignment="Center"
                        Style="{StaticResource SaCompactButtonStyle}" Command="{x:Bind ModeView.ExitCompactCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="CompactExpandText" x:Uid="CompactExpandButtonText" VerticalAlignment="Center" TextWrapping="NoWrap" />
                        <primitives:SaIcon Data="{StaticResource SaIconArrowRight01Data}" Size="16" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="CompactBody" Grid.Row="1" Padding="{StaticResource SaCompactBodyPadding}">
                <controls:CompactShell x:Name="CompactShellView" />
            </Grid>
        </Grid>
        <!-- Full-window modal, above Standard/onboarding/Compact and the drag surface. -->
        <Grid x:Name="ModalOverlayHost" IsHitTestVisible="False" />
    </Grid>
</Window>
