<Window
    x:Class="ServerMonitor.App.MainWindow"
    x:Uid="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        x:Name="RootLayout"
        Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Padding="20,0,16,0"
            Background="Transparent">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <Border
                    Width="24"
                    Height="24"
                    Background="{ThemeResource AccentSoftBrush}"
                    CornerRadius="8">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource AccentTextBrush}"
                        Glyph="&#xE9D9;" />
                </Border>
                <TextBlock
                    x:Uid="AppNameText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="ShellNavigation"
            Grid.Row="1"
            AlwaysShowHeader="False"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="{Binding IsPaneOpen, Mode=TwoWay}"
            IsSettingsVisible="False"
            Loaded="OnNavigationLoaded"
            PaneDisplayMode="LeftCompact"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavigationDashboardItem" Tag="dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavigationSettingsItem" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
