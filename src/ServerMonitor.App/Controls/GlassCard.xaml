<UserControl
    x:Class="ServerMonitor.App.Controls.GlassCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        CornerRadius="{StaticResource RadiusLarge}"
        Translation="0,0,8">
        <Grid.Shadow>
            <ThemeShadow />
        </Grid.Shadow>

        <!-- System Backdrop Layer for real Desktop Acrylic per-card -->
        <SystemBackdropElement
            x:Name="CardBackdropElement"
            CornerRadius="{StaticResource RadiusLarge}"
            IsHitTestVisible="False" />

        <!-- Subtle Tint Overlay -->
        <Border
            Background="{ThemeResource GlassSurfaceBrush}"
            CornerRadius="{StaticResource RadiusLarge}"
            IsHitTestVisible="False" />

        <!-- Highlight & Stroke Border -->
        <Border
            BorderBrush="{ThemeResource GlassBorderBrush}"
            BorderThickness="{StaticResource GlassBorderThickness}"
            CornerRadius="{StaticResource RadiusLarge}"
            IsHitTestVisible="False" />

        <!-- Card Content -->
        <ContentPresenter
            Padding="{StaticResource GlassCardPadding}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Content="{x:Bind CardContent, Mode=OneWay}" />
    </Grid>
</UserControl>
