<UserControl
    x:Class="ServerMonitor.App.Controls.GlassCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="CardSurface"
        Padding="{StaticResource GlassCardPadding}"
        Background="{ThemeResource GlassSurfaceBrush}"
        BorderBrush="{ThemeResource GlassBorderBrush}"
        BorderThickness="{StaticResource GlassBorderThickness}"
        CornerRadius="{StaticResource RadiusXLarge}"
        Translation="0,0,12">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid>
            <ContentPresenter
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{x:Bind CardContent, Mode=OneWay}" />
            <Border
                VerticalAlignment="Top"
                Height="1"
                Margin="10,-21,10,0"
                Background="{ThemeResource GlassHighlightBrush}"
                CornerRadius="1"
                IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
