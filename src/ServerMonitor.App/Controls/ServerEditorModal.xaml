<UserControl
    x:Class="ServerMonitor.App.Controls.ServerEditorModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls">
    <Grid x:Name="ModalRoot" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <!-- Smoke overlay behind modal (preserves desktop backdrop blur while dimming content) -->
        <Border
            x:Name="SmokeLayer"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="{ThemeResource ModalSmokeBrush}"
            PointerPressed="OnSmokeLayerPointerPressed" />

        <!-- Centered Glass Modal Card (Single continuous piece of frosted glass) -->
        <Grid
            x:Name="ModalCard"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            MinWidth="500"
            MaxWidth="560"
            CornerRadius="{StaticResource RadiusLarge}"
            Translation="0,0,16">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>

            <!-- Real Desktop Acrylic SystemBackdropElement -->
            <SystemBackdropElement
                x:Name="ModalBackdropElement"
                CornerRadius="{StaticResource RadiusLarge}"
                IsHitTestVisible="False" />

            <!-- Subtle Tint Overlay -->
            <Border
                Background="{ThemeResource GlassSurfaceBrush}"
                CornerRadius="{StaticResource RadiusLarge}"
                IsHitTestVisible="False" />

            <!-- Highlight & Stroke Border -->
            <Border
                BorderBrush="{ThemeResource GlassBorderBrush}"
                BorderThickness="{StaticResource GlassBorderThickness}"
                CornerRadius="{StaticResource RadiusLarge}"
                IsHitTestVisible="False" />

            <!-- Content Area: Title + ServerForm + Continuous Actions (No separated footer) -->
            <Grid Padding="24,24,24,20" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Modal Title -->
                <TextBlock
                    x:Name="ModalTitleText"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextPrimaryBrush}" />

                <!-- Form Controls -->
                <controls:ServerFormControl
                    x:Name="ServerForm"
                    Grid.Row="1"
                    DataContext="{x:Bind ViewModel, Mode=OneWay}" />

                <!-- Action Buttons: Seamlessly integrated on the same glass surface -->
                <Grid
                    Grid.Row="2"
                    ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="PrimaryActionButton"
                        Grid.Column="0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource BrandPrimaryButtonStyle}"
                        Click="OnPrimaryButtonClick" />
                    <Button
                        x:Name="CancelActionButton"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource QuietPillButtonStyle}"
                        Click="OnCancelButtonClick" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
