<UserControl
    x:Class="ServerMonitor.App.Controls.HistoryChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinHeight="96">
    <!-- UI.3 (D-UI3-13, Figma 112:2298): plot area (98) + Y axis to the right (gap 14) + X axis 16 below. The axes live OUTSIDE
         the plot canvases (UI.0 §3); HistoryChartGeometry.BuildSegments still maps the series into PlotHost only. -->
    <Grid x:Name="RootGrid" ColumnSpacing="14" RowSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="PlotHost" SizeChanged="OnSizeChanged">
            <Canvas x:Name="GridCanvas" IsHitTestVisible="False" />
            <Canvas x:Name="PlotCanvas" IsHitTestVisible="False" />
        </Grid>
        <Canvas x:Name="YAxisCanvas" Grid.Column="1" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
        <Canvas x:Name="XAxisCanvas" Grid.Row="1" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
    </Grid>
</UserControl>
