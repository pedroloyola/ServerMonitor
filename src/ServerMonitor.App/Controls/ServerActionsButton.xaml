<UserControl
    x:Class="ServerMonitor.App.Controls.ServerActionsButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button
        VerticalAlignment="Center"
        AutomationProperties.Name="{Binding MoreOptionsAutomationName}"
        Style="{StaticResource SubtleIconButtonStyle}"
        ToolTipService.ToolTip="{Binding MoreOptionsAutomationName}">
        <FontIcon FontSize="13" Glyph="&#xE712;" />
        <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem
                    x:Uid="ServerCardHistoryMenuItem"
                    Command="{Binding ViewHistoryCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="ServerCardWorkloadsMenuItem"
                    Command="{Binding ViewWorkloadsCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Uid="ServerCardEditMenuItem"
                    Command="{Binding EditCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE70F;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem
                    x:Uid="ServerCardHideMenuItem"
                    Command="{Binding HideCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xED1A;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Uid="ServerCardRemoveMenuItem"
                    Command="{Binding RemoveCommand}">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Button.Flyout>
    </Button>
</UserControl>
