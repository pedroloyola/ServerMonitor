<UserControl
    x:Class="ServerMonitor.App.Controls.ServerFormControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer
        x:Name="FormScrollViewer"
        x:Uid="ServerFormScrollViewer"
        MaxHeight="540"
        VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="520" Padding="2,2,10,2" Spacing="10">
            <InfoBar
                x:Uid="ServerFormValidationError"
                AutomationProperties.LiveSetting="Assertive"
                IsClosable="False"
                IsOpen="{Binding HasValidationErrors}"
                Severity="Error" />

            <!-- Import from ~/.ssh/config: read-only preview; choosing a host fills only empty fields -->
            <StackPanel
                Spacing="8"
                Visibility="{Binding IsSshConfigImportAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button
                    x:Uid="ServerFormImportSshConfigButton"
                    Click="OnImportSshConfigClick"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    Style="{StaticResource QuietPillButtonStyle}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="{Binding SshConfigStatusMessage}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasSshConfigStatus, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Border
                    Padding="12"
                    Background="{ThemeResource MutedSurfaceBrush}"
                    BorderBrush="{ThemeResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Visibility="{Binding IsSshConfigImportOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ServerFormSshConfigTitle"
                                VerticalAlignment="Center"
                                AutomationProperties.HeadingLevel="Level2"
                                FontSize="13"
                                FontWeight="SemiBold" />
                            <Button
                                x:Uid="ServerFormSshConfigCloseButton"
                                Grid.Column="1"
                                Click="OnCloseSshConfigImportClick"
                                Style="{StaticResource QuietPillButtonStyle}" />
                        </Grid>
                        <ProgressRing
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Left"
                            IsActive="{Binding IsLoadingSshConfig}"
                            Visibility="{Binding IsLoadingSshConfig, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{Binding SshConfigFileWarningMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasSshConfigFileWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <!-- Virtualized and height-bounded: the list is capped at 500 hosts by the resolver. -->
                        <ListView
                            x:Uid="ServerFormSshConfigHostList"
                            MaxHeight="320"
                            IsItemClickEnabled="False"
                            ContainerContentChanging="OnSshConfigHostContainerContentChanging"
                            ItemsSource="{Binding SshConfigHosts}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,6" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Alias}" TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                Text="{Binding Preview}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding RequirementText}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasRequirement, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextTertiaryBrush}"
                                                Text="{Binding ClassificationText}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding HasClassification, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Button
                                            x:Uid="ServerFormSshConfigUseButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="{Binding UseAutomationName}"
                                            Click="OnUseSshConfigHostClick"
                                            IsEnabled="{Binding IsImportable}"
                                            Style="{StaticResource QuietPillButtonStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Server Name -->
            <TextBox
                x:Name="NameField"
                x:Uid="ServerFormNameField"
                CornerRadius="{StaticResource RadiusSmall}"
                IsEnabled="{Binding IsNotTestingConnection}"
                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <!-- Host & Port Side-by-Side -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Uid="ServerFormHostField"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox
                    x:Uid="ServerFormPortField"
                    Grid.Column="1"
                    CornerRadius="{StaticResource RadiusSmall}"
                    InputScope="Number"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    MaxLength="5"
                    Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <!-- Username & OS Side-by-Side -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Uid="ServerFormUsernameField"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    x:Uid="ServerFormOperatingSystemField"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    SelectedIndex="{Binding SelectedOperatingSystemIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="OperatingSystemAutoOption" />
                    <ComboBoxItem x:Uid="OperatingSystemLinuxOption" />
                    <ComboBoxItem x:Uid="OperatingSystemMacOSOption" />
                    <ComboBoxItem x:Uid="OperatingSystemUnknownOption" />
                </ComboBox>
            </Grid>

            <!-- Automatic monitoring interval -->
            <ComboBox
                x:Uid="ServerFormRefreshIntervalField"
                HorizontalAlignment="Stretch"
                CornerRadius="{StaticResource RadiusSmall}"
                IsEnabled="{Binding IsNotTestingConnection}"
                SelectedIndex="{Binding SelectedRefreshIntervalIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="RefreshInterval10sOption" />
                <ComboBoxItem x:Uid="RefreshInterval30sOption" />
                <ComboBoxItem x:Uid="RefreshInterval1minOption" />
                <ComboBoxItem x:Uid="RefreshInterval5minOption" />
            </ComboBox>

            <Border Height="1" Margin="0,4" Background="{ThemeResource GlassBorderBrush}" />

            <!-- Authentication Section -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="ServerFormAuthenticationTitle"
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource SectionTitleTextStyle}" />
                <!-- "How do I prepare my server?" (M14.5): text and copyable commands only; runs nothing. -->
                <HyperlinkButton
                    x:Name="PrepHelpLink"
                    x:Uid="ServerFormPrepHelpLink"
                    Grid.Column="1"
                    Padding="6,2"
                    VerticalAlignment="Center"
                    Click="OnPrepHelpClick"
                    FontSize="12">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout
                            x:Name="PrepHelpFlyout"
                            Opening="OnPrepHelpOpening"
                            Placement="Bottom">
                            <StackPanel
                                x:Name="PrepHelpContent"
                                Width="400"
                                Spacing="10">
                                <TextBlock
                                    x:Uid="ServerPrepTitle"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="ServerPrepIntro"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="ServerPrepKeygenStep"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="10,7"
                                        Background="{ThemeResource MutedSurfaceBrush}"
                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock
                                            x:Name="PrepKeygenText"
                                            FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Button
                                        x:Name="PrepCopyKeygenButton"
                                        x:Uid="ServerPrepCopyKeygenButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Click="OnCopyPrepKeygenClick"
                                        Style="{StaticResource QuietPillButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    x:Uid="ServerPrepCopyKeyStep"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="10,7"
                                        Background="{ThemeResource MutedSurfaceBrush}"
                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock
                                            x:Name="PrepCopyKeyText"
                                            FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Button
                                        x:Name="PrepCopyKeyButton"
                                        x:Uid="ServerPrepCopyKeyButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Click="OnCopyPrepKeyClick"
                                        Style="{StaticResource QuietPillButtonStyle}" />
                                </Grid>
                                <TextBlock
                                    x:Name="PrepPlaceholderNote"
                                    x:Uid="ServerPrepPlaceholderNote"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Uid="ServerPrepServiceStep"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </HyperlinkButton>
            </Grid>
            <ComboBox
                x:Uid="ServerFormAuthenticationMethodField"
                HorizontalAlignment="Stretch"
                CornerRadius="{StaticResource RadiusSmall}"
                IsEnabled="{Binding IsNotTestingConnection}"
                SelectedIndex="{Binding SelectedAuthenticationIndex, Mode=TwoWay}">
                <ComboBoxItem x:Uid="AuthenticationSshKeyOption" />
                <ComboBoxItem x:Uid="AuthenticationPasswordOption" />
            </ComboBox>

            <!-- SSH Key Auth Fields -->
            <StackPanel
                Spacing="8"
                Visibility="{Binding IsPrivateKeyAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Default keys found in .ssh (metadata only); the last entry opens the file picker below. -->
                <ComboBox
                    x:Name="LocalKeySelector"
                    x:Uid="ServerFormLocalKeySelector"
                    HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource RadiusSmall}"
                    DisplayMemberPath="Label"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    ItemsSource="{Binding LocalKeyOptions}"
                    SelectionChanged="OnLocalKeySelectionChanged"
                    Visibility="{Binding HasLocalKeyOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Uid="ServerFormPrivateKeyPathField"
                        CornerRadius="{StaticResource RadiusSmall}"
                        IsReadOnly="True"
                        Text="{Binding PrivateKeyPath}" />
                    <Button
                        x:Uid="ServerFormChoosePrivateKeyButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,1"
                        Click="OnChoosePrivateKeyClick"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        Style="{StaticResource QuietPillButtonStyle}" />
                </Grid>
                <TextBlock
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    Text="{Binding PrivateKeyHint}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasPrivateKeyHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <PasswordBox
                    x:Name="PassphraseField"
                    x:Uid="ServerFormPassphraseField"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    PasswordRevealMode="Peek" />
                <TextBlock
                    x:Uid="ServerFormSavedPassphraseHint"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasSavedPassphrase, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <CheckBox
                    x:Uid="ServerFormRemoveSavedPassphrase"
                    IsChecked="{Binding RemoveSavedPassphrase, Mode=TwoWay}"
                    Visibility="{Binding HasSavedPassphrase, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Password Auth Fields -->
            <StackPanel
                Spacing="8"
                Visibility="{Binding IsPasswordAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                <PasswordBox
                    x:Name="PasswordField"
                    x:Uid="ServerFormPasswordField"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    PasswordRevealMode="Peek" />
                <TextBlock
                    x:Uid="ServerFormSavedPasswordHint"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasSavedPassword, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <TextBlock
                x:Uid="ServerFormCredentialReassurance"
                FontSize="12"
                Foreground="{ThemeResource TextTertiaryBrush}"
                TextWrapping="Wrap" />

            <Border Height="1" Margin="0,4" Background="{ThemeResource GlassBorderBrush}" />

            <!-- Route: single-hop jump host (M14.4b-2). The server is then reached ONLY through the jump. -->
            <TextBlock
                x:Uid="ServerFormRouteTitle"
                AutomationProperties.HeadingLevel="Level2"
                Style="{StaticResource SectionTitleTextStyle}" />
            <CheckBox
                x:Uid="ServerFormUseJumpHost"
                IsChecked="{Binding UseJumpHost, Mode=TwoWay}"
                IsEnabled="{Binding IsNotTestingConnection}" />
            <StackPanel
                Spacing="8"
                Visibility="{Binding UseJumpHost, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    x:Uid="ServerFormJumpHostHint"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    TextWrapping="Wrap" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Uid="ServerFormJumpHostField"
                        CornerRadius="{StaticResource RadiusSmall}"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        Text="{Binding JumpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox
                        x:Uid="ServerFormJumpPortField"
                        Grid.Column="1"
                        CornerRadius="{StaticResource RadiusSmall}"
                        InputScope="Number"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        MaxLength="5"
                        Text="{Binding JumpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <TextBox
                    x:Uid="ServerFormJumpUsernameField"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    Text="{Binding JumpUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    x:Uid="ServerFormJumpAuthenticationMethodField"
                    HorizontalAlignment="Stretch"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    SelectedIndex="{Binding SelectedJumpAuthenticationIndex, Mode=TwoWay}">
                    <ComboBoxItem x:Uid="JumpAuthenticationSshKeyOption" />
                    <ComboBoxItem x:Uid="JumpAuthenticationPasswordOption" />
                </ComboBox>
                <StackPanel
                    Spacing="8"
                    Visibility="{Binding IsJumpPrivateKeyAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <!-- Same found keys as the target; the jump host's key is never pre-selected. -->
                    <ComboBox
                        x:Name="JumpLocalKeySelector"
                        x:Uid="ServerFormJumpLocalKeySelector"
                        HorizontalAlignment="Stretch"
                        CornerRadius="{StaticResource RadiusSmall}"
                        DisplayMemberPath="Label"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        ItemsSource="{Binding LocalKeyOptions}"
                        SelectionChanged="OnJumpLocalKeySelectionChanged"
                        Visibility="{Binding HasLocalKeyOptions, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Uid="ServerFormJumpPrivateKeyPathField"
                            CornerRadius="{StaticResource RadiusSmall}"
                            IsReadOnly="True"
                            Text="{Binding JumpPrivateKeyPath}" />
                        <Button
                            x:Uid="ServerFormChooseJumpPrivateKeyButton"
                            Grid.Column="1"
                            Margin="0,0,0,1"
                            VerticalAlignment="Bottom"
                            Click="OnChooseJumpPrivateKeyClick"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            Style="{StaticResource QuietPillButtonStyle}" />
                    </Grid>
                    <PasswordBox
                        x:Name="JumpPassphraseField"
                        x:Uid="ServerFormJumpPassphraseField"
                        CornerRadius="{StaticResource RadiusSmall}"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        PasswordRevealMode="Peek" />
                </StackPanel>
                <PasswordBox
                    x:Name="JumpPasswordField"
                    x:Uid="ServerFormJumpPasswordField"
                    CornerRadius="{StaticResource RadiusSmall}"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    PasswordRevealMode="Peek"
                    Visibility="{Binding IsJumpPasswordAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock
                    x:Uid="ServerFormSavedJumpSecretHint"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasSavedJumpSecret, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Test Connection Row -->
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                <Button
                    x:Uid="ServerFormTestConnectionButton"
                    Click="OnTestConnectionClick"
                    IsEnabled="{Binding IsNotTestingConnection}"
                    Style="{StaticResource QuietPillButtonStyle}" />
                <Button
                    x:Uid="ServerFormCancelTestButton"
                    Click="OnCancelTestClick"
                    Style="{StaticResource QuietPillButtonStyle}"
                    Visibility="{Binding IsTestingConnection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ProgressRing
                    Width="18"
                    Height="18"
                    IsActive="{Binding IsTestingConnection}"
                    Visibility="{Binding IsTestingConnection, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>

            <!-- Connection checklist (M14.5): port → identity → authentication → operating system.
                 State changes are announced from code-behind (one notification per change). -->
            <Border
                x:Name="ChecklistPanel"
                Padding="14,12"
                Background="{ThemeResource MutedSurfaceBrush}"
                BorderBrush="{ThemeResource GlassBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Visibility="{Binding HasConnectionStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Uid="ServerFormChecklistTitle"
                            VerticalAlignment="Center"
                            AutomationProperties.HeadingLevel="Level2"
                            FontSize="13"
                            FontWeight="SemiBold" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            HorizontalTextAlignment="Right"
                            Text="{Binding ConnectionStatusMessage}"
                            TextWrapping="Wrap" />
                    </Grid>
                    <ItemsControl IsTabStop="False" ItemsSource="{Binding ConnectionChecklist.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="0,4" Spacing="6">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- One state mark at a time; the state is also always written out as text. -->
                                        <Grid
                                            Width="18"
                                            Height="18"
                                            VerticalAlignment="Top"
                                            AutomationProperties.AccessibilityView="Raw">
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource TextTertiaryBrush}"
                                                Glyph="&#xEA3A;"
                                                Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <ProgressRing
                                                Width="14"
                                                Height="14"
                                                IsActive="{Binding IsRunning}"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource StatusHealthyBrush}"
                                                Glyph="&#xE73E;"
                                                Visibility="{Binding IsPassed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource StatusCriticalBrush}"
                                                Glyph="&#xEA39;"
                                                Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource TextTertiaryBrush}"
                                                Glyph="&#xE738;"
                                                Visibility="{Binding IsNotReached, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource StatusWarningBrush}"
                                                Glyph="&#xE72E;"
                                                Visibility="{Binding IsActionRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <FontIcon
                                                FontSize="14"
                                                Foreground="{ThemeResource StatusWarningBrush}"
                                                Glyph="&#xE7BA;"
                                                Visibility="{Binding IsWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                        <TextBlock
                                            Grid.Column="1"
                                            AutomationProperties.Name="{Binding AccessibleName}"
                                            FontSize="13"
                                            Text="{Binding Title}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="2"
                                            AutomationProperties.AccessibilityView="Raw"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            Text="{Binding StateText}" />
                                    </Grid>
                                    <StackPanel
                                        Margin="28,0,0,0"
                                        Spacing="6"
                                        Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextSecondaryBrush}"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding Detail}"
                                            TextWrapping="Wrap" />
                                        <Grid
                                            ColumnSpacing="8"
                                            Visibility="{Binding HasCommand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Padding="10,7"
                                                Background="{ThemeResource MutedSurfaceBrush}"
                                                BorderBrush="{ThemeResource GlassBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSmall}">
                                                <TextBlock
                                                    FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                    FontSize="12"
                                                    IsTextSelectionEnabled="True"
                                                    Text="{Binding Command}"
                                                    TextWrapping="Wrap" />
                                            </Border>
                                            <Button
                                                x:Uid="ConnectionStepCopyCommandButton"
                                                Grid.Column="1"
                                                VerticalAlignment="Top"
                                                Click="OnCopyStepCommandClick"
                                                Style="{StaticResource QuietPillButtonStyle}" />
                                        </Grid>
                                        <HyperlinkButton
                                            x:Uid="ServerFormPrepHelpLink"
                                            Padding="0"
                                            Click="OnPrepHelpClick"
                                            FontSize="12"
                                            Visibility="{Binding OffersPrepHelp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Unknown Host Key Confirmation -->
            <Border
                Padding="16"
                Background="{ThemeResource MutedSurfaceBrush}"
                BorderBrush="{ThemeResource StatusWarningBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Visibility="{Binding HasUnknownHostKey, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Name="UnknownHostHeading"
                        x:Uid="HostKeyUnknownTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        FontSize="15"
                        FontWeight="SemiBold" />
                    <TextBlock x:Uid="HostKeyUnknownDescription" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="HostKeyServerLabel" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Medium" />
                            <TextBlock Text="{Binding HostKeySubjectDisplay}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="HostKeyAlgorithmLabel" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Medium" />
                            <TextBlock Text="{Binding PresentedHostKeyAlgorithm}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="HostKeyFingerprintLabel" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Medium" />
                        <Border
                            Padding="10,7"
                            Background="{ThemeResource MutedSurfaceBrush}"
                            BorderBrush="{ThemeResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}">
                            <TextBlock
                                FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{Binding PresentedHostKeyFingerprint}"
                                TextWrapping="WrapWholeWords" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <Button
                            x:Uid="HostKeyTrustAndConnectButton"
                            Click="OnTrustAndConnectClick"
                            Style="{StaticResource AccentPillButtonStyle}" />
                        <Button
                            x:Uid="HostKeyCancelButton"
                            Click="OnDismissHostKeyClick"
                            Style="{StaticResource QuietPillButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Host Key Mismatch Alert -->
            <Border
                Padding="16"
                Background="{ThemeResource MutedSurfaceBrush}"
                BorderBrush="{ThemeResource StatusCriticalBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMedium}"
                Visibility="{Binding HasHostKeyMismatch, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="HostKeyMismatchTitle"
                        AutomationProperties.HeadingLevel="Level2"
                        AutomationProperties.LiveSetting="Assertive"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StatusCriticalBrush}" />
                    <TextBlock x:Uid="HostKeyMismatchDescription" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <StackPanel Spacing="2">
                        <TextBlock x:Uid="HostKeyMismatchServerLabel" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Medium" />
                        <TextBlock Text="{Binding HostKeySubjectDisplay}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="HostKeyKnownFingerprintLabel" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Medium" />
                        <Border
                            Padding="10,7"
                            Background="{ThemeResource MutedSurfaceBrush}"
                            BorderBrush="{ThemeResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}">
                            <TextBlock
                                FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{Binding TrustedHostKeyFingerprint}"
                                TextWrapping="WrapWholeWords" />
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock x:Uid="HostKeyReceivedFingerprintLabel" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}" FontWeight="Medium" />
                        <Border
                            Padding="10,7"
                            Background="{ThemeResource MutedSurfaceBrush}"
                            BorderBrush="{ThemeResource GlassBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusSmall}">
                            <TextBlock
                                FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                FontSize="12"
                                IsTextSelectionEnabled="True"
                                Text="{Binding PresentedHostKeyFingerprint}"
                                TextWrapping="WrapWholeWords" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
