<UserControl
    x:Class="ServerMonitor.App.Controls.ServerFormControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ServerMonitor.App.Converters"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <UserControl.Resources>
        <converters:IndexToBooleanConverter x:Key="IndexToBooleanConverter" />
    </UserControl.Resources>
    <!-- UI.7A: the server editor form of Figma 04 (Add, 112:3318 / 112:3479) and 05 (Edit, 112:4679): two glass cards
         508 + 24 + 508 ("O teu servidor" | "Como te queres ligar?"), the options card (Porta 160 · SO · Atualizar), the
         jump-host disclosure and, when on, its two cards. Every field binds to the SAME ServerEditorViewModel properties
         as before (no intermediate draft, Vigil H4); secrets stay in PasswordBoxes read and cleared in code (never bound).
         The page (ServerEditorPage) owns the header, the action bar, the credential note and (UI.7B) the dialogs: the
         SSH-config import and the trust prompt are no longer inline here. TEMPORARY until 7C (per-field errors, the
         Figma 08 test dialog): the validation InfoBar and the test checklist. Below 760 of useful width the cards stack
         (Identity → Auth) and the options card wraps (B-19). -->
    <StackPanel x:Name="FormRoot" Spacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <primitives:SaContentWidthTrigger Source="{Binding ElementName=FormRoot}" MinWidth="760" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Stacked">
                    <VisualState.StateTriggers>
                        <primitives:SaContentWidthTrigger Source="{Binding ElementName=FormRoot}" MinWidth="0" MaxWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CardsColumn2.Width" Value="0" />
                        <Setter Target="CardsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="CardsGrid.RowSpacing" Value="{StaticResource SaSpace16}" />
                        <Setter Target="AuthCard.(Grid.Column)" Value="0" />
                        <Setter Target="AuthCard.(Grid.Row)" Value="1" />
                        <Setter Target="JumpCardsColumn2.Width" Value="0" />
                        <Setter Target="JumpCardsGrid.ColumnSpacing" Value="0" />
                        <Setter Target="JumpCardsGrid.RowSpacing" Value="{StaticResource SaSpace16}" />
                        <Setter Target="JumpAuthCard.(Grid.Column)" Value="0" />
                        <Setter Target="JumpAuthCard.(Grid.Row)" Value="1" />
                        <Setter Target="OptionsColumn3.Width" Value="0" />
                        <Setter Target="OptionsGrid.RowSpacing" Value="{StaticResource SaSpace16}" />
                        <Setter Target="RefreshIntervalField.(Grid.Row)" Value="1" />
                        <Setter Target="RefreshIntervalField.(Grid.Column)" Value="0" />
                        <Setter Target="RefreshIntervalField.(Grid.ColumnSpan)" Value="2" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- TEMPORARY (7C: per-field errors, Figma 06): the existing assertive validation summary. -->
        <InfoBar
            x:Uid="ServerFormValidationError"
            AutomationProperties.LiveSetting="Assertive"
            IsClosable="False"
            IsOpen="{Binding HasValidationErrors}"
            Severity="Error" />

        <!-- UI.7B: what the last "Importar de SSH" did ("filled from X" / "nothing filled"), said politely in the form. The
             import itself is the page's dialog (Figma 04 chrome, 07 states); no inline list any more. -->
        <TextBlock
            x:Name="ImportStatusText"
            AutomationProperties.LiveSetting="Polite"
            Style="{StaticResource SaCaptionTextStyle}"
            Foreground="{ThemeResource SaTextSecondaryBrush}"
            Text="{Binding SshConfigStatusMessage}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!-- Connection and authentication 112:3320: 508 + 24 + 508. -->
        <Grid x:Name="CardsGrid" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CardsColumn2" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Server identity 112:3321: Nome · Host ou endereço IP · Utilizador SSH. -->
            <Border x:Name="IdentityCard" Style="{StaticResource SaGlassSurfaceStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="20" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock x:Uid="ServerEditorIdentityTitle" Style="{StaticResource SaTitleCompactTextStyle}"
                                   AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="IdentitySubtitle" Style="{StaticResource SaCaptionTextStyle}"
                               Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" />
                    <primitives:SaFormField x:Uid="ServerEditorNameField">
                        <TextBox
                            x:Name="NameField"
                            x:Uid="ServerEditorNameInput"
                            Style="{StaticResource SaTextFieldStyle}"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </primitives:SaFormField>
                    <primitives:SaFormField x:Uid="ServerEditorHostField">
                        <TextBox
                            x:Uid="ServerEditorHostInput"
                            Style="{StaticResource SaTextFieldStyle}"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </primitives:SaFormField>
                    <primitives:SaFormField x:Uid="ServerEditorUsernameField">
                        <TextBox
                            x:Uid="ServerEditorUsernameInput"
                            Style="{StaticResource SaTextFieldStyle}"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </primitives:SaFormField>
                </StackPanel>
            </Border>

            <!-- Authentication 112:3341: segmented Chave SSH | Palavra-passe, then the method's fields. -->
            <Border x:Name="AuthCard" Grid.Column="1" Style="{StaticResource SaGlassSurfaceStyle}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <primitives:SaIcon Data="{StaticResource SaIconKey01Data}" Size="20" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock x:Name="AuthTitle" Grid.Column="1" Style="{StaticResource SaTitleCompactTextStyle}"
                                   AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <!-- "Como preparo o meu servidor?" (M14.5, survives - G-5): text and copyable commands only; runs nothing. -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <HyperlinkButton
                                x:Name="PrepHelpLink"
                                x:Uid="ServerFormPrepHelpLink"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                Click="OnPrepHelpClick"
                                FontSize="12">
                                <FlyoutBase.AttachedFlyout>
                                    <Flyout
                                        x:Name="PrepHelpFlyout"
                                        Opening="OnPrepHelpOpening"
                                        Placement="Bottom">
                                        <StackPanel
                                            x:Name="PrepHelpContent"
                                            Width="400"
                                            Spacing="10">
                                            <TextBlock
                                                x:Uid="ServerPrepTitle"
                                                AutomationProperties.HeadingLevel="Level2"
                                                Style="{StaticResource SectionTitleTextStyle}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Uid="ServerPrepIntro"
                                                FontSize="12"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Uid="ServerPrepKeygenStep"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Padding="10,7"
                                                    Background="{ThemeResource MutedSurfaceBrush}"
                                                    BorderBrush="{ThemeResource GlassBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSmall}">
                                                    <TextBlock
                                                        x:Name="PrepKeygenText"
                                                        FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                        FontSize="12"
                                                        IsTextSelectionEnabled="True"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                                <Button
                                                    x:Name="PrepCopyKeygenButton"
                                                    x:Uid="ServerPrepCopyKeygenButton"
                                                                        VerticalAlignment="Top"
                                                    Click="OnCopyPrepKeygenClick"
                                                    Style="{StaticResource QuietPillButtonStyle}" />
                                            </Grid>
                                            <TextBlock
                                                x:Uid="ServerPrepCopyKeyStep"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Padding="10,7"
                                                    Background="{ThemeResource MutedSurfaceBrush}"
                                                    BorderBrush="{ThemeResource GlassBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusSmall}">
                                                    <TextBlock
                                                        x:Name="PrepCopyKeyText"
                                                        FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                                        FontSize="12"
                                                        IsTextSelectionEnabled="True"
                                                        TextWrapping="Wrap" />
                                                </Border>
                                                <Button
                                                    x:Name="PrepCopyKeyButton"
                                                    x:Uid="ServerPrepCopyKeyButton"
                                                                        VerticalAlignment="Top"
                                                    Click="OnCopyPrepKeyClick"
                                                    Style="{StaticResource QuietPillButtonStyle}" />
                                            </Grid>
                                            <TextBlock
                                                x:Name="PrepPlaceholderNote"
                                                x:Uid="ServerPrepPlaceholderNote"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed" />
                                            <TextBlock
                                                x:Uid="ServerPrepServiceStep"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextSecondaryBrush}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Flyout>
                                </FlyoutBase.AttachedFlyout>
                            </HyperlinkButton>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="AuthSubtitle" Style="{StaticResource SaCaptionTextStyle}"
                               Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" />
                    <Border Style="{StaticResource SaSegmentedPillTrackStyle}" HorizontalAlignment="Stretch">
                        <Grid x:Uid="ServerEditorAuthMethodGroup" ColumnSpacing="4" primitives:SaGroupNavigation.Mode="SelectionFollowsFocus">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 112:3356: Key01 / LockPassword 16 + Medium 12; the SAME SelectedAuthenticationIndex setter as
                                 before, so changing the method still drops a staged secret (Vigil H4). -->
                            <RadioButton x:Uid="ServerEditorAuthKeyOption" GroupName="ServerEditorAuthentication" HorizontalAlignment="Stretch"
                                         Style="{StaticResource SaSegmentedPillItemStyle}" IsEnabled="{Binding IsNotTestingConnection}"
                                         IsChecked="{Binding SelectedAuthenticationIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <primitives:SaIcon Data="{StaticResource SaIconKey01Data}" Size="16" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="ServerEditorAuthKeyOptionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Uid="ServerEditorAuthPasswordOption" Grid.Column="1" GroupName="ServerEditorAuthentication" HorizontalAlignment="Stretch"
                                         Style="{StaticResource SaSegmentedPillItemStyle}" IsEnabled="{Binding IsNotTestingConnection}"
                                         IsChecked="{Binding SelectedAuthenticationIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <primitives:SaIcon Data="{StaticResource SaIconLockPasswordData}" Size="16" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="ServerEditorAuthPasswordOptionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>

                    <!-- SSH key (B-12): the 460x40 picker shows the file NAME; its menu lists the keys found in .ssh (metadata
                         only) + "Procurar ficheiro…"; the full path is in the tooltip and the UIA HelpText; the helper says
                         when the editor pre-selected a key (no silent choice). No editable path box. -->
                    <StackPanel Spacing="14" Visibility="{Binding IsPrivateKeyAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:SaFormField x:Name="PrivateKeyField" x:Uid="ServerEditorPrivateKeyField">
                            <Button x:Name="KeyPickerButton" Style="{StaticResource SaPickerButtonStyle}"
                                    IsEnabled="{Binding IsNotTestingConnection}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <primitives:SaIcon Data="{StaticResource SaIconFolder01Data}" Size="18" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource SaTextSecondaryBrush}" />
                                    <TextBlock x:Name="KeyPickerText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="KeyPickerMenu" Placement="BottomEdgeAlignedLeft" Opening="OnKeyPickerMenuOpening" />
                                </Button.Flyout>
                            </Button>
                        </primitives:SaFormField>
                        <!-- G-13: a saved passphrase is never drawn as dots: empty field + "guardada" + "Deixa em branco…". -->
                        <primitives:SaFormField x:Name="PassphraseFormField" x:Uid="ServerEditorPassphraseField">
                            <PasswordBox
                                x:Name="PassphraseField"
                                x:Uid="ServerEditorPassphraseInput"
                                Style="{StaticResource SaPasswordBoxStyle}"
                                IsEnabled="{Binding IsNotTestingConnection}"
                                PasswordRevealMode="Peek" />
                        </primitives:SaFormField>
                        <CheckBox
                            x:Uid="ServerFormRemoveSavedPassphrase"
                            Style="{StaticResource SaCheckBoxStyle}"
                            IsChecked="{Binding RemoveSavedPassphrase, Mode=TwoWay}"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            Visibility="{Binding HasSavedPassphrase, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <!-- Password 112:3693: never bound; read and cleared by the page on Test/Save. A saved one: empty + "guardada". -->
                    <StackPanel Spacing="14" Visibility="{Binding IsPasswordAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:SaFormField x:Name="PasswordFormField" x:Uid="ServerEditorPasswordField">
                            <PasswordBox
                                x:Name="PasswordField"
                                x:Uid="ServerEditorPasswordInput"
                                Style="{StaticResource SaPasswordBoxStyle}"
                                IsEnabled="{Binding IsNotTestingConnection}"
                                PasswordRevealMode="Peek" />
                        </primitives:SaFormField>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Connection options 112:3383: Porta 160 · Sistema operativo · Atualizar a cada (G-27: Porta lives here). -->
        <Border x:Name="OptionsCard" Style="{StaticResource SaGlassSurfaceStyle}">
            <Grid x:Name="OptionsGrid" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="OptionsColumn3" Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <primitives:SaFormField x:Uid="ServerEditorPortField">
                    <TextBox
                        x:Uid="ServerEditorPortInput"
                        Style="{StaticResource SaTextFieldStyle}"
                        InputScope="Number"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        MaxLength="5"
                        Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </primitives:SaFormField>
                <primitives:SaFormField x:Uid="ServerEditorOperatingSystemField" Grid.Column="1">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SaSelectorFieldStyle}"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        SelectedIndex="{Binding SelectedOperatingSystemIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="OperatingSystemAutoOption" />
                        <ComboBoxItem x:Uid="OperatingSystemLinuxOption" />
                        <ComboBoxItem x:Uid="OperatingSystemMacOSOption" />
                        <ComboBoxItem x:Uid="OperatingSystemUnknownOption" />
                    </ComboBox>
                </primitives:SaFormField>
                <primitives:SaFormField x:Name="RefreshIntervalField" x:Uid="ServerEditorRefreshIntervalField" Grid.Column="2">
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource SaSelectorFieldStyle}"
                        IsEnabled="{Binding IsNotTestingConnection}"
                        SelectedIndex="{Binding SelectedRefreshIntervalIndex, Mode=TwoWay}">
                        <ComboBoxItem x:Uid="RefreshInterval10sOption" />
                        <ComboBoxItem x:Uid="RefreshInterval30sOption" />
                        <ComboBoxItem x:Uid="RefreshInterval1minOption" />
                        <ComboBoxItem x:Uid="RefreshInterval5minOption" />
                    </ComboBox>
                </primitives:SaFormField>
            </Grid>
        </Border>

        <!-- Jump host disclosure 112:3402 (M14.4b-2): the server is then reached ONLY through the jump (single hop). -->
        <StackPanel Spacing="6">
            <CheckBox
                x:Uid="ServerEditorUseJumpHost"
                Style="{StaticResource SaCheckBoxStyle}"
                IsChecked="{Binding UseJumpHost, Mode=TwoWay}"
                IsEnabled="{Binding IsNotTestingConnection}" />
            <TextBlock x:Uid="ServerEditorJumpHostDescription" Style="{StaticResource SaCaptionTextStyle}"
                       Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock x:Uid="ServerEditorJumpHostKind" Style="{StaticResource SaCaptionTextStyle}"
                       Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Jump cards 155:1165: "Jump host" (host, user, port) | its own authentication. -->
        <Grid x:Name="JumpCardsGrid" ColumnSpacing="24"
              Visibility="{Binding UseJumpHost, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="JumpCardsColumn2" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="JumpHostCard" Style="{StaticResource SaGlassSurfaceStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="20" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock x:Uid="ServerEditorJumpHostTitle" Style="{StaticResource SaTitleCompactTextStyle}"
                                   AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Uid="ServerEditorJumpHostSubtitle" Style="{StaticResource SaCaptionTextStyle}"
                               Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" />
                    <primitives:SaFormField x:Uid="ServerEditorJumpHostField">
                        <TextBox
                            x:Uid="ServerEditorJumpHostInput"
                            Style="{StaticResource SaTextFieldStyle}"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            Text="{Binding JumpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </primitives:SaFormField>
                    <primitives:SaFormField x:Uid="ServerEditorJumpUsernameField">
                        <TextBox
                            x:Uid="ServerEditorJumpUsernameInput"
                            Style="{StaticResource SaTextFieldStyle}"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            Text="{Binding JumpUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </primitives:SaFormField>
                    <primitives:SaFormField x:Uid="ServerEditorJumpPortField">
                        <TextBox
                            x:Uid="ServerEditorJumpPortInput"
                            Style="{StaticResource SaTextFieldStyle}"
                            InputScope="Number"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            MaxLength="5"
                            Text="{Binding JumpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </primitives:SaFormField>
                </StackPanel>
            </Border>
            <Border x:Name="JumpAuthCard" Grid.Column="1" Style="{StaticResource SaGlassSurfaceStyle}">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <primitives:SaIcon Data="{StaticResource SaIconKey01Data}" Size="20" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SaTextSecondaryBrush}" />
                        <TextBlock x:Uid="ServerEditorJumpAuthTitle" Style="{StaticResource SaTitleCompactTextStyle}"
                                   AutomationProperties.HeadingLevel="Level2" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Uid="ServerEditorJumpAuthSubtitle" Style="{StaticResource SaCaptionTextStyle}"
                               Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" />
                    <Border Style="{StaticResource SaSegmentedPillTrackStyle}" HorizontalAlignment="Stretch">
                        <Grid x:Uid="ServerEditorJumpAuthMethodGroup" ColumnSpacing="4" primitives:SaGroupNavigation.Mode="SelectionFollowsFocus">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Uid="ServerEditorJumpAuthKeyOption" GroupName="ServerEditorJumpAuthentication" HorizontalAlignment="Stretch"
                                         Style="{StaticResource SaSegmentedPillItemStyle}" IsEnabled="{Binding IsNotTestingConnection}"
                                         IsChecked="{Binding SelectedJumpAuthenticationIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <primitives:SaIcon Data="{StaticResource SaIconKey01Data}" Size="16" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="ServerEditorJumpAuthKeyOptionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Uid="ServerEditorJumpAuthPasswordOption" Grid.Column="1" GroupName="ServerEditorJumpAuthentication" HorizontalAlignment="Stretch"
                                         Style="{StaticResource SaSegmentedPillItemStyle}" IsEnabled="{Binding IsNotTestingConnection}"
                                         IsChecked="{Binding SelectedJumpAuthenticationIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <primitives:SaIcon Data="{StaticResource SaIconLockPasswordData}" Size="16" VerticalAlignment="Center" />
                                    <TextBlock x:Uid="ServerEditorJumpAuthPasswordOptionText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </Border>
                    <!-- The same picker and the same found keys as the target; the jump host's key is NEVER pre-selected. -->
                    <StackPanel Spacing="14" Visibility="{Binding IsJumpPrivateKeyAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <primitives:SaFormField x:Name="JumpPrivateKeyField" x:Uid="ServerEditorJumpPrivateKeyField">
                            <Button x:Name="JumpKeyPickerButton" Style="{StaticResource SaPickerButtonStyle}"
                                    IsEnabled="{Binding IsNotTestingConnection}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <primitives:SaIcon Data="{StaticResource SaIconFolder01Data}" Size="18" VerticalAlignment="Center"
                                                       Foreground="{ThemeResource SaTextSecondaryBrush}" />
                                    <TextBlock x:Name="JumpKeyPickerText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Button.Flyout>
                                    <MenuFlyout x:Name="JumpKeyPickerMenu" Placement="BottomEdgeAlignedLeft" Opening="OnJumpKeyPickerMenuOpening" />
                                </Button.Flyout>
                            </Button>
                        </primitives:SaFormField>
                        <primitives:SaFormField x:Name="JumpPassphraseFormField" x:Uid="ServerEditorJumpPassphraseField">
                            <PasswordBox
                                x:Name="JumpPassphraseField"
                                x:Uid="ServerEditorJumpPassphraseInput"
                                Style="{StaticResource SaPasswordBoxStyle}"
                                IsEnabled="{Binding IsNotTestingConnection}"
                                PasswordRevealMode="Peek" />
                        </primitives:SaFormField>
                    </StackPanel>
                    <!-- G-13 (156:478 draws dots): a saved jump secret stays an EMPTY box + "guardada" + "Deixa em branco…". -->
                    <primitives:SaFormField x:Name="JumpPasswordFormField" x:Uid="ServerEditorJumpPasswordField"
                                            Visibility="{Binding IsJumpPasswordAuthentication, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <PasswordBox
                            x:Name="JumpPasswordField"
                            x:Uid="ServerEditorJumpPasswordInput"
                            Style="{StaticResource SaPasswordBoxStyle}"
                            IsEnabled="{Binding IsNotTestingConnection}"
                            PasswordRevealMode="Peek" />
                    </primitives:SaFormField>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Derived route line 155:1165 (B-13): "Este dispositivo → jump → alvo" / "Jump host por preencher". Shown only for a
             routed server; computed from the form, stored nowhere. -->
        <TextBlock
            x:Name="RouteLine"
            Style="{StaticResource SaCaptionTextStyle}"
            Foreground="{ThemeResource SaTextSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
            AutomationProperties.LiveSetting="Polite"
            Visibility="{Binding UseJumpHost, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- TEMPORARY (7C: the Figma 08 test dialog with the 4 real stages): the connection checklist. -->
    <!-- Connection checklist (M14.5): port → identity → authentication → operating system.
         State changes are announced from code-behind (one notification per change). -->
    <Border
        x:Name="ChecklistPanel"
        Padding="14,12"
        Background="{ThemeResource MutedSurfaceBrush}"
        BorderBrush="{ThemeResource GlassBorderBrush}"
        BorderThickness="1"
        CornerRadius="{StaticResource RadiusMedium}"
        Visibility="{Binding HasConnectionStatus, Converter={StaticResource BooleanToVisibilityConverter}}">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Uid="ServerFormChecklistTitle"
                    VerticalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level2"
                    FontSize="13"
                    FontWeight="SemiBold" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextSecondaryBrush}"
                    HorizontalTextAlignment="Right"
                    Text="{Binding ConnectionStatusMessage}"
                    TextWrapping="Wrap" />
            </Grid>
            <ItemsControl IsTabStop="False" ItemsSource="{Binding ConnectionChecklist.Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Padding="0,4" Spacing="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- One state mark at a time; the state is also always written out as text. -->
                                <Grid
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Top"
                                    AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        Glyph="&#xEA3A;"
                                        Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ProgressRing
                                        Width="14"
                                        Height="14"
                                        IsActive="{Binding IsRunning}"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource StatusHealthyBrush}"
                                        Glyph="&#xE73E;"
                                        Visibility="{Binding IsPassed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource StatusCriticalBrush}"
                                        Glyph="&#xEA39;"
                                        Visibility="{Binding IsFailed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource TextTertiaryBrush}"
                                        Glyph="&#xE738;"
                                        Visibility="{Binding IsNotReached, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource StatusWarningBrush}"
                                        Glyph="&#xE72E;"
                                        Visibility="{Binding IsActionRequired, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <FontIcon
                                        FontSize="14"
                                        Foreground="{ThemeResource StatusWarningBrush}"
                                        Glyph="&#xE7BA;"
                                        Visibility="{Binding IsWarning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                                <TextBlock
                                    Grid.Column="1"
                                    AutomationProperties.Name="{Binding AccessibleName}"
                                    FontSize="13"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Grid.Column="2"
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    Text="{Binding StateText}" />
                            </Grid>
                            <StackPanel
                                Margin="28,0,0,0"
                                Spacing="6"
                                Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="{Binding Detail}"
                                    TextWrapping="Wrap" />
                                <Grid
                                    ColumnSpacing="8"
                                    Visibility="{Binding HasCommand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Padding="10,7"
                                        Background="{ThemeResource MutedSurfaceBrush}"
                                        BorderBrush="{ThemeResource GlassBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusSmall}">
                                        <TextBlock
                                            FontFamily="Cascadia Code, Cascadia Mono, Consolas"
                                            FontSize="12"
                                            IsTextSelectionEnabled="True"
                                            Text="{Binding Command}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <Button
                                        x:Uid="ConnectionStepCopyCommandButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        Click="OnCopyStepCommandClick"
                                        Style="{StaticResource QuietPillButtonStyle}" />
                                </Grid>
                                <HyperlinkButton
                                    x:Uid="ServerFormPrepHelpLink"
                                    Padding="0"
                                    Click="OnPrepHelpClick"
                                    FontSize="12"
                                    Visibility="{Binding OffersPrepHelp, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

    </StackPanel>
</UserControl>
