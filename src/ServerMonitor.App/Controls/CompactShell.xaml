<UserControl
    x:Class="ServerMonitor.App.Controls.CompactShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls"
    xmlns:converters="using:ServerMonitor.App.Converters"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:vm="using:ServerMonitor.App.ViewModels">
    <!-- UI.8 Compact Mode body (Figma 05 sec. 15: 112:9397 / 112:9589; empty 112:9781 / 112:9842). Below the title strip
         (MainWindow), inside CompactBody (p20, top 16): fleet summary 32 · g16 · list (scrolls, overlay scrollbar, no gutter)
         or one centred state block · g16 · footer 24 outside the scroll. A VIEW over CompactPresentationViewModel (the same
         dashboard cards) and WindowModeViewModel (the exits); x:Bind only; every value a token, no colour literal. -->
    <UserControl.Resources>
        <!-- 112:9828: "+ Adicionar servidor" = Add01 16 · g7 · the localized Content string (the button's accessible name). -->
        <DataTemplate x:Key="CompactAddContentTemplate" x:DataType="x:String">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <primitives:SaIcon Data="{StaticResource SaIconAdd01Data}" Size="16" VerticalAlignment="Center" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind}" />
            </StackPanel>
        </DataTemplate>
        <!-- Row 112:9439: status line 18 (dot 6 · g7 · name * · state Auto min 91 = Figma x277) · g8 · metrics 34 (3 × *, g16)
             · optional stale cue (R-7). Rows are recycled: no element state, everything bound. -->
        <DataTemplate x:Key="CompactServerRowTemplate" x:DataType="vm:CompactServerRowViewModel">
            <controls:ServerTableRowButton Style="{StaticResource SaCompactRowButtonStyle}" Click="OnRowClick"
                                           AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                <StackPanel Spacing="{StaticResource SaSpace8}">
                    <Grid Height="18" ColumnSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" MinWidth="91" />
                        </Grid.ColumnDefinitions>
                        <primitives:SaStatusIndicator Style="{StaticResource SaStatusDotOnlyStyle}" VerticalAlignment="Center"
                                                      Status="{x:Bind converters:CompactRowStyles.StatusKind(Health), Mode=OneWay}"
                                                      Label="{x:Bind StatusText, Mode=OneWay}" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SaControlTextStyle}"
                                   Foreground="{ThemeResource SaTextBrush}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" MaxLines="1" AutomationProperties.AccessibilityView="Raw"
                                   IsTextTrimmedChanged="OnNameTrimmedChanged" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind StatusText, Mode=OneWay}"
                                   Style="{x:Bind converters:CompactRowStyles.Status(Health), Mode=OneWay}"
                                   TextWrapping="NoWrap" AutomationProperties.AccessibilityView="Raw" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource SaSpace16}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- R-4: label column 50 while it fits (value at x54, aligned across the three), then it yields to the
                             value, which never truncates ("100%" always fits). -->
                        <!-- Prism c1 P-1: the column is FIXED 34 (112:9445; track at y28, 3 below) - row 80, step 88. -->
                        <StackPanel Height="34" Spacing="6">
                            <Grid Height="22" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="50" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="CompactMetricCpuLabel" VerticalAlignment="Center" Style="{StaticResource SaCompactMetricLabelTextStyle}"
                                           TextWrapping="NoWrap" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind CpuText, Mode=OneWay}" TextWrapping="NoWrap"
                                           Style="{x:Bind converters:CompactRowStyles.Value(IsCpuKnown, CpuSeverity, ShowsStaleCue), Mode=OneWay}"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <primitives:SaCompactMetricBar Value="{x:Bind converters:CompactRowStyles.BarValue(IsCpuKnown, CpuBarValue), Mode=OneWay}"
                                                           Tone="{x:Bind converters:CompactRowStyles.Tone(IsCpuKnown, CpuSeverity), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Height="34" Spacing="6">
                            <Grid Height="22" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="50" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="CompactMetricMemoryLabel" VerticalAlignment="Center" Style="{StaticResource SaCompactMetricLabelTextStyle}"
                                           TextWrapping="NoWrap" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind MemoryText, Mode=OneWay}" TextWrapping="NoWrap"
                                           Style="{x:Bind converters:CompactRowStyles.Value(IsMemoryKnown, MemorySeverity, ShowsStaleCue), Mode=OneWay}"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <primitives:SaCompactMetricBar Value="{x:Bind converters:CompactRowStyles.BarValue(IsMemoryKnown, MemoryBarValue), Mode=OneWay}"
                                                           Tone="{x:Bind converters:CompactRowStyles.Tone(IsMemoryKnown, MemorySeverity), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Height="34" Spacing="6">
                            <Grid Height="22" ColumnSpacing="4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="50" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Uid="CompactMetricDiskLabel" VerticalAlignment="Center" Style="{StaticResource SaCompactMetricLabelTextStyle}"
                                           TextWrapping="NoWrap" AutomationProperties.AccessibilityView="Raw" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind DiskText, Mode=OneWay}" TextWrapping="NoWrap"
                                           Style="{x:Bind converters:CompactRowStyles.Value(IsDiskKnown, DiskSeverity, ShowsStaleCue), Mode=OneWay}"
                                           AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                            <primitives:SaCompactMetricBar Value="{x:Bind converters:CompactRowStyles.BarValue(IsDiskKnown, DiskBarValue), Mode=OneWay}"
                                                           Tone="{x:Bind converters:CompactRowStyles.Tone(IsDiskKnown, DiskSeverity), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <!-- R-7 stale, not offline: clock 12 + "Última atualização há N min" in attention (never colour alone). -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind ShowsStaleCue, Mode=OneWay}">
                        <primitives:SaIcon Data="{StaticResource SaIconClock01Data}" Size="12" VerticalAlignment="Center"
                                           Foreground="{ThemeResource SaAttentionTextBrush}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SaHelperTextStyle}" Foreground="{ThemeResource SaAttentionTextBrush}"
                                   Text="{x:Bind StaleAgeText, Mode=OneWay}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
                    </StackPanel>
                </StackPanel>
            </controls:ServerTableRowButton>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot" RowSpacing="{StaticResource SaSpace16}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fleet summary 112:9434: "6 servidores" Medium 12 · fill · "Atualizado há 8 s" 11 secondary; only with the list. -->
        <Grid x:Name="SummaryRow" Height="32" Visibility="{x:Bind Presentation.ShowsSummary, Mode=OneWay, FallbackValue=Collapsed}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}"
                       Text="{x:Bind Presentation.ServerCountDisplay, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SaHelperTextStyle}"
                       Foreground="{ThemeResource SaTextSecondaryBrush}" Text="{x:Bind Presentation.UpdatedAgoDisplay, Mode=OneWay}"
                       Visibility="{x:Bind Presentation.HasUpdatedAgo, Mode=OneWay, FallbackValue=Collapsed}" />
        </Grid>

        <!-- R-11: overlay scrollbar, no right gutter; StackLayout spacing 8 (no trailing gap before the footer). -->
        <ScrollViewer x:Name="ListScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled" Visibility="{x:Bind Presentation.ShowsList, Mode=OneWay, FallbackValue=Collapsed}">
            <primitives:SaDataTableList x:Uid="OverviewServerList">
                <ItemsRepeater x:Name="CompactRepeater" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled"
                               AutomationProperties.AccessibilityView="Raw"
                               ItemsSource="{x:Bind Presentation.Rows, Mode=OneWay}"
                               ItemTemplate="{StaticResource CompactServerRowTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Vertical" Spacing="{StaticResource SaSpace8}" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </primitives:SaDataTableList>
        </ScrollViewer>

        <!-- R-8 / D-UI8-2: one block centred in the body (empty 112:9818: icon 28 · g12 · title 19 · body 12 ≤ 280 · action). -->
        <StackPanel x:Name="StateBlock" Grid.Row="1" MaxWidth="280" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="{StaticResource SaSpace12}" Visibility="{x:Bind Presentation.ShowsStateBlock, Mode=OneWay, FallbackValue=Collapsed}">
            <!-- Native ring (no motion of our own); neutral, never the system accent blue (D-UI8-5). Prism c1 P-6: measured
                 sub-legible in Light with the secondary text colour, so it takes the primary text colour. -->
            <ProgressRing Width="20" Height="20" HorizontalAlignment="Center" Foreground="{ThemeResource SaTextBrush}"
                          IsActive="{x:Bind Presentation.ShowsLoading, Mode=OneWay}"
                          Visibility="{x:Bind Presentation.ShowsLoading, Mode=OneWay, FallbackValue=Collapsed}" />
            <primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="28" HorizontalAlignment="Center"
                               Foreground="{ThemeResource SaTextSecondaryBrush}"
                               Visibility="{x:Bind Presentation.ShowsServerIcon, Mode=OneWay, FallbackValue=Collapsed}" />
            <primitives:SaIcon Data="{StaticResource SaIconAlert02Data}" Size="28" HorizontalAlignment="Center"
                               Foreground="{ThemeResource SaAttentionTextBrush}"
                               Visibility="{x:Bind Presentation.ShowsAlertIcon, Mode=OneWay, FallbackValue=Collapsed}" />
            <TextBlock x:Name="StateTitleText" Style="{StaticResource SaSectionTitleTextStyle}" Foreground="{ThemeResource SaTextBrush}"
                       Text="{x:Bind Presentation.StateTitle, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level2" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Style="{StaticResource SaCaptionTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}"
                       Text="{x:Bind Presentation.StateBody, Mode=OneWay}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"
                       Visibility="{x:Bind Presentation.HasStateBody, Mode=OneWay, FallbackValue=Collapsed}" />
            <Button x:Name="AddServerButton" x:Uid="CompactEmptyAction" HorizontalAlignment="Center"
                    Style="{StaticResource SaCompactButtonEmphasisStyle}" ContentTemplate="{StaticResource CompactAddContentTemplate}"
                    Command="{x:Bind WindowMode.AddServerCommand, Mode=OneWay}"
                    Visibility="{x:Bind Presentation.ShowsAddAction, Mode=OneWay, FallbackValue=Collapsed}" />
            <Button x:Name="ManageHiddenButton" x:Uid="HiddenOverviewAction" HorizontalAlignment="Center"
                    Style="{StaticResource SaCompactButtonEmphasisStyle}"
                    Command="{x:Bind WindowMode.ManageHiddenServersCommand, Mode=OneWay}"
                    Visibility="{x:Bind Presentation.ShowsHiddenAction, Mode=OneWay, FallbackValue=Collapsed}" />
        </StackPanel>

        <!-- Footer 112:9580: "Sempre no topo" 12 secondary · the shared SaToggleSwitchStyle (the same preference as Settings). -->
        <Grid x:Name="FooterRow" Grid.Row="2" Height="24" ColumnSpacing="{StaticResource SaSpace12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Uid="CompactAlwaysOnTopLabel" VerticalAlignment="Center" Style="{StaticResource SaCaptionTextStyle}"
                       Foreground="{ThemeResource SaTextSecondaryBrush}" TextTrimming="CharacterEllipsis" AutomationProperties.AccessibilityView="Raw" />
            <ToggleSwitch x:Name="AlwaysOnTopSwitch" x:Uid="CompactAlwaysOnTopToggle" Grid.Column="1" VerticalAlignment="Center"
                          Style="{StaticResource SaToggleSwitchStyle}" OnContent="" OffContent=""
                          IsOn="{x:Bind WindowMode.CompactAlwaysOnTop, Mode=TwoWay}" />
        </Grid>
    </Grid>
</UserControl>
