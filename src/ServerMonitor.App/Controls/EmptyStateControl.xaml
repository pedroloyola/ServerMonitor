<UserControl
    x:Class="ServerMonitor.App.Controls.EmptyStateControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        MaxWidth="380"
        Spacing="14">
        <Border
            Width="52"
            Height="52"
            HorizontalAlignment="Center"
            Background="{ThemeResource AccentSoftBrush}"
            BorderBrush="{ThemeResource GlassBorderBrush}"
            BorderThickness="1"
            CornerRadius="26">
            <FontIcon
                FontSize="20"
                Foreground="{ThemeResource AccentTextBrush}"
                Glyph="&#xE968;" />
        </Border>
        <StackPanel Spacing="6">
            <TextBlock
                HorizontalAlignment="Center"
                AutomationProperties.HeadingLevel="Level2"
                FontFamily="Segoe UI Variable Display"
                FontSize="20"
                FontWeight="SemiBold"
                Text="{x:Bind Title, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource TextSecondaryBrush}"
                Text="{x:Bind Description, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>
        <Button
            HorizontalAlignment="Center"
            Margin="0,4,0,0"
            Command="{x:Bind ActionCommand, Mode=OneWay}"
            Content="{x:Bind ActionText, Mode=OneWay}"
            Style="{StaticResource AccentPillButtonStyle}" />
    </StackPanel>
</UserControl>
