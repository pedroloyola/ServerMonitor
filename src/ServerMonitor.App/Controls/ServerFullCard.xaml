<UserControl
    x:Class="ServerMonitor.App.Controls.ServerFullCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ServerMonitor.App.Controls">
    <Grid>
    <controls:GlassCard
        Margin="0,0,0,12"
        AutomationProperties.Name="{Binding AutomationSummary}">
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Status dot, Server Name, OS Badge, Actions -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <Border
                        Width="8"
                        Height="8"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="{Binding HealthDisplayName}"
                        Background="{Binding Health, Converter={StaticResource HealthToBrushConverter}}"
                        CornerRadius="4" />
                    <TextBlock
                        FontFamily="Segoe UI Variable Display"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center" />
                    <Border
                        Padding="7,2"
                        Background="{ThemeResource MutedSurfaceBrush}"
                        BorderBrush="{ThemeResource GlassBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSmall}"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextSecondaryBrush}"
                            Text="{Binding OperatingSystemDisplayName}" />
                    </Border>
                </StackPanel>
                <controls:ServerActionsButton Grid.Column="1" VerticalAlignment="Center" />
            </Grid>

            <!-- Endpoint & Connection Status Display -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="11"
                        Foreground="{ThemeResource TextTertiaryBrush}"
                        Glyph="&#xE968;" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextSecondaryBrush}"
                        Text="{Binding Endpoint}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextTertiaryBrush}"
                    Text="{Binding HealthDisplayName}" />
            </Grid>

            <!-- Metrics & Footer Section -->
            <Grid
                Grid.Row="2"
                RowSpacing="10"
                Visibility="{Binding SupportsMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Metrics Pending / Refreshing / Error -->
                <Grid
                    ColumnSpacing="10"
                    Visibility="{Binding HasMetrics, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsMetricsPending, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            x:Uid="ServerMetricsWaitingForData"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsRefreshingMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ProgressRing
                            Width="14"
                            Height="14"
                            IsActive="{Binding IsRefreshingMetrics}" />
                        <TextBlock
                            x:Uid="ServerMetricsRefreshingLabel"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="12"
                            Foreground="{ThemeResource TextTertiaryBrush}" />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="12"
                        Foreground="{ThemeResource StatusCriticalBrush}"
                        Text="{Binding MetricsErrorDisplay}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasMetricsError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Button
                        Grid.Column="1"
                        Width="32"
                        Height="32"
                        AutomationProperties.Name="{Binding RefreshMetricsAutomationName}"
                        Command="{Binding RefreshMetricsCommand}"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding RefreshMetricsAutomationName}">
                        <FontIcon FontSize="12" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <!-- Unified Metrics Strip (CPU / Memory / Disk) -->
                <Border
                    Padding="14,10"
                    Background="{ThemeResource MutedSurfaceBrush}"
                    BorderBrush="{ThemeResource GlassBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Visibility="{Binding HasMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- CPU Column -->
                        <StackPanel Spacing="3" Visibility="{Binding HasCpuUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                x:Uid="ServerMetricsCpuLabel"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{Binding CpuUsageDisplay}"
                                TextTrimming="CharacterEllipsis" />
                            <ProgressBar
                                Value="{Binding CpuUsageValue}"
                                Maximum="100"
                                Height="3"
                                MinHeight="3"
                                CornerRadius="1.5"
                                Foreground="{ThemeResource BrandAccentBrush}"
                                Background="{ThemeResource GlassBorderBrush}"
                                Visibility="{Binding HasCpuPercent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Separator 1 -->
                        <Border Grid.Column="1" Background="{ThemeResource GlassBorderBrush}" Width="1" Margin="0,2" />

                        <!-- Memory Column -->
                        <StackPanel Grid.Column="2" Spacing="3" Visibility="{Binding HasMemoryUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                x:Uid="ServerMetricsMemoryLabel"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{Binding MemoryUsageDisplay}"
                                TextTrimming="CharacterEllipsis" />
                            <ProgressBar
                                Value="{Binding MemoryUsageValue}"
                                Maximum="100"
                                Height="3"
                                MinHeight="3"
                                CornerRadius="1.5"
                                Foreground="{ThemeResource BrandAccentBrush}"
                                Background="{ThemeResource GlassBorderBrush}"
                                Visibility="{Binding HasMemoryPercent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <!-- Separator 2 -->
                        <Border Grid.Column="3" Background="{ThemeResource GlassBorderBrush}" Width="1" Margin="0,2" />

                        <!-- Disk Column -->
                        <StackPanel Grid.Column="4" Spacing="3" Visibility="{Binding HasDiskUsage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                x:Uid="ServerMetricsDiskLabel"
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Text="{Binding DiskUsageDisplay}"
                                TextTrimming="CharacterEllipsis" />
                            <ProgressBar
                                Value="{Binding DiskUsageValue}"
                                Maximum="100"
                                Height="3"
                                MinHeight="3"
                                CornerRadius="1.5"
                                Foreground="{ThemeResource BrandAccentBrush}"
                                Background="{ThemeResource GlassBorderBrush}"
                                Visibility="{Binding HasDiskPercent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer with Uptime, OS, Timestamp & Refresh button -->
                <Grid
                    Grid.Row="1"
                    ColumnSpacing="10"
                    Visibility="{Binding HasMetrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4"
                            Visibility="{Binding HasUptime, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock
                                x:Uid="ServerMetricsUptimeLabel"
                                FontSize="11"
                                Foreground="{ThemeResource TextTertiaryBrush}" />
                            <TextBlock
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{ThemeResource TextSecondaryBrush}"
                                Text="{Binding UptimeDisplay}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Text="{Binding DetectedOperatingSystemDisplay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasDetectedOperatingSystem, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextTertiaryBrush}"
                            Text="{Binding MetricsTimestampDisplay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasStaleIndicator, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}" />
                        <!-- When the last reading is stale, show a discreet amber age instead of the timestamp. -->
                        <TextBlock
                            FontSize="11"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{ThemeResource StatusWarningBrush}"
                            Text="{Binding StaleAgeDisplay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{Binding HasStaleIndicator, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        AutomationProperties.Name="{Binding RefreshMetricsAutomationName}"
                        Command="{Binding RefreshMetricsCommand}"
                        Style="{StaticResource SubtleIconButtonStyle}"
                        ToolTipService.ToolTip="{Binding RefreshMetricsAutomationName}">
                        <FontIcon FontSize="11" Glyph="&#xE72C;" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </controls:GlassCard>

        <!-- QA-1: accent focus ring, pulsed by code-behind when this server is the widget deep-link target.
             Non-hit-test overlay so it never intercepts input; opacity is animated from 0. -->
        <Border
            x:Name="FocusRing"
            Margin="0,0,0,12"
            BorderBrush="{ThemeResource BrandAccentBrush}"
            BorderThickness="2"
            CornerRadius="{StaticResource RadiusMedium}"
            IsHitTestVisible="False"
            Opacity="0" />
    </Grid>
</UserControl>
