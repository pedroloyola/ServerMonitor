<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaNavigationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:qa="using:ServerMonitor.App.Qa.Gallery"
    Foreground="{ThemeResource SaTextBrush}">
    <!-- QA-ONLY (UI.2 S4): SidebarNavItem selected / unselected and the DERIVED states. -->
    <ScrollViewer AutomationProperties.AutomationId="PageScroll" qa:QaWallpaper.IsEnabled="True" BringIntoViewOnFocusChange="False">
        <StackPanel Padding="24" Spacing="{StaticResource SaSpace16}">
            <!-- UI.6 official brand 112:1361, not an icon substitution. -->
            <StackPanel Orientation="Horizontal" Spacing="16"><primitives:SaBrandMark Size="30"/><primitives:SaBrandMark Size="58"/>
            <Button Content="UI.6 primary h46 r15" Style="{StaticResource SaOnboardingPrimaryButtonStyle}"/>
            <Button Content="UI.6 secondary h46 r15" Style="{StaticResource SaOnboardingSecondaryButtonStyle}"/></StackPanel>

            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Navigation" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap" Text="Selected = Secondary fill + highlight, Medium; unselected = Regular muted (112:969 / 112:976). Icon 20, gap 10, h46." />
            <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="Sidebar 112:936 / 112:1147 (material SaSidebarMaterialBrush; the host is a UI.6 decision). Keyboard (R1 F-3): ONE Tab stop, entry on the selected item, arrows move focus only, Space/Enter activate - SaGroupNavigation.Mode=FocusOnly." TextWrapping="Wrap" />
            <Border Width="208" Padding="24" HorizontalAlignment="Left" Background="{ThemeResource SaSidebarMaterialBrush}" CornerRadius="{StaticResource SaRadiusPanel}"><StackPanel Spacing="12" primitives:SaGroupNavigation.Mode="FocusOnly"><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="Nav" AutomationProperties.Name="Visão geral" IsChecked="True"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconDashboardSquare01Data}" Size="20" /><TextBlock Text="Visão geral" /></StackPanel></RadioButton><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="Nav" AutomationProperties.Name="Servidores"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="20" /><TextBlock Text="Servidores" /></StackPanel></RadioButton><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="Nav" AutomationProperties.Name="Histórico"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconClock01Data}" Size="20" /><TextBlock Text="Histórico" /></StackPanel></RadioButton><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="Nav" AutomationProperties.Name="Definições"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconSettings01Data}" Size="20" /><TextBlock Text="Definições" /></StackPanel></RadioButton></StackPanel></Border>
            <Border Style="{StaticResource SaGlassSurfaceStyle}" Padding="24">
                <StackPanel Spacing="{StaticResource SaSpace16}">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Style="{StaticResource SaTableHeaderTextStyle}" Text="Unselected" /><TextBlock Grid.Column="2" Style="{StaticResource SaTableHeaderTextStyle}" Text="Selected" /><TextBlock Grid.Column="3" Style="{StaticResource SaTableHeaderTextStyle}" Text="Hover* (DERIVED)" /><TextBlock Grid.Column="4" Style="{StaticResource SaTableHeaderTextStyle}" Text="Pressed* (DERIVED)" /></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="SidebarNavItem · 112:969 sel / 112:976 unsel" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="S1" AutomationProperties.Name="Servidores"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="20" /><TextBlock Text="Servidores" /></StackPanel></RadioButton></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="S2" AutomationProperties.Name="Servidores" IsChecked="True"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="20" /><TextBlock Text="Servidores" /></StackPanel></RadioButton></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="S3" AutomationProperties.Name="Servidores" qa:QaForcedState.State="PointerOver"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="20" /><TextBlock Text="Servidores" /></StackPanel></RadioButton></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="S4" AutomationProperties.Name="Servidores" qa:QaForcedState.State="Pressed"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconServerStack01Data}" Size="20" /><TextBlock Text="Servidores" /></StackPanel></RadioButton></Border></Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Focus* (DERIVED): live keyboard focus" />
            <Border HorizontalAlignment="Left"><RadioButton Style="{StaticResource SaNavItemStyle}" GroupName="S5" AutomationProperties.Name="Definições" qa:QaForcedState.State="Focus"><StackPanel Orientation="Horizontal" Spacing="10"><primitives:SaIcon Data="{StaticResource SaIconSettings01Data}" Size="20" /><TextBlock Text="Definições" /></StackPanel></RadioButton></Border>
        </StackPanel>
    </ScrollViewer>
</Page>
