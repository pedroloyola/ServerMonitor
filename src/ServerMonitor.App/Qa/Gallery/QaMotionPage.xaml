<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaMotionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- QA-ONLY (UI.2 S3, F-4): every SaMotion* token consumed by a XAML Storyboard, and the same motion built in
         C# through MotionTokens. Both paths honour UISettings.AnimationsEnabled: when the system turns animations
         off nothing moves and every lane jumps to its end state. -->
    <Page.Resources>
        <Storyboard x:Key="XamlFadeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="XamlFadeBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="{StaticResource SaMotionFadeDuration}" KeySpline="{StaticResource SaMotionLinearKeySpline}" Value="320" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="XamlFastStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="XamlFastBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="{StaticResource SaMotionFastDuration}" KeySpline="{StaticResource SaMotionDirectKeySpline}" Value="320" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="XamlNormalStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="XamlNormalBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="{StaticResource SaMotionNormalDuration}" KeySpline="{StaticResource SaMotionPointToPointKeySpline}" Value="320" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="XamlSlowStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="XamlSlowBox" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="{StaticResource SaMotionSlowDuration}" KeySpline="{StaticResource SaMotionDirectKeySpline}" Value="320" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <!-- ServerFullCard's focus pulse shape (not migrated): ring up at FocusPeakTime, faded by FocusFadeEndTime. -->
        <Storyboard x:Key="XamlFocusStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="XamlFocusBox" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="{StaticResource SaMotionFocusPeakTime}" KeySpline="{StaticResource SaMotionDirectKeySpline}" Value="1" />
                <SplineDoubleKeyFrame KeyTime="{StaticResource SaMotionFocusFadeEndTime}" KeySpline="{StaticResource SaMotionLinearKeySpline}" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <!-- Reduced-motion variant: no movement, the ring is simply held for FocusReducedHoldTime. -->
        <Storyboard x:Key="XamlReducedStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="XamlReducedBox" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="{StaticResource SaMotionFocusReducedHoldTime}" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </Page.Resources>
    <ScrollViewer Padding="24">
        <StackPanel Spacing="{StaticResource SaSpace12}">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Motion" />
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SaSpace16}">
                <Button Content="Play all" Click="OnPlayAll" AutomationProperties.Name="Play all motion samples" />
                <TextBlock x:Name="AnimationsText" Style="{StaticResource SaPrimaryBodyTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="TokenValuesText" Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="XAML path - Storyboards consuming each SaMotion* token through StaticResource" Margin="0,8,0,0" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaMotionFadeDuration + SaMotionLinearKeySpline" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="XamlFadeBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaMotionFastDuration + SaMotionDirectKeySpline" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="XamlFastBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaMotionNormalDuration + SaMotionPointToPointKeySpline" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="XamlNormalBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaMotionSlowDuration + SaMotionDirectKeySpline" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="XamlSlowBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaMotionFocusPeakTime / FocusFadeEndTime" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="XamlFocusBox" Width="160" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" BorderThickness="{StaticResource SaFocusRingThickness}" BorderBrush="{ThemeResource SaFocusRingBrush}" Opacity="0" /></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaMotionFocusReducedHoldTime (reduced)" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="XamlReducedBox" Width="160" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" BorderThickness="{StaticResource SaFocusRingThickness}" BorderBrush="{ThemeResource SaFocusRingBrush}" Opacity="0" /></Border>
            </Grid>
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="C# path - the same animations built from MotionTokens.GetTime / GetKeySpline" Margin="0,16,0,0" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="MotionTokens: SaMotionFadeDuration" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="CodeFadeBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="MotionTokens: SaMotionFastDuration" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="CodeFastBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="MotionTokens: SaMotionNormalDuration" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="CodeNormalBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="MotionTokens: SaMotionSlowDuration" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="CodeSlowBox" Width="24" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaTextBrush}"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="MotionTokens: focus pulse" VerticalAlignment="Center" />
                <Border Grid.Column="1" Height="32" Width="360" HorizontalAlignment="Left" Padding="4" CornerRadius="{StaticResource SaRadiusSmall}" Background="{ThemeResource SaInteriorBrush}"><Border x:Name="CodeFocusBox" Width="160" Height="24" HorizontalAlignment="Left" CornerRadius="{StaticResource SaRadiusSmall}" BorderThickness="{StaticResource SaFocusRingThickness}" BorderBrush="{ThemeResource SaFocusRingBrush}" Opacity="0" /></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
