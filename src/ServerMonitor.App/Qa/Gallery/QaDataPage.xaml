<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:qa="using:ServerMonitor.App.Qa.Gallery"
    Foreground="{ThemeResource SaTextBrush}">
    <!-- QA-ONLY (UI.2 S6): data primitives - metric bar (unknown is not zero), metric value, key/value, list rows, table foundation. -->
    <ScrollViewer AutomationProperties.AutomationId="PageScroll" qa:QaWallpaper.IsEnabled="True" BringIntoViewOnFocusChange="False">
        <StackPanel Padding="24" Spacing="{StaticResource SaSpace16}">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Data" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap" Text="Manual metric colours (D8: Light RAW Figma colours not adopted). Unknown reading = empty track + — , never 0." />
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="MetricBar mini · 112:1040 / 112:1252 · CPU 22 · Memory 41 · Disk 93 · zero = 0% · unknown (NaN) = — (never 0)" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><StackPanel Spacing="14"><primitives:SaMetricBar Metric="Cpu" Value="22" Label="CPU" /><primitives:SaMetricBar Metric="Memory" Value="41" Label="Memória" /><primitives:SaMetricBar Metric="Disk" Value="93" Label="Disco" /><primitives:SaMetricBar Metric="Cpu" Value="0" Label="CPU (zero)" /><primitives:SaMetricBar Metric="Memory" Value="NaN" Label="Memória (sem leitura)" /></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Metric value 44 Light + % 20 muted · 112:1816 / 112:2053" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Style="{StaticResource SaMetricValueTextStyle}" Text="22" /><TextBlock Style="{StaticResource SaMetricUnitTextStyle}" Text="%" VerticalAlignment="Bottom" Margin="0,0,0,8" /></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="KeyValueRow stacked 112:1906 / inline 112:1919" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><StackPanel Spacing="24"><StackPanel Orientation="Horizontal" Spacing="48"><primitives:SaKeyValueRow Key="Sistema" Value="Ubuntu 24.04" /><primitives:SaKeyValueRow Key="Tempo ativo" Value="43 dias" /></StackPanel><StackPanel Spacing="17"><primitives:SaKeyValueRow Orientation="Inline" Key="Endereço" Value="192.168.1.20" /><primitives:SaKeyValueRow Orientation="Inline" Key="Utilizador" Value="admin" /></StackPanel></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="ListRow simple 112:1057 · rich 112:1933 (title 14 Medium; Figma 15 - deviation)" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><StackPanel Width="560" Spacing="4"><primitives:SaListRow IconData="{StaticResource SaIconServerStack01Data}" Title="QA · Healthy · Linux"><primitives:SaListRow.Trailing><primitives:SaStatusIndicator Status="Healthy" Label="Saudável" /></primitives:SaListRow.Trailing></primitives:SaListRow><primitives:SaListRow IconData="{StaticResource SaIconServerStack01Data}" Title="QA · Warning · Linux" qa:QaForcedState.State="PointerOver"><primitives:SaListRow.Trailing><primitives:SaStatusIndicator Status="Attention" Label="Atenção (hover* DERIVED)" /></primitives:SaListRow.Trailing></primitives:SaListRow><primitives:SaListRow Variant="Rich" IconData="{StaticResource SaIconClock01Data}" Title="Histórico" Detail="Últimas 24 horas de CPU, memória e disco" /></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="DataTable header + rows 112:1434 / 112:1616 (no dividers; attention value in attention text; — = no reading)" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><StackPanel Width="900"><Border Style="{StaticResource SaDataTableHeaderStyle}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" Text="SERVIDOR" /><TextBlock Grid.Column="1" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" Text="SISTEMA" /><TextBlock Grid.Column="2" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" Text="ESTADO" /><TextBlock Grid.Column="3" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" Text="CPU" /><TextBlock Grid.Column="4" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" Text="MEMÓRIA" /><TextBlock Grid.Column="5" Style="{StaticResource SaTableHeaderTextStyle}" VerticalAlignment="Center" Text="DISCO" /></Grid></Border><Border Style="{StaticResource SaDataTableRowStyle}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="5"><TextBlock Style="{StaticResource SaTableCellTextStyle}" Text="QA · Healthy · Linux" /><TextBlock Style="{StaticResource SaTableCellSecondaryTextStyle}" Text="192.168.1.20" /></StackPanel><TextBlock Grid.Column="1" Style="{StaticResource SaTableCellSecondaryTextStyle}" VerticalAlignment="Center" Text="Linux" /><primitives:SaStatusIndicator Grid.Column="2" VerticalAlignment="Center" Status="Healthy" Label="Saudável" /><TextBlock Grid.Column="3" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="22%" /><TextBlock Grid.Column="4" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="41%" /><TextBlock Grid.Column="5" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="52%" /></Grid></Border><Border Style="{StaticResource SaDataTableRowStyle}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="5"><TextBlock Style="{StaticResource SaTableCellTextStyle}" Text="QA · Warning · Linux" /><TextBlock Style="{StaticResource SaTableCellSecondaryTextStyle}" Text="192.168.1.21" /></StackPanel><TextBlock Grid.Column="1" Style="{StaticResource SaTableCellSecondaryTextStyle}" VerticalAlignment="Center" Text="Linux" /><primitives:SaStatusIndicator Grid.Column="2" VerticalAlignment="Center" Status="Attention" Label="Atenção" /><TextBlock Grid.Column="3" Style="{StaticResource SaTableCellAttentionTextStyle}" VerticalAlignment="Center" Text="84%" /><TextBlock Grid.Column="4" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="41%" /><TextBlock Grid.Column="5" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="52%" /></Grid></Border><Border Style="{StaticResource SaDataTableRowStyle}"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="290" /><ColumnDefinition Width="110" /><ColumnDefinition Width="150" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="5"><TextBlock Style="{StaticResource SaTableCellTextStyle}" Text="QA · Offline · macOS" /><TextBlock Style="{StaticResource SaTableCellSecondaryTextStyle}" Text="192.168.1.30" /></StackPanel><TextBlock Grid.Column="1" Style="{StaticResource SaTableCellSecondaryTextStyle}" VerticalAlignment="Center" Text="macOS" /><primitives:SaStatusIndicator Grid.Column="2" VerticalAlignment="Center" Status="Offline" Label="Sem ligação" /><TextBlock Grid.Column="3" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="—" /><TextBlock Grid.Column="4" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="—" /><TextBlock Grid.Column="5" Style="{StaticResource SaTableCellTextStyle}" VerticalAlignment="Center" Text="—" /></Grid></Border></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Status badge text 11 Medium attention · 112:2640" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Style="{StaticResource SaTitleTextStyle}" Text="Serviços" /><TextBlock Style="{StaticResource SaStatusBadgeTextStyle}" VerticalAlignment="Center" Text="1 problema" /></StackPanel></Border></StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
