<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaButtonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:qa="using:ServerMonitor.App.Qa.Gallery"
    Foreground="{ThemeResource SaTextBrush}">
    <!-- QA-ONLY (UI.2 S4): the eight button styles of Boss B-4 in every state. -->
    <ScrollViewer qa:QaWallpaper.IsEnabled="True" BringIntoViewOnFocusChange="False">
        <StackPanel Padding="24" Spacing="{StaticResource SaSpace16}">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Buttons" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap" Text="Four Figma families (pill glass, rect 14, dialog 13, Manual 12) + icon buttons. Rest and Disabled (opacity .58, 112:3399) are MEASURED; * = DERIVED (B-4). Drop shadows are not reproduced (deviation)." />
            <Border Style="{StaticResource SaCardSurfaceStyle}" Padding="24">
                <StackPanel Spacing="{StaticResource SaSpace16}">
                    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Style="{StaticResource SaTableHeaderTextStyle}" Text="Rest" /><TextBlock Grid.Column="2" Style="{StaticResource SaTableHeaderTextStyle}" Text="Hover* (DERIVED)" /><TextBlock Grid.Column="3" Style="{StaticResource SaTableHeaderTextStyle}" Text="Pressed* (DERIVED)" /><TextBlock Grid.Column="4" Style="{StaticResource SaTableHeaderTextStyle}" Text="Disabled" /></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Primary pill · 112:1004 / 112:1216" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaPrimaryButtonStyle}" AutomationProperties.Name="Adicionar servidor"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconAdd01Data}" Size="18" /><TextBlock Text="Adicionar servidor" /></StackPanel></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaPrimaryButtonStyle}" AutomationProperties.Name="Adicionar servidor" qa:QaForcedState.State="PointerOver"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconAdd01Data}" Size="18" /><TextBlock Text="Adicionar servidor" /></StackPanel></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaPrimaryButtonStyle}" AutomationProperties.Name="Adicionar servidor" qa:QaForcedState.State="Pressed"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconAdd01Data}" Size="18" /><TextBlock Text="Adicionar servidor" /></StackPanel></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaPrimaryButtonStyle}" AutomationProperties.Name="Adicionar servidor" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconAdd01Data}" Size="18" /><TextBlock Text="Adicionar servidor" /></StackPanel></Button></Border></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Secondary pill · 112:3323 / 112:3484" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryButtonStyle}" AutomationProperties.Name="Importar de SSH"><TextBlock Text="Importar de SSH" /></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryButtonStyle}" AutomationProperties.Name="Importar de SSH" qa:QaForcedState.State="PointerOver"><TextBlock Text="Importar de SSH" /></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryButtonStyle}" AutomationProperties.Name="Importar de SSH" qa:QaForcedState.State="Pressed"><TextBlock Text="Importar de SSH" /></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryButtonStyle}" AutomationProperties.Name="Importar de SSH" IsEnabled="False"><TextBlock Text="Importar de SSH" /></Button></Border></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Secondary rect r14 · 112:1806 / 112:2043" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryRectButtonStyle}" AutomationProperties.Name="Atualizar"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="18" /><TextBlock Text="Atualizar" /></StackPanel></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryRectButtonStyle}" AutomationProperties.Name="Atualizar" qa:QaForcedState.State="PointerOver"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="18" /><TextBlock Text="Atualizar" /></StackPanel></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryRectButtonStyle}" AutomationProperties.Name="Atualizar" qa:QaForcedState.State="Pressed"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="18" /><TextBlock Text="Atualizar" /></StackPanel></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSecondaryRectButtonStyle}" AutomationProperties.Name="Atualizar" IsEnabled="False"><StackPanel Orientation="Horizontal" Spacing="8"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="18" /><TextBlock Text="Atualizar" /></StackPanel></Button></Border></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Dialog neutral r13 · 112:8573 / 112:8759" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDialogButtonStyle}" AutomationProperties.Name="Cancelar"><TextBlock Text="Cancelar" /></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDialogButtonStyle}" AutomationProperties.Name="Cancelar" qa:QaForcedState.State="PointerOver"><TextBlock Text="Cancelar" /></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDialogButtonStyle}" AutomationProperties.Name="Cancelar" qa:QaForcedState.State="Pressed"><TextBlock Text="Cancelar" /></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDialogButtonStyle}" AutomationProperties.Name="Cancelar" IsEnabled="False"><TextBlock Text="Cancelar" /></Button></Border></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Destructive r13 · 112:8575 / 112:8761" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDestructiveButtonStyle}" AutomationProperties.Name="Remover servidor"><TextBlock Text="Remover servidor" /></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDestructiveButtonStyle}" AutomationProperties.Name="Remover servidor" qa:QaForcedState.State="PointerOver"><TextBlock Text="Remover servidor" /></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDestructiveButtonStyle}" AutomationProperties.Name="Remover servidor" qa:QaForcedState.State="Pressed"><TextBlock Text="Remover servidor" /></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaDestructiveButtonStyle}" AutomationProperties.Name="Remover servidor" IsEnabled="False"><TextBlock Text="Remover servidor" /></Button></Border></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Solid (Manual) r12 · 112:14098 / 112:14192" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSolidButtonStyle}" AutomationProperties.Name="Adicionar servidor"><TextBlock Text="Adicionar servidor" /></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSolidButtonStyle}" AutomationProperties.Name="Adicionar servidor" qa:QaForcedState.State="PointerOver"><TextBlock Text="Adicionar servidor" /></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSolidButtonStyle}" AutomationProperties.Name="Adicionar servidor" qa:QaForcedState.State="Pressed"><TextBlock Text="Adicionar servidor" /></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaSolidButtonStyle}" AutomationProperties.Name="Adicionar servidor" IsEnabled="False"><TextBlock Text="Adicionar servidor" /></Button></Border></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="IconButton 44 · 112:1001 / 112:1213" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaIconButtonStyle}" AutomationProperties.Name="Atualizar tudo"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="19" /></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaIconButtonStyle}" AutomationProperties.Name="Atualizar tudo" qa:QaForcedState.State="PointerOver"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="19" /></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaIconButtonStyle}" AutomationProperties.Name="Atualizar tudo" qa:QaForcedState.State="Pressed"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="19" /></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaIconButtonStyle}" AutomationProperties.Name="Atualizar tudo" IsEnabled="False"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="19" /></Button></Border></Grid>
                    <Grid ColumnSpacing="16" MinHeight="48"><Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Text="Ghost icon 28 · 112:19619" /><Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaGhostIconButtonStyle}" AutomationProperties.Name="Fechar"><primitives:SaIcon Data="{StaticResource SaIconCancel01Data}" Size="20" /></Button></Border><Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaGhostIconButtonStyle}" AutomationProperties.Name="Fechar" qa:QaForcedState.State="PointerOver"><primitives:SaIcon Data="{StaticResource SaIconCancel01Data}" Size="20" /></Button></Border><Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaGhostIconButtonStyle}" AutomationProperties.Name="Fechar" qa:QaForcedState.State="Pressed"><primitives:SaIcon Data="{StaticResource SaIconCancel01Data}" Size="20" /></Button></Border><Border Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center"><Button Style="{StaticResource SaGhostIconButtonStyle}" AutomationProperties.Name="Fechar" IsEnabled="False"><primitives:SaIcon Data="{StaticResource SaIconCancel01Data}" Size="20" /></Button></Border></Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Focus* (DERIVED): system keyboard focus visual, SaFocusRingBrush 2px - live keyboard focus on this sample" />
            <Border Style="{StaticResource SaCardSurfaceStyle}" Padding="24" HorizontalAlignment="Left">
                <Button Style="{StaticResource SaSecondaryButtonStyle}" AutomationProperties.Name="Importar de SSH" qa:QaForcedState.State="Focus"><TextBlock Text="Importar de SSH" /></Button>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
