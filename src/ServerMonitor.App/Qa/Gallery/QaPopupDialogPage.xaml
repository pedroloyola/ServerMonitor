<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaPopupDialogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:qa="using:ServerMonitor.App.Qa.Gallery"
    Foreground="{ThemeResource SaTextBrush}">
    <!-- QA-ONLY (UI.2 S6, R1): SaDialogStyle on a real ContentDialog, opened on load (F-07: 2px WindowText border in HC).
         "popup-dialog" = destructive (Enter + first focus = Cancelar), "popup-dialog-confirm" = confirm (Enter = primary).
         DialogInitialFocus / DialogResult are read by the scripted keyboard probe (tools/qa/ui2-dialog-probe.ps1). -->
    <ScrollViewer AutomationProperties.AutomationId="PageScroll" qa:QaWallpaper.IsEnabled="True" BringIntoViewOnFocusChange="False">
        <StackPanel Padding="24" Spacing="{StaticResource SaSpace16}">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Popup check · Dialog" />
            <TextBlock x:Name="Description" Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap" />
            <Button Style="{StaticResource SaSecondaryButtonStyle}" Content="Abrir diálogo" Click="OnOpenDialog" />
            <TextBlock x:Name="InitialFocusText" AutomationProperties.AutomationId="DialogInitialFocus" Style="{StaticResource SaMonoTextStyle}" Text="Dialog initial focus: -" />
            <TextBlock x:Name="DefaultButtonText" AutomationProperties.AutomationId="DialogDefaultButton" Style="{StaticResource SaMonoTextStyle}" Text="Dialog DefaultButton: -" />
            <TextBlock x:Name="ResultText" AutomationProperties.AutomationId="DialogResult" Style="{StaticResource SaMonoTextStyle}" Text="Dialog result: -" />
        </StackPanel>
    </ScrollViewer>
</Page>
