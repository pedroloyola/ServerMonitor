<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaTokenProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- QA-ONLY (UI.2 S2, F-1). ONE probe per non-colour key of QaTokenManifest, identified by Tag = key:
         brushes through ThemeResource (re-resolved on theme change), everything else through StaticResource.
         Raw SaColor* values are private to Styles/Tokens/** and are probed in code instead.
         QaTokenProbePageCoversManifest pins this page to the manifest. Generated once from Styles/Tokens/**. -->
    <ScrollViewer AutomationProperties.AutomationId="PageScroll" x:Name="ProbeScroller" Padding="24">
        <StackPanel x:Name="ProbeRoot" Spacing="4">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Tokens (F-1 probes)" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap"
                       Text="One element per Sa* token (Tag = key). --qa-tokens reads every probe back in Dark and Light and compares it with the theme dictionary entry." />
            <TextBlock Style="{StaticResource SaTableHeaderTextStyle}" Text="Default style via Application.Resources (S1 empirical)" Margin="0,12,0,4" />
            <TextBlock Style="{StaticResource SaTableHeaderTextStyle}" Text="Icon stroke probes (Boss B-1: 1.5 DIP at every size)" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <primitives:SaIcon x:Name="StrokeProbe16" x:FieldModifier="internal" Data="{StaticResource SaIconAdd01Data}" Size="16" Foreground="{ThemeResource SaTextBrush}" />
                <primitives:SaIcon x:Name="StrokeProbe20" x:FieldModifier="internal" Data="{StaticResource SaIconAdd01Data}" Size="20" Foreground="{ThemeResource SaTextBrush}" />
                <primitives:SaIcon x:Name="StrokeProbe24" x:FieldModifier="internal" Data="{StaticResource SaIconAdd01Data}" Size="24" Foreground="{ThemeResource SaTextBrush}" />
                <primitives:SaIcon x:Name="StrokeProbe48" x:FieldModifier="internal" Data="{StaticResource SaIconAdd01Data}" Size="48" Foreground="{ThemeResource SaTextBrush}" />
            </StackPanel>
            <TextBlock Style="{StaticResource SaTableHeaderTextStyle}" Text="Automation-name probes (Vigil F-3: the name a control APPLIES to its icon-only part)" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal" Spacing="24">
                <primitives:SaPasswordField x:Name="RevealNameProbe" x:FieldModifier="internal" Width="240" AutomationProperties.Name="Palavra-passe (probe)" RevealButtonAutomationName="Mostrar palavra-passe" />
                <Button x:Name="IconButtonNameProbe" x:FieldModifier="internal" Style="{StaticResource SaIconButtonStyle}" AutomationProperties.Name="Atualizar tudo"><primitives:SaIcon Data="{StaticResource SaIconRefreshData}" Size="19" /></Button>
            </StackPanel>
            <primitives:SaToast x:Name="ToastNameProbe" x:FieldModifier="internal" Title="Probe" Message="Probe" CloseButtonAutomationName="Fechar notificação" />
            <primitives:SaStatusIndicator x:Name="DefaultStyleProbe" x:FieldModifier="internal" Status="Healthy" Label="Default style probe" />
            <primitives:SaStatusIndicator x:Name="DotOnlyStyleProbe" x:FieldModifier="internal" Style="{StaticResource SaStatusDotOnlyStyle}" HorizontalAlignment="Left" Status="Attention" Label="Dot-only style probe" />
            <TextBlock Style="{StaticResource SaTableHeaderTextStyle}" Text="Styles/Tokens/Color.Semantic.xaml" Margin="0,12,0,4" />
