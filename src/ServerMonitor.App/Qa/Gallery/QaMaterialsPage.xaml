<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaMaterialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:qa="using:ServerMonitor.App.Qa.Gallery"
    Foreground="{ThemeResource SaTextBrush}">
    <!-- QA-ONLY (UI.2 S6): surfaces on the Figma wallpaper gradient so glass reads as designed, text-contrast samples and the opaque-fallback simulation. -->
    <ScrollViewer AutomationProperties.AutomationId="PageScroll" qa:QaWallpaper.IsEnabled="True" BringIntoViewOnFocusChange="False">
        <StackPanel Padding="24" Spacing="{StaticResource SaSpace16}">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Materials" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap" Text="Wallpaper = Figma 112:931 / 112:1142 gradient (reference backdrop, not a token). Glass = native in-app Acrylic (D7). Shadows/inner highlights not reproduced (deviation)." />
            <StackPanel Orientation="Horizontal" Spacing="12"><ToggleSwitch x:Name="FallbackToggle" Style="{StaticResource SaToggleSwitchStyle}" AutomationProperties.Name="Simular efeitos de transparência desligados" Toggled="OnFallbackToggled" /><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" Width="900" Text="SIMULATION of transparency effects off: glass samples swap to SaOpaqueFallbackBrush locally. The real switch is Settings &gt; Personalization &gt; Colors (not changed by the gallery)." /></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Glass card · 112:1010 / 112:1222" /><Grid Width="560"><Border x:Name="GlassSample" Style="{StaticResource SaGlassSurfaceStyle}" Padding="0"><StackPanel Spacing="4" Padding="16"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="Texto principal · Visão geral" /><TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Texto secundário · 22% CPU" /></StackPanel></Border><Border x:Name="GlassFallbackSample" Visibility="Collapsed" Background="{ThemeResource SaOpaqueFallbackBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}" CornerRadius="{StaticResource SaRadiusCard}"><StackPanel Spacing="4" Padding="16"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="Texto principal · Visão geral" /><TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Texto secundário · 22% CPU" /></StackPanel></Border></Grid></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Solid (Manual) panel · 112:14088 / 112:14182" /><Border Width="560" Style="{StaticResource SaSolidSurfaceStyle}" Padding="0"><StackPanel Spacing="4" Padding="16"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="Texto principal · Visão geral" /><TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Texto secundário · 22% CPU" /></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Inset (Manual) · 112:22183" /><Border Width="560" Style="{StaticResource SaInsetSurfaceStyle}" Padding="0"><StackPanel Spacing="4" Padding="16"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="Texto principal · Visão geral" /><TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Texto secundário · 22% CPU" /></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Inset tinted (dialog) · 112:8562 / 112:8748" /><Border Width="560" Style="{StaticResource SaInsetTintedSurfaceStyle}" Padding="0"><StackPanel Spacing="4" Padding="16"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="Texto principal · Visão geral" /><TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Texto secundário · 22% CPU" /></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Modal shell · 112:8559 / 112:8745 (HC: 2px WindowText)" /><Border Width="560" Style="{StaticResource SaModalSurfaceStyle}" Padding="0"><StackPanel Spacing="4" Padding="16"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="Texto principal · Visão geral" /><TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Texto secundário · 22% CPU" /></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Overlay smoke · 112:8558 / 112:8744 (HC: opaque Window, F-07)" /><Grid Width="560" Height="160"><StackPanel Padding="16" Spacing="4"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="Conteúdo por trás" /><TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="CPU 22% · Memória 41%" /></StackPanel><Border Style="{StaticResource SaOverlayStyle}" CornerRadius="{StaticResource SaRadiusControl}" /><Border Style="{StaticResource SaModalSurfaceStyle}" Margin="80,24" Padding="16"><TextBlock Style="{StaticResource SaTitleCompactTextStyle}" Text="Diálogo" /></Border></Grid></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Material brushes (Elevation.xaml): Neutral · Elevated (DERIVED) · Glass (acrylic) · Sidebar (acrylic) · Modal · Opaque fallback" /><StackPanel Orientation="Horizontal" Spacing="12"><Border Width="88" Height="56" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaNeutralSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="SaNeutralSurfaceBrush" /><Border Width="88" Height="56" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaElevatedSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="SaElevatedSurfaceBrush" /><Border Width="88" Height="56" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaGlassSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="SaGlassSurfaceBrush" /><Border Width="88" Height="56" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaSidebarMaterialBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="SaSidebarMaterialBrush" /><Border Width="88" Height="56" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaModalSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="SaModalSurfaceBrush" /><Border Width="88" Height="56" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaOpaqueFallbackBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="1" ToolTipService.ToolTip="SaOpaqueFallbackBrush" /></StackPanel></StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
