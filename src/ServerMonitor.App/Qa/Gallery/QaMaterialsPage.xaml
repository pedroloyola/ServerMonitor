<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaMaterialsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives">
    <!-- QA-ONLY (UI.2 S2): flat surface styles (Sa.Surfaces.xaml) and the elevation/material brushes over a busy backdrop so acrylic is visible. Materials are defined, not adopted. -->
    <ScrollViewer Padding="24">
        <StackPanel Spacing="{StaticResource SaSpace12}">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Materials" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Surface styles (Styles/Components/Sa.Surfaces.xaml)" Margin="0,0,0,0" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaPanelSurfaceStyle" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SaPanelSurfaceStyle}" Padding="16" Height="88"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="SaPanelSurfaceStyle · Conteúdo de exemplo" /></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaCardSurfaceStyle" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SaCardSurfaceStyle}" Padding="16" Height="88"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="SaCardSurfaceStyle · Conteúdo de exemplo" /></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaInsetSurfaceStyle" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SaInsetSurfaceStyle}" Padding="16" Height="88"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="SaInsetSurfaceStyle · Conteúdo de exemplo" /></Border>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaModalSurfaceStyle" VerticalAlignment="Center" />
                <Border Grid.Column="1" Style="{StaticResource SaModalSurfaceStyle}" Padding="16" Height="88"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="SaModalSurfaceStyle · Conteúdo de exemplo" /></Border>
            </Grid>
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" Text="Material brushes (Elevation.xaml) over a striped backdrop" Margin="0,16,0,0" />
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaNeutralSurfaceBrush" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="72" CornerRadius="{StaticResource SaRadiusControl}">
                    <StackPanel Orientation="Horizontal"><Border Width="80" Background="{ThemeResource SaCpuBrush}" /><Border Width="80" Background="{ThemeResource SaMemoryBrush}" /><Border Width="80" Background="{ThemeResource SaDiskBrush}" /><Border Width="80" Background="{ThemeResource SaHealthyBrush}" /><Border Width="80" Background="{ThemeResource SaErrorBrush}" /></StackPanel>
                    <Border Margin="40,12" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaNeutralSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}"><TextBlock Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}" Margin="12,0" VerticalAlignment="Center" Text="SaNeutralSurfaceBrush" /></Border>
                </Grid>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaElevatedSurfaceBrush" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="72" CornerRadius="{StaticResource SaRadiusControl}">
                    <StackPanel Orientation="Horizontal"><Border Width="80" Background="{ThemeResource SaCpuBrush}" /><Border Width="80" Background="{ThemeResource SaMemoryBrush}" /><Border Width="80" Background="{ThemeResource SaDiskBrush}" /><Border Width="80" Background="{ThemeResource SaHealthyBrush}" /><Border Width="80" Background="{ThemeResource SaErrorBrush}" /></StackPanel>
                    <Border Margin="40,12" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaElevatedSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}"><TextBlock Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}" Margin="12,0" VerticalAlignment="Center" Text="SaElevatedSurfaceBrush" /></Border>
                </Grid>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaGlassSurfaceBrush" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="72" CornerRadius="{StaticResource SaRadiusControl}">
                    <StackPanel Orientation="Horizontal"><Border Width="80" Background="{ThemeResource SaCpuBrush}" /><Border Width="80" Background="{ThemeResource SaMemoryBrush}" /><Border Width="80" Background="{ThemeResource SaDiskBrush}" /><Border Width="80" Background="{ThemeResource SaHealthyBrush}" /><Border Width="80" Background="{ThemeResource SaErrorBrush}" /></StackPanel>
                    <Border Margin="40,12" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaGlassSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}"><TextBlock Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}" Margin="12,0" VerticalAlignment="Center" Text="SaGlassSurfaceBrush" /></Border>
                </Grid>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaSidebarMaterialBrush" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="72" CornerRadius="{StaticResource SaRadiusControl}">
                    <StackPanel Orientation="Horizontal"><Border Width="80" Background="{ThemeResource SaCpuBrush}" /><Border Width="80" Background="{ThemeResource SaMemoryBrush}" /><Border Width="80" Background="{ThemeResource SaDiskBrush}" /><Border Width="80" Background="{ThemeResource SaHealthyBrush}" /><Border Width="80" Background="{ThemeResource SaErrorBrush}" /></StackPanel>
                    <Border Margin="40,12" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaSidebarMaterialBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}"><TextBlock Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}" Margin="12,0" VerticalAlignment="Center" Text="SaSidebarMaterialBrush" /></Border>
                </Grid>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaModalSurfaceBrush" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="72" CornerRadius="{StaticResource SaRadiusControl}">
                    <StackPanel Orientation="Horizontal"><Border Width="80" Background="{ThemeResource SaCpuBrush}" /><Border Width="80" Background="{ThemeResource SaMemoryBrush}" /><Border Width="80" Background="{ThemeResource SaDiskBrush}" /><Border Width="80" Background="{ThemeResource SaHealthyBrush}" /><Border Width="80" Background="{ThemeResource SaErrorBrush}" /></StackPanel>
                    <Border Margin="40,12" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaModalSurfaceBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}"><TextBlock Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}" Margin="12,0" VerticalAlignment="Center" Text="SaModalSurfaceBrush" /></Border>
                </Grid>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaOpaqueFallbackBrush" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="72" CornerRadius="{StaticResource SaRadiusControl}">
                    <StackPanel Orientation="Horizontal"><Border Width="80" Background="{ThemeResource SaCpuBrush}" /><Border Width="80" Background="{ThemeResource SaMemoryBrush}" /><Border Width="80" Background="{ThemeResource SaDiskBrush}" /><Border Width="80" Background="{ThemeResource SaHealthyBrush}" /><Border Width="80" Background="{ThemeResource SaErrorBrush}" /></StackPanel>
                    <Border Margin="40,12" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaOpaqueFallbackBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}"><TextBlock Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}" Margin="12,0" VerticalAlignment="Center" Text="SaOpaqueFallbackBrush" /></Border>
                </Grid>
            </Grid>
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" Text="SaOverlaySmokeBrush" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="72" CornerRadius="{StaticResource SaRadiusControl}">
                    <StackPanel Orientation="Horizontal"><Border Width="80" Background="{ThemeResource SaCpuBrush}" /><Border Width="80" Background="{ThemeResource SaMemoryBrush}" /><Border Width="80" Background="{ThemeResource SaDiskBrush}" /><Border Width="80" Background="{ThemeResource SaHealthyBrush}" /><Border Width="80" Background="{ThemeResource SaErrorBrush}" /></StackPanel>
                    <Border Margin="40,12" CornerRadius="{StaticResource SaRadiusControl}" Background="{ThemeResource SaOverlaySmokeBrush}" BorderBrush="{ThemeResource SaGlassBorderBrush}" BorderThickness="{StaticResource SaBorderThickness}"><TextBlock Style="{StaticResource SaLabelTextStyle}" Foreground="{ThemeResource SaTextBrush}" Margin="12,0" VerticalAlignment="Center" Text="SaOverlaySmokeBrush" /></Border>
                </Grid>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
