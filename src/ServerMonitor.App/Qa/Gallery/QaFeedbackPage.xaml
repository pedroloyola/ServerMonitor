<Page
    x:Class="ServerMonitor.App.Qa.Gallery.QaFeedbackPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:ServerMonitor.App.Controls.Primitives"
    xmlns:qa="using:ServerMonitor.App.Qa.Gallery"
    Foreground="{ThemeResource SaTextBrush}">
    <!-- QA-ONLY (UI.2 S6): feedback primitives - inline notices, toast, skeleton, empty state, breadcrumb. -->
    <ScrollViewer AutomationProperties.AutomationId="PageScroll" qa:QaWallpaper.IsEnabled="True" BringIntoViewOnFocusChange="False">
        <StackPanel Padding="24" Spacing="{StaticResource SaSpace16}">
            <TextBlock Style="{StaticResource SaSectionHeaderTextStyle}" Text="Feedback" />
            <TextBlock Style="{StaticResource SaSecondaryBodyTextStyle}" TextWrapping="Wrap" Text="Error announced assertively, info politely. Toast is visual only (no timer/queue - UI.5/UI.7). Skeleton pulse is DERIVED and honours AnimationsEnabled." />
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="InlineNotice Error with action · 112:18273 / 112:18441" /><primitives:SaInlineNotice Severity="Error" Width="720" Title="Não foi possível ligar ao servidor" Message="A autenticação SSH falhou. Verifique a chave ou a palavra-passe."><Button Style="{StaticResource SaSolidButtonSmallStyle}" Width="220" Content="Abrir servidor" /></primitives:SaInlineNotice></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="InlineNotice Error without action · 112:19265 / 112:19434" /><primitives:SaInlineNotice Severity="Error" Width="720" Title="Cópia de segurança inválida" Message="O ficheiro está corrompido ou foi criado por outra aplicação." /></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="InlineNotice Info plain · 112:2756 / 112:2972" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><primitives:SaInlineNotice Severity="Info" Message="Só leitura: o ServerAlyzer nunca altera o servidor." /></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Toast success (visual only, no timer) · 112:19613 / 112:19779" /><primitives:SaToast Title="Servidor adicionado" Message="O ServerAlyzer começou a monitorizar o QA · Healthy · Linux." CloseButtonAutomationName="Fechar notificação" /></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Skeleton static · 112:15602 / 112:15726: label above, gap 20, row step 64 (R1 Prism nit); second row pulses (DERIVED) only if AnimationsEnabled" /><Border Style="{StaticResource SaGlassSurfaceStyle}" Width="720"><StackPanel Spacing="20"><TextBlock Style="{StaticResource SaPrimaryBodyTextStyle}" Text="A carregar…" /><StackPanel Spacing="24"><StackPanel Orientation="Horizontal" Spacing="24"><primitives:SaSkeleton Width="40" Height="40" /><StackPanel Spacing="8"><primitives:SaSkeleton Width="160" Height="16" /><primitives:SaSkeleton Width="110" Height="12" /></StackPanel><primitives:SaSkeleton Width="72" Height="16" VerticalAlignment="Center" /><primitives:SaSkeleton Width="72" Height="16" VerticalAlignment="Center" /><primitives:SaSkeleton Width="72" Height="16" VerticalAlignment="Center" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="24"><primitives:SaSkeleton Width="40" Height="40" IsPulsing="True" /><StackPanel Spacing="8"><primitives:SaSkeleton Width="160" Height="16" IsPulsing="True" /><primitives:SaSkeleton Width="110" Height="12" IsPulsing="True" /></StackPanel><primitives:SaSkeleton Width="72" Height="16" VerticalAlignment="Center" IsPulsing="True" /><primitives:SaSkeleton Width="72" Height="16" VerticalAlignment="Center" IsPulsing="True" /><primitives:SaSkeleton Width="72" Height="16" VerticalAlignment="Center" IsPulsing="True" /></StackPanel></StackPanel></StackPanel></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="EmptyState · 112:14088 / 112:14182" /><Border Style="{StaticResource SaSolidSurfaceStyle}" Width="720" Padding="48"><primitives:SaEmptyState IconData="{StaticResource SaIconServerStack01Data}" Title="Ainda não há servidores" Message="Adicione o primeiro servidor para começar a acompanhar CPU, memória e disco."><Button Style="{StaticResource SaSolidButtonStyle}" Width="200" Content="Adicionar servidor" /></primitives:SaEmptyState></Border></StackPanel>
            <StackPanel Spacing="8" HorizontalAlignment="Left"><TextBlock Style="{StaticResource SaMonoTextStyle}" Foreground="{ThemeResource SaTextSecondaryBrush}" TextWrapping="Wrap" Text="Breadcrumb · 112:1786 / 112:2023" /><Border Style="{StaticResource SaGlassSurfaceStyle}"><primitives:SaBreadcrumb ParentText="Servidores" CurrentText="QA · Healthy · Linux" /></Border></StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
