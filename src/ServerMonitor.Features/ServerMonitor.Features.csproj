<Project Sdk="Microsoft.NET.Sdk">

  <!--
    M14.1 feature-composition contracts (ADR-020). A small, dependency-free LEAF assembly in the same
    idiom as WidgetContract and ActivationContract: the vocabulary a build uses to say which capabilities
    it composes, and nothing else. It has NO Core/Infrastructure/Collectors/App reference, so a future
    out-of-tree module can reference it ALONE.

    It carries exactly one PackageReference, and that is the whole reason it is not part of Core:
    ServerMonitor.Core deliberately has ZERO package references, and IFeatureModule needs
    IServiceCollection. Keeping Core pure is worth one extra leaf project.

    Deliberately NOT here: any notion of an edition, a product tier, a price, a licence, a signature, an
    account or a network call. This assembly answers "is this capability composed?" and never "who are
    you?".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
